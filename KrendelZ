-- Read-only info row that can be updated at runtime.
local function MakeInfoRow(box, title, desc, iconAsset)
    local row = box:AddActionRow(title, (desc ~= nil and desc ~= "") and desc or " ", iconAsset or StarHubUI.Icons.Info, function() end)

    local labels = {}
    for _, child in ipairs(row:GetChildren()) do
        if child:IsA("TextLabel") then
            table.insert(labels, child)
        end
    end
    table.sort(labels, function(a, b)
        return (a.TextSize or 0) > (b.TextSize or 0)
    end)

    local titleLabel = labels[1]
    local descLabel = labels[2]

    local wrapper = {}
    function wrapper:SetTitle(value)
        if titleLabel then titleLabel.Text = tostring(value) end
    end
    function wrapper:SetDesc(value)
        if descLabel then descLabel.Text = tostring(value or "") end
    end
    return wrapper
end

