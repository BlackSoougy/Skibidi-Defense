    local count = 0
    for line in string.gmatch(Farm.PointData or "", "[^\r\n]+") do
        local x, y, z = string.match(line, "^(%-?%d+)%s*,%s*(%-?%d+)%s*,%s*(%-?%d+)$")
        if x then
            count = count + 1
            list[#list + 1] = {
                Name = "point" .. tostring(count),
                Position = Vector3.new(tonumber(x), tonumber(y), tonumber(z)),
            }
        end
    end
    return list
end

-- Промпты в мире меняются редко, поэтому список кэшируется: полный обход
-- Workspace на каждой двери - это лишние сотни миллисекунд.
Farm.PromptCache = nil
Farm.PromptCacheAt = 0

function Farm.PromptList()
    local now = tick()
    if Farm.PromptCache and (now - (Farm.PromptCacheAt or 0)) < 60 then
        return Farm.PromptCache
    end
    local list = {}
    pcall(function()
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("ProximityPrompt") then
                local part = item.Parent
                local guard = 0
                while part and not part:IsA("BasePart") and guard < 8 do
                    guard = guard + 1
                    part = part.Parent
                end
                if part and part:IsA("BasePart") then
                    list[#list + 1] = {
                        Prompt = item,
                        Part = part,
                        Position = part.Position,
                    }
                end
            end
        end
    end)
    Farm.PromptCache = list
    Farm.PromptCacheAt = now
    return list
end

function Farm.TeleportToPoint(point)
    local root = FarmRoot()
    if not root or not point then
        return false
    end
    local base = point.Position
    local offsetX = tonumber(State.DoorOffsetX) or 0
    local offsetY = tonumber(State.DoorOffsetY) or 0
    local offsetZ = tonumber(State.DoorOffsetZ) or 0
    local position = Vector3.new(
        base.X + offsetX,
        base.Y + offsetY + (tonumber(State.DoorFlightY) or 0),
        base.Z + offsetZ
    )

    -- Направление берём с камеры: куда смотришь - туда и встанешь лицом.
    local direction = Vector3.new(0, 0, -1)
    pcall(function()
        local camera = Workspace.CurrentCamera
        if camera then
            local look = camera.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0.01 then
                direction = flat.Unit
            end
        end
    end)
    if State.DoorFaceAway then
        direction = -direction
    end

    local pose = Farm.Poses[State.DoorPose] or Farm.Poses["Stand"]
    root.CFrame = CFrame.lookAt(position, position + direction)
        * CFrame.Angles(pose.pitch, 0, pose.roll)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

--==========================================================================
-- Перелёт под картой вместо мгновенного телепорта
-- Рывок видно со стороны: персонаж появляется на дороге между точками.
-- Поэтому маршрут разбит на три отрезка:
--   1) вниз на DoorTravelDepth студов - под карту,
--   2) по прямой под картой, пока X и Z не совпадут с меткой,
--   3) вверх на высоту метки, уже с поворотом к двери.
-- Ноклип включается только на время перелёта и выключается сразу на посадке:
-- под картой без него не пролететь, а на точке персонаж снова обычный, с
-- коллизиями, и стоит на полу у двери.
--==========================================================================

Farm.TravelForce = false
Farm.Traveling = false

function Farm.MoveRoot(root, position, lookAt)
    local frame
    if lookAt then
        frame = CFrame.lookAt(position, lookAt)
    else
        -- Без цели поворота держим текущий разворот, иначе тело крутит на месте.
        frame = CFrame.new(position) * (root.CFrame - root.CFrame.Position)
    end
    pcall(function()
        root.CFrame = frame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- Один отрезок маршрута: тянем рут из from в to со скоростью speed студ/сек.
function Farm.Glide(root, from, to, speed, lookAt)
    local distance = (to - from).Magnitude
    if distance < 0.05 then
        Farm.MoveRoot(root, to, lookAt)
        return true
    end
    local rate = math.max(20, tonumber(speed) or 350)
    local duration = distance / rate
    local startedAt = os.clock()
    while true do
        if not Farm.DoorRunning and not Farm.TravelForce then
            return false
        end
        if not root.Parent then
            return false
        end
        local alpha = (os.clock() - startedAt) / duration
        if alpha >= 1 then
            Farm.MoveRoot(root, to, lookAt)
            return true
        end
        -- Плавный старт и плавное торможение, чтобы не дёргалось на стыках.
        local eased = alpha * alpha * (3 - 2 * alpha)
        Farm.MoveRoot(root, from:Lerp(to, eased), lookAt)
        task.wait()
    end
end

function Farm.TravelToPoint(point)
    local root = FarmRoot()
    if not root or not point then
        return false
    end

    local base = point.Position
    -- Высота прилёта: смещение точки плюс отдельная поправка DoorFlightY.
    -- Именно ей лечится «вылезание за пропы» на посадке: докручиваем Y вверх
    -- или вниз, не трогая остальные оси.
    local goal = Vector3.new(
        base.X + (tonumber(State.DoorOffsetX) or 0),
        base.Y + (tonumber(State.DoorOffsetY) or 0) + (tonumber(State.DoorFlightY) or 0),
        base.Z + (tonumber(State.DoorOffsetZ) or 0)
    )

    local direction = Vector3.new(0, 0, -1)
    pcall(function()
        local camera = Workspace.CurrentCamera
        if camera then
            local look = camera.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0.01 then
                direction = flat.Unit
            end
        end
    end)
    if State.DoorFaceAway then
        direction = -direction
    end

    local pose = Farm.Poses[State.DoorPose] or Farm.Poses["Stand"]
    local speed = math.clamp(tonumber(State.DoorTravelSpeed) or 350, 20, 4000)
    local depth = math.clamp(tonumber(State.DoorTravelDepth) or 50, 5, 500)

    local start = root.Position
    local underY = math.min(start.Y, goal.Y) - depth
    local underStart = Vector3.new(start.X, underY, start.Z)
    local underGoal = Vector3.new(goal.X, underY, goal.Z)

    local flat = Vector3.new(underGoal.X - underStart.X, 0, underGoal.Z - underStart.Z)
    local travelDir = flat.Magnitude > 0.01 and flat.Unit or direction

    -- Ноклип только на время перелёта: под картой без него не пролететь.
    pcall(function()
        Farm.SetNoclip(true)
    end)

    Farm.Traveling = true
    local ok = Farm.Glide(root, start, underStart, speed, nil)
    if ok then
        ok = Farm.Glide(root, underStart, underGoal, speed, underGoal + travelDir)
    end
    if ok then
        ok = Farm.Glide(root, underGoal, goal, speed, goal + direction)
    end
    Farm.Traveling = false

    if not ok then
        -- Полёт сорвался (стоп фарма или потерян персонаж) - ноклип не оставляем.
        pcall(function()
            Farm.SetNoclip(false)
        end)
        return false
    end

    root.CFrame = CFrame.lookAt(goal, goal + direction) * CFrame.Angles(pose.pitch, 0, pose.roll)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Прилетели - ноклип выключаем: персонаж снова обычный, с коллизиями,
    -- и встаёт на пол у двери, а не висит закреплённым в воздухе.
    pcall(function()
        Farm.SetNoclip(false)
    end)
    return true
end

--==========================================================================
-- Глушилка анимации дверей
-- Дверь открывается на клиенте: парты внутри модели (Door, Doorframe, root)
-- уезжают твином, гаснет прозрачность, иногда играет Animator. Сервер про
-- это ничего не знает, поэтому достаточно не давать значениям измениться:
-- как только парт внутри door-модели трогает CFrame или Transparency,
-- возвращаем исходное. Дверь для нас просто стоит, промпт работает как раньше.
--==========================================================================

Farm.DoorAnim = {
    on = false,
    parts = {},
    conns = {},
    animators = {},
    guard = {},
    added = nil,
    count = 0,
}

function Farm.DoorAnim.Match(instance)
    return string.match(tostring(instance.Name), "^[Dd][Oo][Oo][Rr]%d*$") ~= nil
end

function Farm.DoorAnim.Restore(part, entry)
    if Farm.DoorAnim.guard[part] then
        return
    end
    Farm.DoorAnim.guard[part] = true
    pcall(function()
        if part.CFrame ~= entry.cf then
            part.CFrame = entry.cf
        end
        if math.abs(part.Transparency - entry.transparency) > 0.001 then
            part.Transparency = entry.transparency
        end
    end)
    Farm.DoorAnim.guard[part] = nil
end

function Farm.DoorAnim.Hook(part)
    if Farm.DoorAnim.parts[part] then
        return
    end
    local entry = {
        cf = part.CFrame,
        transparency = part.Transparency,
    }
    Farm.DoorAnim.parts[part] = entry
    Farm.DoorAnim.conns[#Farm.DoorAnim.conns + 1] = part:GetPropertyChangedSignal("CFrame"):Connect(function()
        if Farm.DoorAnim.on then
            Farm.DoorAnim.Restore(part, entry)
        end
    end)
    Farm.DoorAnim.conns[#Farm.DoorAnim.conns + 1] = part:GetPropertyChangedSignal("Transparency"):Connect(function()
        if Farm.DoorAnim.on then
            Farm.DoorAnim.Restore(part, entry)
        end
    end)
end

function Farm.DoorAnim.HookAnimator(animator)
    if Farm.DoorAnim.animators[animator] then
        return
    end
    Farm.DoorAnim.animators[animator] = true
    pcall(function()
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end)
    Farm.DoorAnim.conns[#Farm.DoorAnim.conns + 1] = animator.AnimationPlayed:Connect(function(track)
        if not Farm.DoorAnim.on then
            return
        end
        pcall(function()
            track:Stop(0)
            track:Destroy()
        end)
    end)
end

function Farm.DoorAnim.HookJoint(joint)
    if Farm.DoorAnim.animators[joint] then
        return
    end
    Farm.DoorAnim.animators[joint] = true
    local c0 = joint.C0
    local c1 = joint.C1
    Farm.DoorAnim.conns[#Farm.DoorAnim.conns + 1] = joint:GetPropertyChangedSignal("C0"):Connect(function()
        if Farm.DoorAnim.on and joint.C0 ~= c0 then
            pcall(function()
                joint.C0 = c0
            end)
        end
    end)
    Farm.DoorAnim.conns[#Farm.DoorAnim.conns + 1] = joint:GetPropertyChangedSignal("C1"):Connect(function()
        if Farm.DoorAnim.on and joint.C1 ~= c1 then
            pcall(function()
                joint.C1 = c1
            end)
        end
    end)
end

function Farm.DoorAnim.ScanModel(model)
    for _, item in ipairs(model:GetDescendants()) do
        if item:IsA("BasePart") then
            Farm.DoorAnim.Hook(item)
        elseif item:IsA("Motor6D") or item:IsA("Weld") then
            Farm.DoorAnim.HookJoint(item)
        elseif item:IsA("Animator") or item:IsA("Humanoid") then
            Farm.DoorAnim.HookAnimator(item)
        end
    end
end

function Farm.DoorAnim.Scan()
    local scanned = 0
    for _, model in ipairs(Workspace:GetDescendants()) do
        if (model:IsA("Model") or model:IsA("Folder")) and Farm.DoorAnim.Match(model) then
            Farm.DoorAnim.ScanModel(model)
            scanned = scanned + 1
        end
    end
    Farm.DoorAnim.count = scanned
    return scanned
end

function Farm.DoorAnim.Start()
    Farm.DoorAnim.on = true
    Farm.DoorAnim.Scan()
    if not Farm.DoorAnim.added then
        Farm.DoorAnim.added = Workspace.DescendantAdded:Connect(function(item)
            if not Farm.DoorAnim.on then
                return
            end
            if not (item:IsA("Model") or item:IsA("Folder")) then
                return
            end
            if Farm.DoorAnim.Match(item) then
                Farm.DoorAnim.ScanModel(item)
            end
        end)
    end
    return Farm.DoorAnim.count
end

function Farm.DoorAnim.Stop()
    Farm.DoorAnim.on = false
    for _, conn in ipairs(Farm.DoorAnim.conns) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    if Farm.DoorAnim.added then
        pcall(function()
            Farm.DoorAnim.added:Disconnect()
        end)
        Farm.DoorAnim.added = nil
    end
    Farm.DoorAnim.conns = {}
    Farm.DoorAnim.parts = {}
    Farm.DoorAnim.animators = {}
    Farm.DoorAnim.guard = {}
    Farm.DoorAnim.count = 0
end

-- Переснять текущее положение как «исходное». Нужно, если дверь успела
-- открыться до включения глушилки и мы зафиксировали её уже сдвинутой.
function Farm.DoorAnim.Resnap()
    -- Правим записи на месте: замыкания держат ссылку на ту же таблицу.
    for part, entry in pairs(Farm.DoorAnim.parts) do
        if part.Parent then
            entry.cf = part.CFrame
            entry.transparency = part.Transparency
        end
    end
end


-- Держим ближайший промпт так же, как это сделал бы игрок: сначала телепорт
-- в точку, потом нажатие. Дистанцию не подменяем - она остаётся такой, какой
-- её написал разработчик. Не мешают только стены и игроки: промпт срабатывает
-- и когда он за стеной, и когда вообще не попадает в кадр.
function Farm.InteractNear(point, radius)
    local limit = tonumber(radius) or math.huge
    local best = nil
    local bestDistance = math.huge
    local hits = {}
    for _, item in ipairs(Farm.PromptList()) do
        local prompt = item.Prompt
        if prompt.Enabled and item.Part.Parent then
            local distance = (item.Position - point.Position).Magnitude
            -- Дистанция - своя у каждого промпта. Дальше обычной не достаём,
            -- но и стены с игроками больше не обрезают. +1.5 студа - это
            -- компенсация округления координат в списке точек, не дальность.
            local reach = math.min(Farm.PromptReach(prompt) + 1.5, limit)
            if distance <= reach then
                hits[#hits + 1] = prompt
                if distance < bestDistance then
                    best = prompt
                    bestDistance = distance
                end
            end
        end
    end

    if not best then
        return false
    end

    -- Мгновенный режим: жмём не только ближайший, а все промпты в досягаемости.
    -- На двери это обычно один-два, но если их несколько на точке, попадание
    -- перестаёт зависеть от того, какой из них оказался первым в списке.
    if State.DoorInstant ~= false and #hits > 1 then
        local fired = false
        for _, prompt in ipairs(hits) do
            if Farm.TriggerPrompt(prompt) then
                fired = true
            end
        end
        return fired
    end

    return Farm.TriggerPrompt(best)
end

-- Одна попытка на точке. Возвращает:
--   "cooldown"    сервер ответил тостом про кулдаун
--   "opened"      дверь ответила наградой
--   "silent"      реакции нет
--   "unreachable" телепорт не удался
--   "stopped"     фарм выключили посреди попытки
function Farm.TryPoint(point, timeout)
    local startedAt = tick()
    Farm.DoorCooldownHit = false
    Farm.DoorCooldownHitAt = 0

    local moved
    if State.DoorTravel ~= false then
        moved = Farm.TravelToPoint(point)
    else
        moved = Farm.TeleportToPoint(point)
    end
    if not moved then
        if not Farm.DoorRunning then
            return "stopped"
        end
        return "unreachable"
    end
    -- В мгновенном режиме промпт срабатывает сразу, ждать полсекунды незачем:
    -- хватает одного кадра, чтобы позиция устоялась после посадки.
    if State.DoorInstant ~= false then
        task.wait(0.25)
    else
        task.wait(0.6)
    end

    if not Farm.InteractNear(point) then
        -- Ни одного промпта в обычной дистанции - точку не сжигаем, вернёмся.
        return "unreachable"
    end

    local limit = tonumber(timeout) or 1.5
    local waited = 0
    while waited < limit do
        if Farm.DoorCooldownHit then
            return "cooldown"
        end
        if (Farm.LastToastAt or 0) >= startedAt then
            return "opened"
        end
        if not Farm.DoorRunning then
            return "stopped"
        end
        task.wait(0.1)
        waited = waited + 0.1
    end
    return "silent"
end

local function DoorLoop(gen)
    while Farm.DoorRunning and Farm.DoorGen == gen do
        task.wait(0.25)
        local now = tick()
        if now >= Farm.DoorNextAt then
            local points = Farm.CollectPoints()
            Farm.DoorCount = #points
            if #points == 0 then
                FarmReportFor("door", "no points")
                Farm.DoorNextAt = now + 5
            else
                local cursorBefore = Farm.DoorCursor
                local chosen, index, total, waitFor = FarmNext(points, "DoorCursor", Farm.DoorVisited, State.DoorCooldown)
                -- Курсор обернулся через весь список: маршрут по точкам пройден
                -- целиком. Это второй триггер для кофе, независимый от таймера.
                if chosen and Farm.DoorCursor == 1 and cursorBefore ~= 1 then
                    if Hub.Items and Hub.Items.NoteDoorPass then
                        Hub.Items.NoteDoorPass()
                    end
                end
                if not chosen then
                    FarmReportFor("door", "all " .. tostring(total) .. " points on cooldown, next in "
                        .. tostring(math.ceil(waitFor or 10)) .. "s")
                    Farm.AllDoorsCooling = true
                    Farm.AllDoorsCoolingAt = now
                    Farm.DoorNextAt = now + math.min(math.max(waitFor or 10, 1), 60)
                else
                    Farm.DoorCurrent = chosen
                    Farm.AllDoorsCooling = false
                    local label = tostring(chosen.Name)
                    FarmReportFor("door", "point " .. tostring(index) .. "/" .. tostring(total) .. " -> " .. label)
                    local result = Farm.TryPoint(chosen, 1.5)

                    if result == "stopped" then
                        Farm.DoorRunning = false
                    elseif result == "unreachable" then
                        FarmReportFor("door", "could not reach " .. label)
                        -- retry this one in 5 seconds instead of skipping it for the whole cooldown
                        Farm.DoorVisited[label] = tick() - math.max(0, State.DoorCooldown - 5)
                        Farm.DoorNextAt = tick() + State.DoorInterval
                    else
                        Farm.DoorVisited[label] = tick()
                        if result == "cooldown" then
                            FarmReportFor("door", "cooldown -> skipping " .. label)
                            Farm.DoorNextAt = 0
                        elseif result == "opened" then
                            FarmReportFor("door", "opened -> " .. label)
                            if Hub.Items and Hub.Items.NoteDoorOpened then
                                Hub.Items.NoteDoorOpened()
                            end
                            if Hub.Items and Hub.Items.NoteDoorOpenedReward then
                                Hub.Items.NoteDoorOpenedReward()
                            end
                            Farm.DoorNextAt = tick() + State.DoorInterval
                        else
                            FarmReportFor("door", "no answer -> " .. label)
                            Farm.DoorNextAt = tick() + State.DoorInterval
                        end
                    end
                end
            end
        end
    end
end

local function CrystalLoop(gen)
    while Farm.CrystalRunning and Farm.CrystalGen == gen do
        task.wait(0.25)
        local now = tick()
        if now >= Farm.CrystalNextAt then
            local crystals = FarmCollect("crystal")
            Farm.CrystalCount = #crystals
            if #crystals == 0 then
                FarmReportFor("crystal", "no crystals found")
                Farm.CrystalNextAt = now + 5
            else
                local chosen, index, total, waitFor = FarmNext(crystals, "CrystalCursor", Farm.CrystalVisited, State.CrystalCooldown)
                if not chosen then
                    FarmReportFor("crystal", "all " .. tostring(total) .. " crystals on cooldown, next in "
                        .. tostring(math.ceil(waitFor or 10)) .. "s")
                    Farm.CrystalNextAt = now + math.min(math.max(waitFor or 10, 1), 60)
                else
                    Farm.CrystalCurrent = chosen
                    FarmReportFor("crystal", "crystal " .. tostring(index) .. "/" .. tostring(total) .. " -> " .. tostring(chosen.Name))
                    local part = FarmPartOf(chosen)
                    if part and FarmTeleport(part, 3) then
                        task.wait(0.8)
                        FarmInteract(chosen)
                        task.wait(0.5)
                        Farm.CrystalVisited[tostring(chosen.Name)] = tick()
                    else
                        FarmReportFor("crystal", "could not reach " .. tostring(chosen.Name))
                        Farm.CrystalVisited[tostring(chosen.Name)] = tick() - math.max(0, State.CrystalCooldown - 5)
                    end
                    Farm.CrystalNextAt = tick() + State.CrystalInterval
                end
            end
        end
    end
end

