local function GetMatchResultText()
    local gameEnded = GetGameEndedGui()
    if not gameEnded then
        return "Match Ended"
    end

    for _, descendant in ipairs(gameEnded:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            local text = tostring(descendant.Text or "")
            local lowered = string.lower(text)
            if lowered:find("you have defeated", 1, true)
                or lowered:find("victory", 1, true)
                or lowered:find("you won", 1, true) then
                return "Victory"
            end
        end
    end

    for _, descendant in ipairs(gameEnded:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            local lowered = string.lower(tostring(descendant.Text or ""))
            if lowered:find("defeat", 1, true)
                or lowered:find("you lost", 1, true)
                or lowered:find("game over", 1, true) then
                return "Defeat"
            end
        end
    end

    return "Match Ended"
end

local function IsDiscordWebhookURL(value)
    local url = tostring(value or "")
    return url:match("^https://discord%.com/api/webhooks/") ~= nil
        or url:match("^https://discordapp%.com/api/webhooks/") ~= nil
end

local function SendDiscordWebhook(title, description, color)
    if not State.WebhookEnabled then
        return false, "Webhook is disabled"
    end
    if not IsDiscordWebhookURL(State.WebhookURL) then
        return false, "Enter a valid Discord webhook URL"
    end

    local requestFunction = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
    if type(requestFunction) ~= "function" then
        return false, "This executor does not support HTTP requests"
    end

    local account = tostring(LocalPlayer.Name or "?")
    local display = tostring(LocalPlayer.DisplayName or "")
    if display ~= "" and display ~= account then
        account = display .. " (@" .. account .. ")"
    end

    local payload = {
        username = "Skibidi Defense Hub",
        embeds = {{
            title = tostring(title or "Skibidi Defense Hub"),
            author = { name = "Sent by " .. account },
            description = tostring(description or ""),
            color = tonumber(color) or 5793266,
            footer = { text = "Made By KrendelZ :3" },
        }},
    }
    local ok, response = pcall(function()
        return requestFunction({
            Url = State.WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)
    if not ok then
        return false, tostring(response)
    end
    return true
end

