    -- Флаги для Fluent ---------------------------------------------------------
    local flagSeq = 0
    local function NextFlag(prefix)
        flagSeq = flagSeq + 1
        return string.format("SH_%s_%d", tostring(prefix), flagSeq)
    end

    -- Обёртка над элементом Fluent: старый код ждёт Get / Set / Text ----------
    local function MakeHandle(element, getter, setter)
        local handle = { Element = element }
        handle.Get = function()
            return getter()
        end
        handle.Set = function(a, b)
            local value = b
            if value == nil then
                value = a
            end
            if value == nil then
                return
            end
            -- Защита от рекурсии. element:SetValue() внутри Fluent вызывает
            -- Callback, а колбэк старого кода снова пишет в элемент
            -- (fpsInput.Text = ...). Без этого флага получается бесконечный
            -- цикл: "Script has run for over 30 seconds" -> клиент висит
            -- намертво. Повторный вход просто игнорируем.
            if handle._busy then
                return
            end
            handle._busy = true
            local ok, err = pcall(setter, value)
            handle._busy = false
            if not ok then
                warn("[StarHub] set failed: " .. tostring(err))
            end
        end
        handle.SetValue = handle.Set
        handle.SetTitle = function(a, b)
            local text = b
            if text == nil then
                text = a
            end
            pcall(function()
                element:SetTitle(tostring(text))
            end)
        end
        handle.SetDesc = function(a, b)
            local text = b
            if text == nil then
                text = a
            end
            pcall(function()
                element:SetDesc(tostring(text))
            end)
        end
        handle.Destroy = function()
            pcall(function()
                element:Destroy()
            end)
        end
        return handle
    end

    -- Секция: прежний "GroupBox" ----------------------------------------------
    local function WrapSection(section, title)
        local box = {
            Section = section,
            Container = section.Container,
            Title = title,
        }

        -- Порядок для сырых элементов, чтобы они не уезжали в начало секции.
        function box:NextOrder()
            section._elementCount = (section._elementCount or 0) + 1
            return section._elementCount
        end

        function box:AddToggle(title, desc, defaultVal, callback)
            local state = defaultVal == true
            local element = section:AddToggle(NextFlag("Toggle"), {
                Title = tostring(title or "Toggle"),
                Description = (desc ~= nil and desc ~= "") and tostring(desc) or nil,
                Default = state,
                Callback = function(value)
                    state = value == true
                    if type(callback) == "function" then
                        pcall(callback, state)
                    end
                end,
            })
            return MakeHandle(element, function()
                return state
            end, function(value)
                state = value == true
                pcall(function()
                    element:SetValue(state)
                end)
            end)
        end

        function box:AddSlider(title, minVal, maxVal, defaultVal, suffix, callback)
            local min = tonumber(minVal) or 0
            local max = tonumber(maxVal) or 100
            if max <= min then
                max = min + 1
            end
            local state = math.clamp(tonumber(defaultVal) or min, min, max)
            local integer = (math.floor(max) == max) and (math.floor(min) == min)
            local element = section:AddSlider(NextFlag("Slider"), {
                Title = tostring(title or "Slider"),
                Description = (suffix ~= nil and tostring(suffix) ~= "") and tostring(suffix) or nil,
                Min = min,
                Max = max,
                Default = state,
                Rounding = integer and 0 or 2,
                Callback = function(value)
                    state = tonumber(value) or state
                    if type(callback) == "function" then
                        pcall(callback, state)
                    end
                end,
            })
            return MakeHandle(element, function()
                return state
            end, function(value)
                state = math.clamp(tonumber(value) or state, min, max)
                pcall(function()
                    element:SetValue(state)
                end)
            end)
        end

        function box:AddDropdown(title, options, defaultVal, callback)
            local values = {}
            for index, option in ipairs(options or {}) do
                values[index] = tostring(option)
            end
            local state = defaultVal
            if state == nil then
                state = values[1]
            end
            -- Fluent падает, если Default не входит в Values: подстраховываемся.
            if #values > 0 and not table.find(values, tostring(state)) then
                state = values[1]
            end
            local element = section:AddDropdown(NextFlag("Dropdown"), {
                Title = tostring(title or "Select"),
                Values = values,
                Default = state,
                Callback = function(value)
                    state = value
                    if type(callback) == "function" then
                        pcall(callback, value)
                    end
                end,
            })
            return MakeHandle(element, function()
                return state
            end, function(value)
                state = value
                pcall(function()
                    element:SetValue(value)
                end)
            end)
        end

        function box:AddInput(name, placeholder, defaultVal, callback)
            local state = tostring(defaultVal or "")
            local element = section:AddInput(NextFlag("Input"), {
                Title = tostring(name or "Input"),
                Placeholder = placeholder,
                Default = state,
                Finished = true,
                Callback = function(value)
                    state = tostring(value or "")
                    if type(callback) == "function" then
                        pcall(callback, state)
                    end
                end,
            })
            local handle = MakeHandle(element, function()
                return state
            end, function(value)
                state = tostring(value)
                pcall(function()
                    element:SetValue(state)
                end)
            end)
            -- Старый код читает и пишет handle.Text напрямую.
            return setmetatable(handle, {
                __index = function(_, key)
                    if key == "Text" then
                        return state
                    end
                    return rawget(handle, key)
                end,
                __newindex = function(_, key, value)
                    if key == "Text" then
                        -- Тот же капкан: element:SetValue ниже снова дёрнет
                        -- Callback, а тот опять напишет .Text. Флаг рвёт цикл.
                        if handle._busy then
                            return
                        end
                        handle._busy = true
                        local text = tostring(value)
                        state = text
                        pcall(function()
                            element:SetValue(text)
                        end)
                        if type(callback) == "function" then
                            pcall(callback, text)
                        end
                        handle._busy = false
                        return
                    end
                    rawset(handle, key, value)
                end,
            })
        end

        function box:AddActionRow(title, desc, icon, callback)
            local element = section:AddButton({
                Title = tostring(title or "Button"),
                Description = (desc ~= nil and desc ~= "") and tostring(desc) or nil,
                Icon = ResolveIcon(icon),
                Callback = function()
                    if type(callback) == "function" then
                        pcall(callback)
                    end
                end,
            })
            return MakeHandle(element, function()
                return nil
            end, function() end)
        end

        function box:AddParagraph(title, content)
            return section:AddParagraph({
                Title = tostring(title or ""),
                Content = tostring(content or ""),
            })
        end

        function box:AddColorPickerRow(name, defaultColor, callback)
            local state = defaultColor or Color3.fromRGB(255, 255, 255)
            local element = section:AddColorpicker(NextFlag("Color"), {
                Title = tostring(name or "Color"),
                Default = state,
                Callback = function(color)
                    state = color
                    if type(callback) == "function" then
                        pcall(callback, color)
                    end
                end,
            })
            return MakeHandle(element, function()
                return state
            end, function(value)
                if typeof(value) == "Color3" then
                    state = value
                    pcall(function()
                        element:SetValue(state)
                    end)
                end
            end)
        end

        function box:AddModeSelector(name, modes, defaultVal, callback)
            return box:AddDropdown(name, modes, defaultVal, callback)
        end

        function box:AddSpace(height)
            section:AddSpace({ Height = tonumber(height) or 8 })
        end

        function box:AddDivider()
            section:AddDivider()
        end

        return box
    end

    -- Окно ---------------------------------------------------------------------
    function StarHubUI:CreateWindow(cfg)
        cfg = cfg or {}

        local UISvc = game:GetService("UserInputService")
        local isMobileUI = UISvc.TouchEnabled and not UISvc.MouseEnabled and not UISvc.KeyboardEnabled
        local LocalPlayerUI = game:GetService("Players").LocalPlayer
        local executorName = "Executor"
        pcall(function()
            if type(identifyexecutor) == "function" then
                local n = identifyexecutor()
                if type(n) == "string" and n ~= "" then
                    executorName = n
                end
            end
        end)

        -- Конфиг окна снят один в один с официального Example.lua из
        -- Fluent-Modded 1.6.0: квадратное окно, акрил, фон, поиск с
        -- подсветкой, теги и блок пользователя в шапке.
        local fullCfg = {
            Title = tostring(cfg.Title or "Skibidi Defense Hub"),
            SubTitle = cfg.SubTitle and tostring(cfg.SubTitle) or "Made by: KrendelZ",
            Size = cfg.Size or (isMobileUI and UDim2.fromOffset(640, 640) or UDim2.fromOffset(680, 680)),
            -- TabWidth обязателен: в этой сборке Fluent у него нет значения по
            -- умолчанию, и без него окно падает на "-t.TabWidth - 32".
            TabWidth = cfg.TabWidth or (isMobileUI and 130 or 150),
            Theme = "Dark",
            Acrylic = true,
            Background = true,
            Font = "GothamSSm",
            Tags = {
                { Text = executorName, Color = Color3.fromRGB(255, 100, 180) },
                {
                    Text = "Hello " .. tostring(LocalPlayerUI and LocalPlayerUI.DisplayName or "Player"),
                    Color = Color3.fromRGB(0, 0, 0),
                },
            },
            Search = {
                Search = true,
                Highlight = true,
                HighlightColor = Color3.fromRGB(180, 10, 20),
            },
            UserInfo = {
                UserInfo = true,
                UserInfoTitle = LocalPlayerUI and LocalPlayerUI.Name or "Player",
                UserInfoSubtitle = LocalPlayerUI and LocalPlayerUI.DisplayName or "",
                UserInfoColor = Color3.fromRGB(180, 10, 20),
            },
            Anonymous = {
                Default = false,
                ShowAno = true,
                AnoUserInfoTitle = "Hidden",
                AnoUserInfoSubTitle = "",
            },
            FolderName = "StarHubFluent",
            ScreenGuiName = "StarHubFluent",
            MinimizeKey = cfg.ToggleKey or Enum.KeyCode.RightShift,
        }

        -- Окно создаётся лестницей: полный конфиг -> без акрила/фона ->
        -- совсем голое. Каждая попытка в pcall и пишется в лог. Раньше при
        -- отказе полного конфига вызывался ещё один CreateWindow без pcall,
        -- он падал на дубликате ScreenGui, и наружу уходила ошибка — скрипт
        -- умирал до первого таба, меню не появлялось.
        local attempts = {
            fullCfg,
            {
                Title = fullCfg.Title,
                SubTitle = fullCfg.SubTitle,
                Size = fullCfg.Size,
                TabWidth = fullCfg.TabWidth,
                Theme = "Dark",
                Acrylic = false,
                Background = false,
                Font = "GothamSSm",
                FolderName = "StarHubFluent",
                ScreenGuiName = "StarHubFluentB",
                MinimizeKey = fullCfg.MinimizeKey,
            },
            {
                Title = fullCfg.Title,
                Size = UDim2.fromOffset(680, 680),
                TabWidth = 150,
                Theme = "Dark",
                Acrylic = false,
                FolderName = "StarHubFluent",
                ScreenGuiName = "StarHubFluentC",
                MinimizeKey = fullCfg.MinimizeKey,
            },
        }

        local function LogBoot(text)
            pcall(function()
                if writefile then
                    writefile("StarHub_boot.log",
                        tostring(text) .. " @ " .. string.format("%.2f", os.clock()))
                end
            end)
        end

        local fluentWindow, lastErr
        for index = 1, #attempts do
            local ok, res = pcall(function()
                return Fluent:CreateWindow(attempts[index])
            end)
            if ok and res then
                fluentWindow = res
                LogBoot(string.format("createwindow ok (attempt %d)", index))
                break
            end
            lastErr = res
            warn(string.format("[StarHub] CreateWindow attempt %d failed: %s", index, tostring(res)))
            LogBoot(string.format("createwindow FAIL %d: %s", index, tostring(res)))
            -- Подчищаем недоделанный ScreenGui, иначе следующая попытка
            -- упрётся в дубликат имени. Живой GUI библиотеки не трогаем:
            -- Fluent.GUI — это тот же ScreenGui, и его удаление убивает всё.
            pcall(function()
                local coreGui = game:GetService("CoreGui")
                local live = Fluent and Fluent.GUI
                for _, child in ipairs(coreGui:GetChildren()) do
                    if child:IsA("ScreenGui") and child ~= live
                        and (child.Name == "StarHubFluent"
                            or child.Name == "StarHubFluentB"
                            or child.Name == "StarHubFluentC") then
                        child:Destroy()
                    end
                end
            end)
        end
        if not fluentWindow then
            error("[StarHub] Fluent не создал окно: " .. tostring(lastErr))
        end

        -- Как в примере: уведомления рисуются внутри окна, а не поверх игры.
        pcall(function()
            Fluent.NotifyInsideWindow = true
        end)

        local Window = {
            FluentWindow = fluentWindow,
            Tabs = {},
            TabOrder = {},
        }

        function Window:CreateTab(opts)
            opts = opts or {}
            -- Пауза между табами: сборка одного таба — это сотни инстансов.
            -- Без уступки поток клиент замирает на всю сборку целиком.
            task.wait()
            -- Пишем прогресс ещё и в файл: если клиент всё-таки встанет,
            -- консоль уже не открыть, а лог на диске останется.
            pcall(function()
                if writefile then
                    writefile("StarHub_boot.log",
                        string.format("tab %s at %.2f", tostring(opts.Title), os.clock()))
                end
            end)
            print(string.format("[StarHub] tab %-10s %.2fs", tostring(opts.Title), os.clock()))
            local fluentTab = fluentWindow:AddTab({
                Title = tostring(opts.Title or "Tab"),
                Icon = ResolveIcon(opts.IconId),
            })
            local tab = {
                FluentTab = fluentTab,
                Title = opts.Title,
            }
            function tab:CreateGroupBox(sideOrTitle, titleOrBadge, badgeOrIcon, iconOpt)
                local title, icon
                if sideOrTitle == "Right" or sideOrTitle == "Left"
                    or sideOrTitle == 1 or sideOrTitle == 2 then
                    title = titleOrBadge
                    icon = iconOpt
                else
                    title = sideOrTitle
                    icon = iconOpt or badgeOrIcon
                end
                -- Ещё одна уступка потоку внутри таба. pcall нужен на случай
                -- вызова из невыдерживающего контекста (firesignal и т.п.).
                pcall(task.wait)
                local section = fluentTab:AddSection(tostring(title or "Group"), ResolveIcon(icon))
                return WrapSection(section, title)
            end
            function tab:AddParagraph(title, content)
                return fluentTab:AddParagraph({
                    Title = tostring(title or ""),
                    Content = tostring(content or ""),
                })
            end
            Window.Tabs[#Window.Tabs + 1] = tab
            return tab
        end

        -- В официальном примере группы табов разделяются тонкой линией
        -- (Window:AddDividerTabs). Старые заголовки навигации теперь играют
        -- ровно эту роль.
        function Window:AddNavHeader()
            pcall(function()
                fluentWindow:AddDividerTabs()
            end)
            return nil
        end

        function Window:SelectTab(index)
            pcall(function()
                fluentWindow:SelectTab(index)
            end)
        end

        function Window:Dialog(opts)
            pcall(function()
                fluentWindow:Dialog(opts)
            end)
        end

        function Window:SetTheme(name)
            pcall(function()
                Fluent:SetTheme(name)
            end)
        end

        -- Свернуть / развернуть окно без toggle-уведомления.
        -- Fluent умеет Show()/Hide() и держит флаг Minimized.
        function Window:SetMinimized(state)
            pcall(function()
                if state then
                    fluentWindow:Hide()
                else
                    fluentWindow:Show()
                end
            end)
        end

        function Window:IsMinimized()
            local ok, value = pcall(function()
                return fluentWindow.Minimized
            end)
            return ok and value == true
        end

        function Window:ToggleMinimized()
            if Window:IsMinimized() then
                Window:SetMinimized(false)
            else
                Window:SetMinimized(true)
            end
        end

        -- Окно никогда не должно быть больше экрана --------------------------
        -- 680x680 на телефоне не влезает, поэтому режем по фактическому
        -- ViewportSize. Вызывается при старте и на каждый поворот/ресайз.
        function Window:FitToScreen()
            local ok = pcall(function()
                local camera = Workspace.CurrentCamera
                if not camera then
                    return
                end
                local viewport = camera.ViewportSize
                if not viewport or viewport.X < 1 or viewport.Y < 1 then
                    return
                end
                local root = fluentWindow.Root
                if not root then
                    return
                end

                local base = fluentWindow.Size
                local wantW, wantH = 680, 680
                if base then
                    if base.X and base.X.Offset and base.X.Offset > 0 then
                        wantW = base.X.Offset
                    end
                    if base.Y and base.Y.Offset and base.Y.Offset > 0 then
                        wantH = base.Y.Offset
                    end
                end

                -- Желаемый размер запоминаем один раз: иначе после первого
                -- сжатия на телефоне окно уже не вырастет обратно на ПК.
                if not Window._baseW then
                    Window._baseW = wantW
                    Window._baseH = wantH
                else
                    wantW = Window._baseW
                    wantH = Window._baseH
                end

                -- Отступ по краям: на маленьком экране меньше, но окно
                -- всегда остаётся внутри.
                local padX = (viewport.X < 720) and 12 or 48
                local padY = (viewport.Y < 620) and 12 or 48
                local maxW = math.max(300, viewport.X - padX * 2)
                local maxH = math.max(240, viewport.Y - padY * 2)

                local w = math.clamp(wantW, 300, maxW)
                local h = math.clamp(wantH, 240, maxH)
                if w > maxW then w = maxW end
                if h > maxH then h = maxH end

                root.Size = UDim2.fromOffset(w, h)
                root.Position = UDim2.fromOffset(
                    math.floor(math.max(0, (viewport.X - w) / 2)),
                    math.floor(math.max(0, (viewport.Y - h) / 2)))

                fluentWindow.Size = UDim2.fromOffset(w, h)
                fluentWindow.Position = root.Position
            end)
            return ok
        end

        Window.Fluent = Fluent
        Window.ScreenGui = Fluent.GUI

        -- Первичная подгонка и слежение за поворотом экрана / сменой камеры.
        pcall(function()
            Window:FitToScreen()
        end)
        task.defer(function()
            pcall(function()
                Window:FitToScreen()
            end)
        end)
        task.delay(0.6, function()
            pcall(function()
                Window:FitToScreen()
            end)
        end)
        pcall(function()
            local camera = Workspace.CurrentCamera
            if camera then
                camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                    pcall(function()
                        Window:FitToScreen()
                    end)
                end)
            end
        end)
        pcall(function()
            Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
                local camera = Workspace.CurrentCamera
                if camera then
                    pcall(function()
                        Window:FitToScreen()
                    end)
                end
            end)
        end)

