    function FFlags.runStartupAutoApply()
        if FFlags.autoAttempted then
            return
        end
        local snapshot = FFlags.getSnapshot()
        if not snapshot or not snapshot.enabled then
            return
        end
        FFlags.autoAttempted = true
        if snapshot.pending then
            local ok = FFlags.quarantineInterruptedStartup()
            FFlagReport(ok
                and "Auto apply was disabled because the previous startup did not reach its checkpoint. The snapshot was kept."
                or "The interrupted FFlag startup could not be quarantined.")
            return
        end
        if not snapshot.valid then
            FFlagReport("The saved FFlag snapshot is invalid; the hub continued loading.")
            return
        end
        local token = FFlags.beginStartupAttempt(snapshot.payload)
        if not token then
            FFlagReport("Crash-loop protection could not be armed. Auto apply was skipped.")
            return
        end
        local ok, result = pcall(FFlags.applyPayload, snapshot.payload, { automatic = true })
        if not ok then
            FFlags.busy = false
            FFlagReport("Auto apply stopped safely; the hub continued loading.")
            return
        end
        if result and not result.cancelled then
            FFlagReport(string.format("Auto-applied %d of %d flags.", result.applied, result.total))
        end
        task.delay(15, function()
            if State.Running then
                FFlags.completeStartupAttempt(token)
            end
        end)
    end

