local changingToggle = false
local recordToggle
local playbackToggle

local function SetToggleSafe(element, value)
    if not element then return end
    changingToggle = true
    pcall(function() element:Set(value == true) end)
    changingToggle = false
end
Gui.SetRecordToggle = function(value) SetToggleSafe(recordToggle, value) end
Gui.SetPlaybackToggle = function(value) SetToggleSafe(playbackToggle, value) end

recordToggle = StatusBox:AddToggle("Record", "Captures tower placements and ability casts", false, function(value)
    if changingToggle then return end
    if value then
        if State.PlaybackEnabled then
            SetToggleSafe(playbackToggle, false)
            State.PlaybackEnabled = false
            QueueSave()
        end
        if State.Playing then
            StopPlayback("Stopped to begin recording")
        end
        local name = State.ProfileName ~= "" and State.ProfileName or newProfileName
        local ok, message = StartRecording(name)
        if not ok then
            SetToggleSafe(recordToggle, false)
            Notify("Cannot record", tostring(message))
        end
    elseif State.Recording then
        local ok, message = StopRecording(true)
        if ok then
            RebuildProfiles(State.ProfileName)
            QueueSave()
        else
            Notify("Cannot save", tostring(message))
        end
    end
end)

playbackToggle = StatusBox:AddToggle("Playback", "Arms the saved profile for automatic playback", State.PlaybackEnabled, function(value)
    if changingToggle then return end
    State.PlaybackEnabled = value == true
    QueueSave()
    if value then
        if State.Recording then
            SetToggleSafe(recordToggle, false)
            StopRecording(true)
        end
        local ok, message = StartPlayback()
        if not ok then
            SetStatus("Playback armed", tostring(message))
        end
    elseif State.Playing then
        StopPlayback("Stopped by user")
    end
end)

