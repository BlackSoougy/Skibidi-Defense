    -- Fullbright ---------------------------------------------------------------
    local Fullbright = {
        active = false,
        stored = nil,
    }

    local function FullbrightColor(list, fallback)
        if type(list) ~= "table" then
            return fallback
        end
        return Color3.fromRGB(
            math.clamp(tonumber(list[1]) or 255, 0, 255),
            math.clamp(tonumber(list[2]) or 255, 0, 255),
            math.clamp(tonumber(list[3]) or 255, 0, 255)
        )
    end

    local function FullbrightStore()
        local effects = {}
        for _, child in ipairs(LightingService:GetChildren()) do
            if child:IsA("Atmosphere") then
                effects[#effects + 1] = { object = child, property = "Density", value = child.Density, off = 0 }
            elseif child:IsA("PostEffect") then
                effects[#effects + 1] = { object = child, property = "Enabled", value = child.Enabled, off = false }
            elseif child:IsA("Clouds") then
                effects[#effects + 1] = { object = child, property = "Enabled", value = child.Enabled, off = false }
            end
        end
        Fullbright.stored = {
            Brightness = LightingService.Brightness,
            Ambient = LightingService.Ambient,
            OutdoorAmbient = LightingService.OutdoorAmbient,
            FogStart = LightingService.FogStart,
            FogEnd = LightingService.FogEnd,
            ClockTime = LightingService.ClockTime,
            GlobalShadows = LightingService.GlobalShadows,
            ExposureCompensation = LightingService.ExposureCompensation,
            Effects = effects,
        }
    end

    function Fullbright.apply()
        if not Fullbright.stored then
            FullbrightStore()
        end
        local stored = Fullbright.stored
        pcall(function()
            LightingService.Brightness = math.clamp(tonumber(State.FullbrightBrightness) or 3, 0, 10)
            LightingService.Ambient = FullbrightColor(State.FullbrightAmbient, Color3.fromRGB(200, 200, 200))
            LightingService.OutdoorAmbient = FullbrightColor(State.FullbrightOutdoor, Color3.fromRGB(200, 200, 200))
            LightingService.ClockTime = math.clamp(tonumber(State.FullbrightClock) or 14, 0, 24)
            LightingService.GlobalShadows = State.FullbrightShadows == true
            LightingService.ExposureCompensation = math.clamp(tonumber(State.FullbrightExposure) or 0, -3, 3)
            if State.FullbrightFog then
                LightingService.FogStart = 0
                LightingService.FogEnd = math.clamp(tonumber(State.FullbrightFogEnd) or 100000, 1000, 100000)
            else
                LightingService.FogStart = stored.FogStart
                LightingService.FogEnd = stored.FogEnd
            end
        end)
        for _, effect in ipairs(stored.Effects) do
            if effect.object and effect.object.Parent then
                if State.FullbrightNoAtmosphere and effect.property == "Density" then
                    pcall(function()
                        effect.object.Density = effect.off
                    end)
                elseif State.FullbrightNoPost and effect.property == "Enabled" then
                    pcall(function()
                        effect.object.Enabled = effect.off
                    end)
                else
                    pcall(function()
                        effect.object[effect.property] = effect.value
                    end)
                end
            end
        end
        Fullbright.active = true
    end

    function Fullbright.restore()
        local stored = Fullbright.stored
        if not stored then
            Fullbright.active = false
            return
        end
        pcall(function()
            LightingService.Brightness = stored.Brightness
            LightingService.Ambient = stored.Ambient
            LightingService.OutdoorAmbient = stored.OutdoorAmbient
            LightingService.FogStart = stored.FogStart
            LightingService.FogEnd = stored.FogEnd
            LightingService.ClockTime = stored.ClockTime
            LightingService.GlobalShadows = stored.GlobalShadows
            LightingService.ExposureCompensation = stored.ExposureCompensation
        end)
        for _, effect in ipairs(stored.Effects) do
            if effect.object and effect.object.Parent then
                pcall(function()
                    effect.object[effect.property] = effect.value
                end)
            end
        end
        Fullbright.active = false
    end

    function Fullbright.setEnabled(enabled)
        if enabled then
            Fullbright.apply()
        else
            Fullbright.restore()
        end
    end

    function Fullbright.refresh()
        if Fullbright.active then
