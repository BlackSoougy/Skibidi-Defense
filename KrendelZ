        RebuildProfiles()
        return
    end

    local now = os.clock()
    if pendingDelete ~= name or (now - pendingDeleteAt) > 6 then
        pendingDelete = name
        pendingDeleteAt = now
        Notify("Delete Macro", "Нажми ещё раз в течение 6 секунд, чтобы удалить «" .. name .. "»")
        SetStatus("Confirm delete", name)
        return
    end
    pendingDelete = nil

    local ok, err = pcall(delfile, ProfilePath(name))
    if not ok then
        Notify("Delete failed", tostring(err))
        return
    end

    -- Если удалили загруженный макрос — память тоже чистим,
    -- иначе Save вернёт его обратно на диск.
    if State.ProfileName == name then
        State.ProfileName = ""
        State.ProfileVersion = 0
        State.Actions = {}
        RefreshActionList()
    end
    if newProfileName == name then
        newProfileName = ""
        Config.NewProfileName = ""
        if Gui.MacroNameInput and Gui.MacroNameInput.Set then
            pcall(function()
                Gui.MacroNameInput:Set("")
            end)
        end
    end

    RebuildProfiles()
    SetStatus("Deleted", name)
    Notify("Delete Macro", "«" .. name .. "» удалён")
    QueueSave()
end)

