do
    -- Multiline text area (StarHubUI only ships single line inputs).
    local function MakeTextArea(box, title, placeholder, height, onChanged)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, height + 16)
        holder.BackgroundTransparency = 1
        holder.Parent = box.Container

        local caption = Instance.new("TextLabel")
        caption.Size = UDim2.new(1, 0, 0, 14)
        caption.BackgroundTransparency = 1
        caption.Font = Enum.Font.GothamMedium
        caption.TextSize = 10
        caption.TextColor3 = SHTheme.TextDim
        caption.TextXAlignment = Enum.TextXAlignment.Left
        caption.Text = string.upper(title)
        caption.Parent = holder

        local area = Instance.new("TextBox")
        area.Size = UDim2.new(1, 0, 0, height)
        area.Position = UDim2.new(0, 0, 0, 16)
        area.BackgroundColor3 = SHTheme.SubBox
        area.BorderSizePixel = 0
        area.Text = ""
        area.PlaceholderText = placeholder or ""
        area.PlaceholderColor3 = SHTheme.TextDim
        area.TextColor3 = SHTheme.TextBody
        area.TextSize = 11
        area.Font = Enum.Font.Code
        area.TextXAlignment = Enum.TextXAlignment.Left
        area.TextYAlignment = Enum.TextYAlignment.Top
        area.MultiLine = true
        area.TextWrapped = true
        area.ClearTextOnFocus = false
        area.Parent = holder
        Instance.new("UICorner", area).CornerRadius = UDim.new(0, 10)
        local stroke = Instance.new("UIStroke", area)
        stroke.Color = SHTheme.Border

        local padding = Instance.new("UIPadding", area)
        padding.PaddingLeft = UDim.new(0, 8)
        padding.PaddingRight = UDim.new(0, 8)
        padding.PaddingTop = UDim.new(0, 6)
        padding.PaddingBottom = UDim.new(0, 6)

        if type(onChanged) == "function" then
            area:GetPropertyChangedSignal("Text"):Connect(function()
                pcall(onChanged, area.Text)
            end)
        end
        return area
    end

    Window:AddNavHeader("CLIENT", 9)

    local ClientTab = Window:CreateTab({
        Title = "Client",
        IconId = StarHubUI.Icons.Settings,
        LayoutOrder = 10,
    })

    local FFlagBox = ClientTab:CreateGroupBox("Left", "Fast Flags", "JSON", StarHubUI.Icons.Save)
    local flagRun = { busy = false, cancel = false }
    local FlagValidate
    local flagStatus

    local flagEditor = MakeTextArea(FFlagBox, "FFlag JSON", "{\"FFlagExample\": \"false\"}", 170, function()
        if FlagValidate then
            task.defer(function()
                pcall(FlagValidate)
            end)
        end
    end)

    flagStatus = MakeInfoRow(FFlagBox, "No FFlags entered", "Paste a JSON object to begin", StarHubUI.Icons.Info)

    FlagValidate = function(verbose)
        local text = flagEditor.Text or ""
        if text:gsub("%s", "") == "" then
            flagStatus:SetTitle("No FFlags entered")
            flagStatus:SetDesc("Paste a JSON object to begin")
            return nil
        end
        local parsed, err = Hub.FFlags.parsePayload(text)
        if not parsed then
            flagStatus:SetTitle("Invalid JSON")
            flagStatus:SetDesc(tostring(err or "Check the syntax"))
            if verbose then
                Notify("Invalid FFlags", tostring(err or "Paste a valid JSON object."))
            end
            return nil
        end
        local network, physics, materials = 0, 0, 0
        for _, entry in ipairs(parsed) do
            local name = string.lower(tostring(entry.name))
            if name:find("network") or name:find("raknet") or name:find("replic")
                or name:find("packet") or name:find("bandwidth") or name:find("mtu") then
                network = network + 1
            end
            if name:find("physics") or name:find("sim") or name:find("voxel")
                or name:find("solver") or name:find("collision") then
                physics = physics + 1
            end
            if name:find("texturepack") or name:find("materialtable") then
                materials = materials + 1
            end
        end
        local risk = {}
        if network > 0 then risk[#risk + 1] = "Network " .. network end
        if physics > 0 then risk[#risk + 1] = "Physics " .. physics end
        if materials > 0 then risk[#risk + 1] = "Materials " .. materials end
        flagStatus:SetTitle(string.format("Valid JSON: %d flags", #parsed))
        flagStatus:SetDesc("High-risk: " .. (#risk > 0 and table.concat(risk, ", ") or "none"))
        return parsed
    end

    FFlagBox:AddActionRow("Apply FFlags", "Writes every flag with setfflag and verifies it", StarHubUI.Icons.Check, function()
        if flagRun.busy then
            Notify("FFlags", "A preset is already being applied.")
            return
        end
        if not FlagValidate(true) then
            return
        end
        local payload = flagEditor.Text
        flagRun.busy = true
        flagRun.cancel = false
        task.spawn(function()
            local ok, result, err = pcall(Hub.FFlags.applyPayload, payload, {
                shouldCancel = function()
                    return flagRun.cancel
                end,
            })
            flagRun.busy = false
            if not ok then
                flagStatus:SetTitle("Apply failed")
                flagStatus:SetDesc("The engine stopped safely")
                Notify("FFlags", "Application stopped safely.")
                return
            end
            if not result then
                flagStatus:SetTitle("Apply unavailable")
                flagStatus:SetDesc(tostring(err or "setfflag is missing"))
                Notify("FFlags Unavailable", tostring(err or "Your executor does not provide setfflag."))
                return
            end
            if result.cancelled then
                flagStatus:SetTitle(string.format("Cancelled: %d/%d", result.processed, result.total))
                flagStatus:SetDesc("Stopped after the current flag")
                Notify("FFlags Cancelled", string.format("Stopped after %d of %d flags.", result.processed, result.total))
            elseif result.failed > 0 then
                flagStatus:SetTitle(string.format("Applied %d/%d", result.applied, result.total))
                flagStatus:SetDesc(string.format("%d flags failed or unsupported", result.failed))
                Notify("FFlags Applied", string.format("Applied %d of %d. %d failed.", result.applied, result.total, result.failed))
            else
                flagStatus:SetTitle(string.format("Applied %d flags", result.applied))
                flagStatus:SetDesc("Rejoin if the preset requires it")
                Notify("FFlags Applied", string.format("Applied %d flags.", result.applied))
            end
        end)
    end)

    FFlagBox:AddActionRow("Cancel Apply", "Stops safely after the current flag", StarHubUI.Icons.Close, function()
        if not flagRun.busy then
            Notify("FFlags", "Nothing is currently applying.")
            return
        end
        flagRun.cancel = true
        flagStatus:SetDesc("Cancelling after the current flag...")
    end)

    FFlagBox:AddActionRow("Clear Editor", "Empties the JSON box; applied flags stay applied", StarHubUI.Icons.Skull, function()
        flagEditor.Text = ""
        Notify("FFlags", "Editor cleared. Applied flags were not undone.")
    end)

    -- FPS cap ---------------------------------------------------------------
    local PerfBox = ClientTab:CreateGroupBox("Left", "Performance", "FPS", StarHubUI.Icons.Zap)
    local fpsRow = MakeInfoRow(PerfBox, "Cap: 240 FPS", "Type a value or unlock it", StarHubUI.Icons.Dashboard)

    local function ApplyFpsCap()
        local cap = tonumber(State.FpsCap) or 0
        if cap < 0 then
            cap = 0
        end
        if cap > 0 and cap < 5 then
            cap = 5
        end
        State.FpsCap = math.floor(cap)
        if State.FpsCap > 0 then
            State.FpsCapLast = State.FpsCap
        end
        fpsRow:SetTitle(State.FpsCap == 0 and "Cap: unlimited" or string.format("Cap: %d FPS", State.FpsCap))
        if type(setfpscap) == "function" then
            pcall(setfpscap, State.FpsCap)
            fpsRow:SetDesc(State.FpsCap == 0 and "No limit on this session" or "Applied to this session")
            return true
        end
        fpsRow:SetDesc("setfpscap is missing in this executor")
        return false
    end

    local fpsInput
    fpsInput = PerfBox:AddInput("FPS Cap", "5 or more, 0 = unlimited", tostring(State.FpsCap), function(value)
        local raw = string.lower(tostring(value or "")):match("^%s*(.-)%s*$")
        local cap
        if raw == "" or raw == "0" or raw == "inf" or raw == "infinite"
            or raw == "unlimited" or raw == "max" or raw == "none" then
            cap = 0
        else
            cap = tonumber(raw)
        end
        if not cap then
            fpsInput.Text = tostring(State.FpsCap)
            Notify("FPS Cap", "Type a number, or 0 for unlimited.")
            return
        end
        if cap > 0 and cap < 5 then
            cap = 5
            Notify("FPS Cap", "The lowest cap is 5 FPS.")
        end
        State.FpsCap = math.floor(cap)
        fpsInput.Text = tostring(State.FpsCap)
        ApplyFpsCap()
