-- Configs tab: create, save, load, delete and auto-load named settings snapshots.
do
    local NamedConfigFile = "SkibidiDefense_Configs.json"
    local AutoKey = "__autoLoad"

    Hub.Config = {
        File = NamedConfigFile,
        active = "",
        selected = "",
    }

    function Hub.Config.Collect()
        local values = {}
        for _, key in ipairs(Gui.WidgetOrder) do
            local handle = Gui.Widgets[key]
            if handle and type(handle.Get) == "function" then
                local ok, value = pcall(handle.Get)
                if ok and value ~= nil then
                    values[key] = value
                end
            end
        end
        return values
    end

    function Hub.Config.Apply(values)
        if type(values) ~= "table" then
            return 0
        end
        local applied = 0
        for key, value in pairs(values) do
            local handle = Gui.Widgets[key]
            if handle and type(handle.Set) == "function" then
                if pcall(handle.Set, value) then
                    applied = applied + 1
                end
            end
        end
        return applied
    end

    function Hub.Config.Count()
        return #Gui.WidgetOrder
    end

    local function ReadNamed()
        if type(readfile) ~= "function" then
            return {}
        end
        if type(isfile) == "function" and not isfile(NamedConfigFile) then
            return {}
        end
        local ok, content = pcall(readfile, NamedConfigFile)
        if not ok or type(content) ~= "string" or content == "" then
            return {}
        end
        local decoded, data = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if decoded and type(data) == "table" then
            return data
        end
        return {}
    end

    local function WriteNamed(map)
        if type(writefile) ~= "function" then
            return false
        end
        local encoded, body = pcall(function()
            return HttpService:JSONEncode(map)
        end)
        if not encoded then
            return false
        end
        local ok, result = pcall(writefile, NamedConfigFile, body)
        return ok and result ~= false
    end

    function Hub.Config.Names()
        local names = {}
        for name, entry in pairs(ReadNamed()) do
            if type(entry) == "table" and type(entry.Values) == "table" then
                names[#names + 1] = tostring(name)
            end
        end
        table.sort(names)
        return names
    end

    function Hub.Config.GetAutoLoad()
        local value = ReadNamed()[AutoKey]
        if type(value) == "string" then
            return value
        end
        return ""
    end

    function Hub.Config.SetAutoLoad(name)
        local map = ReadNamed()
        if name == nil or name == "" or type(map[name]) ~= "table" then
            map[AutoKey] = nil
        else
            map[AutoKey] = name
        end
        return WriteNamed(map)
    end

    function Hub.Config.Save(name)
        local map = ReadNamed()
        map[name] = {
            Version = 1,
            SavedAt = os.time(),
            Values = Hub.Config.Collect(),
        }
        if WriteNamed(map) then
            Hub.Config.active = name
            return true, nil
        end
        return false, "The config file could not be written."
    end

    function Hub.Config.Load(name)
        local entry = ReadNamed()[name]
        if type(entry) ~= "table" or type(entry.Values) ~= "table" then
            return false, "No saved config with that name."
        end
        local applied = Hub.Config.Apply(entry.Values)
        Hub.Config.active = name
        return true, applied
    end

    function Hub.Config.Delete(name)
        local map = ReadNamed()
        if type(map[name]) ~= "table" then
            return false, "No saved config with that name."
        end
        map[name] = nil
        if map[AutoKey] == name then
            map[AutoKey] = nil
        end
        if WriteNamed(map) then
            if Hub.Config.active == name then
                Hub.Config.active = ""
            end
            if Hub.Config.selected == name then
                Hub.Config.selected = ""
            end
            return true, nil
        end
        return false, "The config file could not be updated."
    end

    -- Applies the auto-load config, otherwise the last saved settings.
    function Hub.Config.Boot(config)
        local auto = Hub.Config.GetAutoLoad()
        if auto ~= "" then
            local ok, applied = Hub.Config.Load(auto)
            if ok then
                Hub.Config.selected = auto
                return applied
            end
        end
        if type(config) == "table" and type(config.Values) == "table" then
            return Hub.Config.Apply(config.Values)
        end
        return 0
    end

    -- Selectable list (StarHubUI has no list widget).
    local function MakeConfigList(box, height, onSelect)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, height)
        holder.BackgroundColor3 = SHTheme.Box
        holder.BackgroundTransparency = 0.2
        holder.BorderSizePixel = 0
        holder.ClipsDescendants = true
        holder.Parent = box.Container
        Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)
        local stroke = Instance.new("UIStroke", holder)
        stroke.Color = SHTheme.Border

        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, -8, 1, -8)
        scroll.Position = UDim2.new(0, 4, 0, 4)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 2
        scroll.ScrollBarImageColor3 = SHTheme.Border
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.Parent = holder

        local layout = Instance.new("UIListLayout", scroll)
        layout.Padding = UDim.new(0, 4)
        layout.SortOrder = Enum.SortOrder.LayoutOrder

        local list = { rows = {}, order = {}, selected = "", onSelect = onSelect }

        local function Repaint()
            for name, row in pairs(list.rows) do
                local isSelected = (name == list.selected)
                row.Frame.BackgroundColor3 = isSelected and SHTheme.Accent or SHTheme.SubBox
                row.Frame.BackgroundTransparency = isSelected and 0.1 or 0.4
                row.Label.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or SHTheme.TextTitle
            end
        end

        function list:SetSelected(name)
            self.selected = name or ""
            Repaint()
        end

        function list:SetItems(names, autoName)
            for _, row in pairs(self.rows) do
                row.Frame:Destroy()
            end
            self.rows = {}
            self.order = {}
            if self.empty then
                self.empty:Destroy()
                self.empty = nil
            end

            if #names == 0 then
                local empty = Instance.new("TextLabel")
                empty.Size = UDim2.new(1, 0, 0, 34)
                empty.BackgroundTransparency = 1
                empty.Font = Enum.Font.Gotham
                empty.TextSize = 10
                empty.TextColor3 = SHTheme.TextDim
                empty.TextXAlignment = Enum.TextXAlignment.Center
                empty.Text = "No configs yet - type a name and press Create Config"
                empty.Parent = scroll
                self.empty = empty
                return
            end

            for index, name in ipairs(names) do
                local row = Instance.new("TextButton")
                row.Size = UDim2.new(1, 0, 0, 30)
                row.BackgroundColor3 = SHTheme.SubBox
                row.BackgroundTransparency = 0.4
                row.BorderSizePixel = 0
                row.Text = ""
                row.AutoButtonColor = false
                row.LayoutOrder = index
                row.Parent = scroll
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -72, 1, 0)
                label.Position = UDim2.new(0, 10, 0, 0)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamMedium
                label.TextSize = 10.5
                label.TextColor3 = SHTheme.TextTitle
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.TextTruncate = Enum.TextTruncate.AtEnd
                label.Text = name
                label.Parent = row

                local badge = Instance.new("TextLabel")
                badge.Size = UDim2.new(0, 58, 1, 0)
                badge.Position = UDim2.new(1, -62, 0, 0)
                badge.BackgroundTransparency = 1
                badge.Font = Enum.Font.GothamBold
                badge.TextSize = 8.5
                badge.TextColor3 = SHTheme.Accent
                badge.TextXAlignment = Enum.TextXAlignment.Right
                badge.Text = (name == autoName) and "AUTO" or ""
                badge.Parent = row

                row.MouseButton1Click:Connect(function()
                    self.selected = name
                    Repaint()
                    if type(self.onSelect) == "function" then
                        pcall(self.onSelect, name)
                    end
                end)

                self.rows[name] = { Frame = row, Label = label, Badge = badge }
                self.order[#self.order + 1] = name
            end

            Repaint()
        end

        return list
    end

    local ConfigTab = Window:CreateTab({
        Title = "Configs",
        IconId = StarHubUI.Icons.Save,
        LayoutOrder = 14,
    })

    local SlotBox = ConfigTab:CreateGroupBox("Left", "Saved Configs", "SLOTS", StarHubUI.Icons.Save)
    local nameInput = SlotBox:AddInput("Name", "Example: Main", "", function() end)

    local UpdateRows
    local list

    local function ReadName(required)
        local name = tostring(nameInput.Text or ""):match("^%s*(.-)%s*$")
        if #name == 0 then
            if required then
                Notify("Config Name", "Type a name first.")
            end
            return nil
        end
        if #name > 32 or not name:match("^[%w _%-]+$") or name:match("^__") then
            Notify("Config Name", "Use 1-32 letters, numbers, spaces, _ or -.")
            return nil
        end
        return name
    end

    local function TargetName()
        if Hub.Config.selected ~= "" then
            return Hub.Config.selected
        end
        return ReadName(true)
    end

    SlotBox:AddActionRow("Create Config", "Saves the current settings under the name above", StarHubUI.Icons.Save, function()
        local name = ReadName(true)
        if not name then
            return
        end
        local ok, err = Hub.Config.Save(name)
        if ok then
            Hub.Config.selected = name
            nameInput.Text = name
            Notify("Config Created", string.format("'%s' now holds %d settings.", name, Hub.Config.Count()))
        else
            Notify("Create Failed", tostring(err))
        end
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end)

    list = MakeConfigList(SlotBox, 152, function(name)
        Hub.Config.selected = name
        nameInput.Text = name
        if UpdateRows then
            UpdateRows()
        end
    end)

    SlotBox:AddActionRow("Save Config", "Overwrites the selected config with the current settings", StarHubUI.Icons.Copy, function()
        local name = TargetName()
        if not name then
            return
        end
        local ok, err = Hub.Config.Save(name)
        if ok then
            Hub.Config.selected = name
            Notify("Config Saved", string.format("'%s' updated with %d settings.", name, Hub.Config.Count()))
        else
            Notify("Save Failed", tostring(err))
        end
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end)

    SlotBox:AddActionRow("Load Config", "Applies the selected config and repaints the menu", StarHubUI.Icons.Refresh, function()
        local name = TargetName()
        if not name then
            return
        end
        local ok, applied = Hub.Config.Load(name)
        if ok then
            Notify("Config Loaded", string.format("'%s': %s settings applied.", name, tostring(applied)))
        else
            Notify("Load Failed", tostring(applied))
        end
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end)

    SlotBox:AddActionRow("Delete Config", "Removes the selected config from the list", StarHubUI.Icons.Skull, function()
        local name = TargetName()
        if not name then
            return
        end
        local ok, err = Hub.Config.Delete(name)
        if ok then
            Notify("Config Deleted", string.format("Deleted '%s'.", name))
        else
            Notify("Delete Failed", tostring(err))
        end
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end)

    SlotBox:AddActionRow("Refresh Config List", "Re-reads the config file from disk", StarHubUI.Icons.Refresh, function()
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end)

    SlotBox:AddActionRow("Set Auto Load Config", "Marks the selected config to load on every launch", StarHubUI.Icons.Check, function()
        local name = TargetName()
        if not name then
            return
        end
        local current = Hub.Config.GetAutoLoad()
        local target = (current == name) and "" or name
        if Hub.Config.SetAutoLoad(target) then
            Notify("Auto Load", target ~= "" and ("'" .. target .. "' will load on every launch.") or "Auto load disabled.")
        else
            Notify("Auto Load", "The config file could not be written.")
        end
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end)

    local countRow = MakeInfoRow(SlotBox, "Saved configs: 0", "none yet", StarHubUI.Icons.Info)
    local selectedRow = MakeInfoRow(SlotBox, "Selected: none", "Pick a config in the list", StarHubUI.Icons.Dashboard)
    local autoRow = MakeInfoRow(SlotBox, "Auto load: off", "Select a config and press Set Auto Load", StarHubUI.Icons.Check)

    UpdateRows = function()
        local names = Hub.Config.Names()
        countRow:SetTitle(string.format("Saved configs: %d", #names))
        countRow:SetDesc(#names > 0 and table.concat(names, ", ") or "none yet")
        selectedRow:SetTitle("Selected: " .. (Hub.Config.selected ~= "" and Hub.Config.selected or "none"))
        selectedRow:SetDesc(Hub.Config.active ~= "" and ("Active: " .. Hub.Config.active) or "Load a config to make it active")
        local auto = Hub.Config.GetAutoLoad()
        autoRow:SetTitle("Auto load: " .. (auto ~= "" and auto or "off"))
        autoRow:SetDesc(auto ~= "" and "Applied automatically on every launch" or "Select a config and press Set Auto Load")
    end

    local function RefreshList()
        list:SetItems(Hub.Config.Names(), Hub.Config.GetAutoLoad())
        list:SetSelected(Hub.Config.selected)
        UpdateRows()
    end

    local CurrentBox = ConfigTab:CreateGroupBox("Right", "Current Settings", "LIVE", StarHubUI.Icons.Dashboard)
    local trackedRow = MakeInfoRow(CurrentBox, "Tracked: 0 settings", "Everything on every tab", StarHubUI.Icons.Info)
    CurrentBox:AddActionRow("Save Now", "Writes the current settings to HubConfig.json", StarHubUI.Icons.Save, function()
        SaveConfig()
        Notify("Settings Saved", string.format("%d settings written to HubConfig.json.", Hub.Config.Count()))
    end)
    CurrentBox:AddActionRow("Reload Last Saved", "Re-applies the settings from HubConfig.json", StarHubUI.Icons.Refresh, function()
        local config = ReadConfig()
        local applied = Hub.Config.Apply(type(config) == "table" and config.Values or nil)
        Notify("Settings Reloaded", string.format("%d settings restored.", applied))
        RefreshList()
    end)
    CurrentBox:AddActionRow("Open Config Folder", "Shows where the config files are stored", StarHubUI.Icons.Info, function()
        Notify("Config Files", NamedConfigFile .. " and " .. ConfigFile)
    end)

    trackedRow:SetTitle(string.format("Tracked: %d settings", Hub.Config.Count()))
    RefreshList()
    Hub.Config.Refresh = RefreshList
end

