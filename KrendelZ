                        local w = Track.AbsoluteSize.X
                        local rel = math.clamp(inp.Position.X - Track.AbsolutePosition.X, 0, w)
                        SetVal(math.floor(minVal + (maxVal - minVal) * (rel / w)))
                    end
                end)
                return { Set = SetVal, Get = function() return currentVal end }
            end

