    }

    function FFlags.presetJson(which)
        local source = string.lower(tostring(which or "")):find("android")
            and FFlagPresetAndroid
            or FFlagPresetDesktop
        local ok, encoded = pcall(function()
            return HttpService:JSONEncode(source)
        end)
        return ok and encoded or "{}"
    end

    local function FFlagCountKeys(map)
        local total = 0
        for _ in pairs(map) do
            total = total + 1
        end
        return total
    end

    function FFlags.presetCount(which)
        local source = string.lower(tostring(which or "")):find("android")
            and FFlagPresetAndroid
            or FFlagPresetDesktop
        return FFlagCountKeys(source)
    end

    function FFlags.readPresets()
        if type(readfile) ~= "function" then
            return {}
        end
        if type(isfile) == "function" and not isfile(FFlagPresetFile) then
            return {}
        end
        local ok, content = pcall(readfile, FFlagPresetFile)
        if not ok then
            return {}
        end
        local decoded, data = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if decoded and type(data) == "table" then
            return data
        end
        return {}
    end

    function FFlags.writePresets(map)
        if type(writefile) ~= "function" then
            return false
        end
        local ok, result = pcall(writefile, FFlagPresetFile, HttpService:JSONEncode(map))
        return ok and result ~= false
    end

    function FFlags.presetNames()
        local names = {}
        for name in pairs(FFlags.readPresets()) do
            names[#names + 1] = tostring(name)
        end
        table.sort(names)
        return names
    end

    function FFlags.runStartupAutoApply()
        if FFlags.autoAttempted then
            return
        end
        local snapshot = FFlags.getSnapshot()
        if not snapshot or not snapshot.enabled then
            return
        end
        FFlags.autoAttempted = true
        if snapshot.pending then
            local ok = FFlags.quarantineInterruptedStartup()
            FFlagReport(ok
                and "Auto apply was disabled because the previous startup did not reach its checkpoint. The snapshot was kept."
                or "The interrupted FFlag startup could not be quarantined.")
            return
        end
        if not snapshot.valid then
            FFlagReport("The saved FFlag snapshot is invalid; the hub continued loading.")
            return
        end
        local token = FFlags.beginStartupAttempt(snapshot.payload)
        if not token then
            FFlagReport("Crash-loop protection could not be armed. Auto apply was skipped.")
            return
        end
        local ok, result = pcall(FFlags.applyPayload, snapshot.payload, { automatic = true })
        if not ok then
            FFlags.busy = false
            FFlagReport("Auto apply stopped safely; the hub continued loading.")
            return
        end
        if result and not result.cancelled then
            FFlagReport(string.format("Auto-applied %d of %d flags.", result.applied, result.total))
        end
        task.delay(15, function()
            if State.Running then
                FFlags.completeStartupAttempt(token)
            end
        end)
    end

    Hub.FFlags = FFlags

    -- Fullbright ---------------------------------------------------------------
    local Fullbright = {
        active = false,
        stored = nil,
    }

    local function FullbrightColor(list, fallback)
        if type(list) ~= "table" then
            return fallback
        end
        return Color3.fromRGB(
            math.clamp(tonumber(list[1]) or 255, 0, 255),
            math.clamp(tonumber(list[2]) or 255, 0, 255),
            math.clamp(tonumber(list[3]) or 255, 0, 255)
        )
    end

    local function FullbrightStore()
        local effects = {}
        for _, child in ipairs(LightingService:GetChildren()) do
            if child:IsA("Atmosphere") then
                effects[#effects + 1] = { object = child, property = "Density", value = child.Density, off = 0 }
            elseif child:IsA("PostEffect") then
                effects[#effects + 1] = { object = child, property = "Enabled", value = child.Enabled, off = false }
            elseif child:IsA("Clouds") then
                effects[#effects + 1] = { object = child, property = "Enabled", value = child.Enabled, off = false }
            end
        end
        Fullbright.stored = {
            Brightness = LightingService.Brightness,
            Ambient = LightingService.Ambient,
            OutdoorAmbient = LightingService.OutdoorAmbient,
            FogStart = LightingService.FogStart,
            FogEnd = LightingService.FogEnd,
            ClockTime = LightingService.ClockTime,
            GlobalShadows = LightingService.GlobalShadows,
            ExposureCompensation = LightingService.ExposureCompensation,
            Effects = effects,
        }
    end

    function Fullbright.apply()
        if not Fullbright.stored then
            FullbrightStore()
        end
        local stored = Fullbright.stored
        pcall(function()
            LightingService.Brightness = math.clamp(tonumber(State.FullbrightBrightness) or 3, 0, 10)
            LightingService.Ambient = FullbrightColor(State.FullbrightAmbient, Color3.fromRGB(200, 200, 200))
            LightingService.OutdoorAmbient = FullbrightColor(State.FullbrightOutdoor, Color3.fromRGB(200, 200, 200))
            LightingService.ClockTime = math.clamp(tonumber(State.FullbrightClock) or 14, 0, 24)
            LightingService.GlobalShadows = State.FullbrightShadows == true
            LightingService.ExposureCompensation = math.clamp(tonumber(State.FullbrightExposure) or 0, -3, 3)
            if State.FullbrightFog then
                LightingService.FogStart = 0
                LightingService.FogEnd = math.clamp(tonumber(State.FullbrightFogEnd) or 100000, 1000, 100000)
            else
                LightingService.FogStart = stored.FogStart
                LightingService.FogEnd = stored.FogEnd
            end
        end)
        for _, effect in ipairs(stored.Effects) do
            if effect.object and effect.object.Parent then
                if State.FullbrightNoAtmosphere and effect.property == "Density" then
                    pcall(function()
                        effect.object.Density = effect.off
                    end)
                elseif State.FullbrightNoPost and effect.property == "Enabled" then
                    pcall(function()
                        effect.object.Enabled = effect.off
                    end)
                else
                    pcall(function()
                        effect.object[effect.property] = effect.value
                    end)
                end
            end
        end
        Fullbright.active = true
    end

    function Fullbright.restore()
        local stored = Fullbright.stored
        if not stored then
            Fullbright.active = false
            return
        end
        pcall(function()
            LightingService.Brightness = stored.Brightness
            LightingService.Ambient = stored.Ambient
            LightingService.OutdoorAmbient = stored.OutdoorAmbient
            LightingService.FogStart = stored.FogStart
            LightingService.FogEnd = stored.FogEnd
            LightingService.ClockTime = stored.ClockTime
            LightingService.GlobalShadows = stored.GlobalShadows
            LightingService.ExposureCompensation = stored.ExposureCompensation
        end)
        for _, effect in ipairs(stored.Effects) do
            if effect.object and effect.object.Parent then
                pcall(function()
                    effect.object[effect.property] = effect.value
                end)
            end
        end
        Fullbright.active = false
    end

    function Fullbright.setEnabled(enabled)
        if enabled then
            Fullbright.apply()
        else
            Fullbright.restore()
        end
    end

    function Fullbright.refresh()
        if Fullbright.active then
            Fullbright.apply()
        end
    end

    function Fullbright.reset()
        State.Fullbright = false
        State.FullbrightBrightness = 3
        State.FullbrightAmbient = { 200, 200, 200 }
        State.FullbrightOutdoor = { 200, 200, 200 }
        State.FullbrightClock = 14
        State.FullbrightFog = true
        State.FullbrightFogEnd = 100000
        State.FullbrightShadows = false
        State.FullbrightExposure = 0
        State.FullbrightNoAtmosphere = true
        State.FullbrightNoPost = true
        Fullbright.restore()
    end

    Hub.Fullbright = Fullbright

    -- Applies a saved snapshot once the hub is up (crash-loop protected).
    task.delay(2, function()
        if State.Running then
            pcall(FFlags.runStartupAutoApply)
        end
    end)
end

