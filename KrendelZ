-- Farm module: auto door + crystal ---------------------------------------------

local Farm = {
    DoorRunning = false,
    DoorVisited = {},
    DoorNextAt = 0,
    DoorCursor = 1,
    DoorCurrent = nil,
    DoorCount = 0,
    DoorMessage = "Idle",
    AllDoorsCooling = false,
    AllDoorsCoolingAt = 0,
    DoorCooldownHit = false,
    DoorCooldownHitAt = 0,
    LastToastAt = 0,
    DoorGen = 0,
    CrystalGen = 0,
    CrystalRunning = false,
    CrystalVisited = {},
    CrystalNextAt = 0,
    CrystalCursor = 1,
    CrystalCurrent = nil,
    CrystalCount = 0,
    CrystalMessage = "Idle",
    AntiAfkConnection = nil,
    Message = "Idle",
}

local FarmStatusListener = nil

local function FarmReport(text)
    Farm.Message = tostring(text)
    if type(FarmStatusListener) == "function" then
        pcall(FarmStatusListener, Farm.Message)
    end
end

local function FarmReportFor(channel, text)
    if channel == "door" then
        Farm.DoorMessage = tostring(text)
    elseif channel == "crystal" then
        Farm.CrystalMessage = tostring(text)
    end
    FarmReport(text)
end

local function FarmRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function FarmTeleport(part, height)
    local root = FarmRoot()
    if not root or not part then
        return false
    end
    root.CFrame = part.CFrame * CFrame.new(0, height or 4, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

-- Doors: land UNDER the door part, at its lower edge, instead of on top of it.
-- On top the character stands on the door, the prompt sits behind the surface
-- and the hit usually bounces off. At the bottom edge the root is in the
-- doorway itself, which is where the prompt actually accepts a hit.
-- The offset is world-space: door parts are often rotated, so a local Y offset
-- would push the character sideways.
-- Never go below the bottom edge - with noclip on the character would simply
-- fall through the floor and into the void.
--
-- Everything is tunable from the UI now:
--   State.DoorOffsetX / Y / Z - studs added on top of the anchor point,
--                               Y counts up from the door's bottom edge
--   State.DoorPose            - stand / lie on back / front / left / right
--   State.DoorFaceAway        - flip 180 degrees, which side faces the door
--
-- Poses are rotations applied in the character's own frame after it has been
-- turned towards the door: pitch tips the body backwards/forwards (X axis),
-- roll tips it sideways (Z axis). Table lives on Farm, not in a local - the
-- main chunk is already at 192 of the 200 allowed locals.
Farm.Poses = {
    ["Stand"] = { pitch = 0, roll = 0 },
    ["Lie on back"] = { pitch = -math.pi / 2, roll = 0 },
    ["Lie on front"] = { pitch = math.pi / 2, roll = 0 },
    ["Lie on left side"] = { pitch = 0, roll = math.pi / 2 },
    ["Lie on right side"] = { pitch = 0, roll = -math.pi / 2 },
    ["Head down"] = { pitch = math.pi, roll = 0 },
}

function Farm.TeleportUnder(part, gap)
    local root = FarmRoot()
    if not root or not part then
        return false
    end

    local lift = tonumber(gap) or tonumber(State.DoorOffsetY) or 2
    local offsetX = tonumber(State.DoorOffsetX) or 0
    local offsetZ = tonumber(State.DoorOffsetZ) or 0

    local half = 0
    pcall(function()
        half = part.Size.Y * 0.5
    end)
    if not half or half ~= half or half <= 0 then
        half = 3
    end

    local position = Vector3.new(
        part.Position.X + offsetX,
        part.Position.Y - half + lift,
        part.Position.Z + offsetZ
    )

    -- Horizontal direction the door faces. Flattened, because a door part can be
    -- tilted and we never want the character nose-down into the floor.
    local direction = nil
    pcall(function()
        local look = part.CFrame.LookVector
        direction = Vector3.new(look.X, 0, look.Z)
        if direction.Magnitude < 0.01 then
            direction = Vector3.new(0, 0, -1)
        end
        direction = direction.Unit
    end)
    if not direction then
        direction = Vector3.new(0, 0, -1)
    end
    if State.DoorFaceAway then
        direction = -direction
    end

    local pose = Farm.Poses[State.DoorPose] or Farm.Poses["Stand"]
    root.CFrame = CFrame.lookAt(position, position + direction)
        * CFrame.Angles(pose.pitch, 0, pose.roll)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

--==========================================================================
-- Noclip for the door farm
-- Switched on the moment the farm starts, restored the moment it stops.
--
-- Noclip alone is not enough here: with CanCollide = false nothing holds the
-- character up any more, so right after the teleport it starts falling through
-- the map and ends up in the void. The root is therefore anchored for the whole
-- farm - the teleports keep working (CFrame is written directly) and the
-- character simply hovers where it was put instead of sinking.
--==========================================================================

Farm.NoclipActive = false
Farm.NoclipOriginal = {}
Farm.NoclipParts = {}
Farm.NoclipCharacter = nil
Farm.NoclipRoot = nil
Farm.NoclipConnection = nil
Farm.NoclipAdded = nil

-- RunService выше объявлен ВНУТРИ модуля StarHubUI и снаружи не виден, поэтому
-- сервис берётся прямо здесь. Всё ниже живёт полями Farm: у чанка хаба уже 192
-- локальные переменные, а лимит Lua/Luau - 200 на функцию. Ещё пять local и
-- скрипт перестаёт компилироваться целиком ("too many local variables").
function Farm.NoclipCollect(character)
    local list = {}
    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("BasePart") then
            list[#list + 1] = item
            if Farm.NoclipOriginal[item] == nil then
                Farm.NoclipOriginal[item] = item.CanCollide
            end
            item.CanCollide = false
        end
    end
    Farm.NoclipParts = list
    -- Hold the character exactly where the teleport put it.
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        Farm.NoclipRoot = root
        pcall(function()
            root.Anchored = true
        end)
    end
end

function Farm.NoclipBind(character)
    if Farm.NoclipAdded then
        pcall(function()
            Farm.NoclipAdded:Disconnect()
        end)
        Farm.NoclipAdded = nil
    end
    Farm.NoclipCharacter = character
    Farm.NoclipCollect(character)
    Farm.NoclipAdded = character.DescendantAdded:Connect(function(item)
        if not Farm.NoclipActive then
            return
        end
        if not item:IsA("BasePart") then
            return
        end
        if Farm.NoclipOriginal[item] == nil then
            Farm.NoclipOriginal[item] = item.CanCollide
        end
        item.CanCollide = false
        table.insert(Farm.NoclipParts, item)
    end)
end

function Farm.NoclipEnforce()
    if not Farm.NoclipActive then
        return
    end
    local character = LocalPlayer.Character
    if not character then
        return
    end
    if Farm.NoclipCharacter ~= character then
        Farm.NoclipBind(character)
        return
    end
    for _, part in ipairs(Farm.NoclipParts) do
        if part.Parent and part.CanCollide then
            if Farm.NoclipOriginal[part] == nil then
                Farm.NoclipOriginal[part] = true
            end
            part.CanCollide = false
        end
    end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        Farm.NoclipRoot = root
        if not root.Anchored then
            pcall(function()
                root.Anchored = true
            end)
        end
    end
end

function Farm.SetNoclip(on)
    if on then
        if Farm.NoclipActive then
            return
        end
        Farm.NoclipActive = true
        local character = LocalPlayer.Character
        if character then
            Farm.NoclipBind(character)
        end
        if not Farm.NoclipConnection then
            Farm.NoclipConnection = game:GetService("RunService").Heartbeat:Connect(Farm.NoclipEnforce)
        end
    else
        Farm.NoclipActive = false
        if Farm.NoclipConnection then
            pcall(function()
                Farm.NoclipConnection:Disconnect()
            end)
            Farm.NoclipConnection = nil
        end
        if Farm.NoclipAdded then
            pcall(function()
                Farm.NoclipAdded:Disconnect()
            end)
            Farm.NoclipAdded = nil
        end
        for part, value in pairs(Farm.NoclipOriginal) do
            if part.Parent then
                pcall(function()
                    part.CanCollide = value
                end)
            end
        end
        -- Release the hold, otherwise the character stays frozen after stopping.
        local roots = {}
        if Farm.NoclipRoot then
            roots[#roots + 1] = Farm.NoclipRoot
        end
        local character = LocalPlayer.Character
        local liveRoot = character and character:FindFirstChild("HumanoidRootPart")
        if liveRoot and liveRoot ~= Farm.NoclipRoot then
            roots[#roots + 1] = liveRoot
        end
        for _, root in ipairs(roots) do
            if root and root.Parent then
                pcall(function()
                    root.Anchored = false
                end)
            end
        end
        Farm.NoclipRoot = nil
        Farm.NoclipOriginal = {}
        Farm.NoclipParts = {}
        Farm.NoclipCharacter = nil
    end
end

--==========================================================================
-- Мгновенные промпты
-- HoldDuration = 0 убирает полоску удержания: InputHoldBegin и InputHoldEnd
-- уходят в одном кадре. Это ровно та же активация, что игрок делает руками,
-- просто без задержки - сервер разницы не видит.
-- Фоновый проход раз в полсекунды возвращает значение, если игра его вернёт.
--==========================================================================

Farm.InstantActive = false

function Farm.InstantApply()
    for _, item in ipairs(Farm.PromptList()) do
        local prompt = item.Prompt
        if prompt and prompt.Parent then
            if (prompt.HoldDuration or 0) > 0 then
                pcall(function()
                    prompt.HoldDuration = 0
                end)
            end
            if prompt.RequiresLineOfSight then
                pcall(function()
                    prompt.RequiresLineOfSight = false
                end)
            end
        end
    end
end

function Farm.SetInstant(on)
    if on then
        Farm.InstantActive = true
        Farm.InstantApply()
        task.spawn(function()
            while Farm.InstantActive do
                Farm.InstantApply()
                task.wait(0.5)
            end
        end)
    else
        Farm.InstantActive = false
    end
end

--==========================================================================
-- Промпты: дистанция обычная, но стены и игроки больше не перекрывают
-- взаимодействие. MaxActivationDistance не трогаем - достаём ровно настолько,
-- насколько разрешил разработчик. Трогаем только RequiresLineOfSight и сразу
-- возвращаем его назад, чтобы в мире ничего не осталось изменённым.
--==========================================================================

function Farm.PromptReach(prompt)
    local reach = tonumber(prompt.MaxActivationDistance)
    if not reach or reach <= 0 then
        return 10
    end
    return reach
end

function Farm.TriggerPrompt(prompt)
    local instant = State.DoorInstant ~= false
    local previous = prompt.RequiresLineOfSight
    pcall(function()
        prompt.RequiresLineOfSight = false
    end)
    local held = pcall(function()
        prompt:InputHoldBegin()
    end)
    if held then
        local hold = prompt.HoldDuration
        if instant then
            -- Мгновенный режим: удержание не нужно вообще, Begin и End в одном
            -- кадре. Сервер видит ровно ту же активацию, что и от руки.
            hold = 0
        elseif type(hold) ~= "number" or hold <= 0 then
            hold = 0.15
        end
        if hold > 0 then
            task.wait(hold + 0.05)
        end
        pcall(function()
            prompt:InputHoldEnd()
        end)
        if not instant then
            task.wait(0.05)
        end
    elseif type(fireproximityprompt) == "function" then
        -- InputHoldBegin в этом исполнителе не сработал. Идём через хелпер, но
        -- только потому, что дистанцию до промпта мы уже проверили сами.
        held = pcall(fireproximityprompt, prompt)
    end
    pcall(function()
        prompt.RequiresLineOfSight = previous
    end)
    return held
end

local function FarmInteract(target)
    local root = FarmRoot()
    local origin = root and root.Position or nil

    local prompts = {}
    local detectors = {}
    for _, obj in ipairs(target:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            prompts[#prompts + 1] = obj
        elseif obj:IsA("ClickDetector") then
            detectors[#detectors + 1] = obj
        end
    end

    for _, prompt in ipairs(prompts) do
        if prompt.Enabled and Farm.TriggerPrompt(prompt) then
            return true
        end
    end

    for _, detector in ipairs(detectors) do
        -- Клик разрешён, только если реально стоим в радиусе детектора.
        local part = detector.Parent
        local guard = 0
        while part and not part:IsA("BasePart") and guard < 8 do
            guard = guard + 1
            part = part.Parent
        end
        local reach = tonumber(detector.MaxActivationDistance) or 32
        local inRange = true
        if origin and part and part:IsA("BasePart") then
            inRange = (part.Position - origin).Magnitude <= reach
        end
        if inRange and type(fireclickdetector) == "function" then
            if pcall(fireclickdetector, detector) then
                return true
            end
        end
    end

    return false
end

local FARM_NAME_MAX = 50

-- Natural order: "door", "door1", "door2" ... "door10" (never "door1, door10, door2").
local function FarmNameKey(name)
    local lower = string.lower(tostring(name or ""))
    local base, digits = string.match(lower, "^(.-)(%d*)$")
    if not base or base == "" then
        return lower, 0
    end
    return base, tonumber(digits) or 0
end

local function FarmSort(list)
    table.sort(list, function(a, b)
        local baseA, numA = FarmNameKey(a.Name)
        local baseB, numB = FarmNameKey(b.Name)
        if baseA == baseB then
            if numA ~= numB then
                return numA < numB
            end
            return tostring(a.Name) < tostring(b.Name)
        end
        return baseA < baseB
    end)
    return list
end

-- Distance from Workspace; the shallowest object of a name is the real one.
local function FarmDepth(object)
    local depth = 0
    local parent = object.Parent
    local guard = 0
    while parent and parent ~= Workspace and guard < 64 do
        guard = guard + 1
        depth = depth + 1
        parent = parent.Parent
    end
    return depth
end

-- One entry per name. A model and its own part often share a name, and the map
-- may hold duplicate DoorN copies: keep the one closest to Workspace.
local function FarmDedupe(list)
    local best = {}
    local order = {}
    for _, item in ipairs(list) do
        local key = tostring(item.Name)
        local existing = best[key]
        if not existing then
            best[key] = item
            table.insert(order, key)
        elseif FarmDepth(item) < FarmDepth(existing) then
            best[key] = item
        end
    end
    local unique = {}
    for _, key in ipairs(order) do
        table.insert(unique, best[key])
    end
    return unique
end

-- Fixed names only. The strict pass accepts "door1" .. "door50"; the bare
-- "door" is used only as a fallback when the map has no numbered doors at all.
local function FarmMatches(name, base, allowBare)
    local lower = string.lower(tostring(name or ""))
    if allowBare and lower == base then
        return true
    end
    local suffix = string.match(lower, "^" .. base .. "(%d+)$")
    if suffix then
        local number = tonumber(suffix)
        if number and number >= 1 and number <= FARM_NAME_MAX then
            return true
        end
    end
    return false
end

-- A part inside a door model is often named like the door itself: never treat
-- a child of an already matched object as a separate door.
local function FarmNested(object, base, allowBare)
    local parent = object.Parent
    local guard = 0
    while parent and parent ~= Workspace and guard < 64 do
        guard = guard + 1
        if FarmMatches(parent.Name, base, allowBare) then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function FarmScan(base, allowBare)
    local found = {}
    local target = string.lower(tostring(base or ""))
    if target == "" then
        return found
    end
    local function consider(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then
            return
        end
        if not FarmMatches(obj.Name, target, allowBare) then
            return
        end
        if FarmNested(obj, target, allowBare) then
            return
        end
        table.insert(found, obj)
    end
    local scanned = pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            consider(obj)
        end
    end)
    if not scanned or #found == 0 then
        local function walk(node, depth)
            if not node or depth > 8 then
                return
            end
            for _, obj in ipairs(node:GetChildren()) do
                consider(obj)
                if obj:IsA("Model") or obj:IsA("Folder") then
                    walk(obj, depth + 1)
                end
            end
        end
        pcall(walk, Workspace, 0)
    end
    return found
end

-- Strict first: numbered entries only, so unrelated objects never get picked.
local function FarmCollect(base)
    local numbered = FarmSort(FarmDedupe(FarmScan(base, false)))
    if #numbered > 0 then
        return numbered
    end
    return FarmSort(FarmDedupe(FarmScan(base, true)))
end

local function FarmPartOf(object)
    if not object then
        return nil
    end
    if object:IsA("BasePart") then
        return object
    end
    if object.PrimaryPart then
        return object.PrimaryPart
    end
    for _, descendant in ipairs(object:GetDescendants()) do
        if descendant:IsA("BasePart") then
            return descendant
        end
    end
    return nil
end

-- Strict rotation: always the next entry of the sorted list, wrapping at the end.
-- Entries still on cooldown are skipped, so the walk never stalls on a dead door.
local function FarmNext(list, cursorField, visited, cooldown)
    local total = #list
    if total == 0 then
        return nil, 0, 0, 0
    end
    local cursor = tonumber(Farm[cursorField]) or 1
    if cursor < 1 or cursor > total then
        cursor = 1
    end
    local now = tick()
    local soonest = nil
    for step = 0, total - 1 do
        local index = ((cursor - 1 + step) % total) + 1
        local item = list[index]
        local last = visited[tostring(item.Name)] or 0
        local remaining = cooldown - (now - last)
        if remaining <= 0 then
            Farm[cursorField] = (index % total) + 1
            return item, index, total, 0
        end
        if not soonest or remaining < soonest then
            soonest = remaining
        end
    end
    Farm[cursorField] = cursor
    return nil, cursor, total, soonest or 0
end

