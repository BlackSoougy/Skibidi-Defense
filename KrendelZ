-- Farm module: auto door + crystal ---------------------------------------------

local Farm = {
    DoorRunning = false,
    DoorVisited = {},
    DoorNextAt = 0,
    DoorCursor = 1,
    DoorCurrent = nil,
    DoorCount = 0,
    DoorMessage = "Idle",
    AllDoorsCooling = false,
    AllDoorsCoolingAt = 0,
    DoorCooldownHit = false,
    DoorCooldownHitAt = 0,
    DoorGen = 0,
    CrystalGen = 0,
    CrystalRunning = false,
    CrystalVisited = {},
    CrystalNextAt = 0,
    CrystalCursor = 1,
    CrystalCurrent = nil,
    CrystalCount = 0,
    CrystalMessage = "Idle",
    AntiAfkConnection = nil,
    Message = "Idle",
}

local FarmStatusListener = nil

local function FarmReport(text)
    Farm.Message = tostring(text)
    if type(FarmStatusListener) == "function" then
        pcall(FarmStatusListener, Farm.Message)
    end
end

local function FarmReportFor(channel, text)
    if channel == "door" then
        Farm.DoorMessage = tostring(text)
    elseif channel == "crystal" then
        Farm.CrystalMessage = tostring(text)
    end
    FarmReport(text)
end

local function FarmRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function FarmTeleport(part, height)
    local root = FarmRoot()
    if not root or not part then
        return false
    end
    root.CFrame = part.CFrame * CFrame.new(0, height or 4, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function FarmInteract(target)
    for _, obj in ipairs(target:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            pcall(function()
                fireproximityprompt(obj)
            end)
            return true
        end
    end
    for _, obj in ipairs(target:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            pcall(function()
                fireclickdetector(obj)
            end)
            return true
        end
    end
    pcall(function()
        local virtualInput = game:GetService("VirtualInputManager")
        virtualInput:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        virtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    return false
end

local FARM_NAME_MAX = 50

-- Natural order: "door", "door1", "door2" ... "door10" (never "door1, door10, door2").
local function FarmNameKey(name)
    local lower = string.lower(tostring(name or ""))
    local base, digits = string.match(lower, "^(.-)(%d*)$")
    if not base or base == "" then
        return lower, 0
    end
    return base, tonumber(digits) or 0
end

local function FarmSort(list)
    table.sort(list, function(a, b)
        local baseA, numA = FarmNameKey(a.Name)
        local baseB, numB = FarmNameKey(b.Name)
        if baseA == baseB then
            if numA ~= numB then
                return numA < numB
            end
            return tostring(a.Name) < tostring(b.Name)
        end
        return baseA < baseB
    end)
    return list
end

-- Distance from Workspace; the shallowest object of a name is the real one.
local function FarmDepth(object)
    local depth = 0
    local parent = object.Parent
    local guard = 0
    while parent and parent ~= Workspace and guard < 64 do
        guard = guard + 1
        depth = depth + 1
        parent = parent.Parent
    end
    return depth
end

-- One entry per name. A model and its own part often share a name, and the map
-- may hold duplicate DoorN copies: keep the one closest to Workspace.
local function FarmDedupe(list)
    local best = {}
    local order = {}
    for _, item in ipairs(list) do
        local key = tostring(item.Name)
        local existing = best[key]
        if not existing then
            best[key] = item
            table.insert(order, key)
        elseif FarmDepth(item) < FarmDepth(existing) then
            best[key] = item
        end
    end
    local unique = {}
    for _, key in ipairs(order) do
        table.insert(unique, best[key])
    end
    return unique
end

-- Fixed names only. The strict pass accepts "door1" .. "door50"; the bare
-- "door" is used only as a fallback when the map has no numbered doors at all.
local function FarmMatches(name, base, allowBare)
    local lower = string.lower(tostring(name or ""))
    if allowBare and lower == base then
        return true
    end
    local suffix = string.match(lower, "^" .. base .. "(%d+)$")
    if suffix then
        local number = tonumber(suffix)
        if number and number >= 1 and number <= FARM_NAME_MAX then
            return true
        end
    end
    return false
end

-- A part inside a door model is often named like the door itself: never treat
-- a child of an already matched object as a separate door.
local function FarmNested(object, base, allowBare)
    local parent = object.Parent
    local guard = 0
    while parent and parent ~= Workspace and guard < 64 do
        guard = guard + 1
        if FarmMatches(parent.Name, base, allowBare) then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function FarmScan(base, allowBare)
    local found = {}
    local target = string.lower(tostring(base or ""))
    if target == "" then
        return found
    end
    local function consider(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then
            return
        end
        if not FarmMatches(obj.Name, target, allowBare) then
            return
        end
        if FarmNested(obj, target, allowBare) then
            return
        end
        table.insert(found, obj)
    end
    local scanned = pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            consider(obj)
        end
    end)
    if not scanned or #found == 0 then
        local function walk(node, depth)
            if not node or depth > 8 then
                return
            end
            for _, obj in ipairs(node:GetChildren()) do
                consider(obj)
                if obj:IsA("Model") or obj:IsA("Folder") then
                    walk(obj, depth + 1)
                end
            end
        end
        pcall(walk, Workspace, 0)
    end
    return found
end

-- Strict first: numbered entries only, so unrelated objects never get picked.
local function FarmCollect(base)
    local numbered = FarmSort(FarmDedupe(FarmScan(base, false)))
    if #numbered > 0 then
        return numbered
    end
    return FarmSort(FarmDedupe(FarmScan(base, true)))
end

local function FarmPartOf(object)
    if not object then
        return nil
    end
    if object:IsA("BasePart") then
        return object
    end
    if object.PrimaryPart then
        return object.PrimaryPart
    end
    for _, descendant in ipairs(object:GetDescendants()) do
        if descendant:IsA("BasePart") then
            return descendant
        end
    end
    return nil
end

-- Strict rotation: always the next entry of the sorted list, wrapping at the end.
-- Entries still on cooldown are skipped, so the walk never stalls on a dead door.
local function FarmNext(list, cursorField, visited, cooldown)
    local total = #list
    if total == 0 then
        return nil, 0, 0, 0
    end
    local cursor = tonumber(Farm[cursorField]) or 1
    if cursor < 1 or cursor > total then
        cursor = 1
    end
    local now = tick()
    local soonest = nil
    for step = 0, total - 1 do
        local index = ((cursor - 1 + step) % total) + 1
        local item = list[index]
        local last = visited[tostring(item.Name)] or 0
        local remaining = cooldown - (now - last)
        if remaining <= 0 then
            Farm[cursorField] = (index % total) + 1
            return item, index, total, 0
        end
        if not soonest or remaining < soonest then
            soonest = remaining
        end
    end
    Farm[cursorField] = cursor
    return nil, cursor, total, soonest or 0
end

local function DoorLoop(gen)
    while Farm.DoorRunning and Farm.DoorGen == gen do
        task.wait(0.25)
        local now = tick()
        if now >= Farm.DoorNextAt then
            local doors = FarmCollect("door")
            Farm.DoorCount = #doors
            if #doors == 0 then
                FarmReportFor("door", "no doors found")
                Farm.DoorNextAt = now + 5
            else
                local chosen, index, total, waitFor = FarmNext(doors, "DoorCursor", Farm.DoorVisited, State.DoorCooldown)
                if not chosen then
                    FarmReportFor("door", "all " .. tostring(total) .. " doors on cooldown, next in "
                        .. tostring(math.ceil(waitFor or 10)) .. "s")
                    Farm.AllDoorsCooling = true
                    Farm.AllDoorsCoolingAt = now
                    Farm.DoorNextAt = now + math.min(math.max(waitFor or 10, 1), 60)
                else
                    Farm.DoorCurrent = chosen
                    Farm.AllDoorsCooling = false
                    FarmReportFor("door", "door " .. tostring(index) .. "/" .. tostring(total) .. " -> " .. tostring(chosen.Name))
                    local part = FarmPartOf(chosen)
                    if part and FarmTeleport(part, 4) then
                        task.wait(1.2)
                        FarmReportFor("door", "interacting -> " .. tostring(chosen.Name))
                        Farm.DoorCooldownHit = false
                        Farm.DoorCooldownHitAt = 0
                        FarmInteract(chosen)
                        -- Wait for the server answer. The cooldown toast means this door
                        -- is dead, so hop to the next one instead of idling on it.
                        local waited = 0
                        while waited < 1.5 and not Farm.DoorCooldownHit and Farm.DoorRunning do
                            task.wait(0.1)
                            waited = waited + 0.1
                        end
                        Farm.DoorVisited[tostring(chosen.Name)] = tick()
                        if Farm.DoorCooldownHit then
                            FarmReportFor("door", "cooldown -> skipping " .. tostring(chosen.Name))
                            Farm.DoorNextAt = 0
                        else
                            if Hub.Items and Hub.Items.NoteDoorOpened then
                                Hub.Items.NoteDoorOpened()
                            end
                            if Hub.Items and Hub.Items.NoteDoorOpenedReward then
                                Hub.Items.NoteDoorOpenedReward()
                            end
                            Farm.DoorNextAt = tick() + State.DoorInterval
                        end
                    else
                        FarmReportFor("door", "could not reach " .. tostring(chosen.Name))
                        -- retry this one in 5 seconds instead of skipping it for the whole cooldown
                        Farm.DoorVisited[tostring(chosen.Name)] = tick() - math.max(0, State.DoorCooldown - 5)
                        Farm.DoorNextAt = tick() + State.DoorInterval
                    end
                end
            end
        end
    end
end

local function CrystalLoop(gen)
    while Farm.CrystalRunning and Farm.CrystalGen == gen do
        task.wait(0.25)
        local now = tick()
        if now >= Farm.CrystalNextAt then
            local crystals = FarmCollect("crystal")
            Farm.CrystalCount = #crystals
            if #crystals == 0 then
                FarmReportFor("crystal", "no crystals found")
                Farm.CrystalNextAt = now + 5
            else
                local chosen, index, total, waitFor = FarmNext(crystals, "CrystalCursor", Farm.CrystalVisited, State.CrystalCooldown)
                if not chosen then
                    FarmReportFor("crystal", "all " .. tostring(total) .. " crystals on cooldown, next in "
                        .. tostring(math.ceil(waitFor or 10)) .. "s")
                    Farm.CrystalNextAt = now + math.min(math.max(waitFor or 10, 1), 60)
                else
                    Farm.CrystalCurrent = chosen
                    FarmReportFor("crystal", "crystal " .. tostring(index) .. "/" .. tostring(total) .. " -> " .. tostring(chosen.Name))
                    local part = FarmPartOf(chosen)
                    if part and FarmTeleport(part, 3) then
                        task.wait(0.8)
                        FarmInteract(chosen)
                        task.wait(0.5)
                        Farm.CrystalVisited[tostring(chosen.Name)] = tick()
                    else
                        FarmReportFor("crystal", "could not reach " .. tostring(chosen.Name))
                        Farm.CrystalVisited[tostring(chosen.Name)] = tick() - math.max(0, State.CrystalCooldown - 5)
                    end
                    Farm.CrystalNextAt = tick() + State.CrystalInterval
                end
            end
        end
    end
end

function Farm.StartDoor()
    if Farm.DoorRunning then
        return
    end
    Farm.DoorRunning = true
    Farm.DoorGen = (Farm.DoorGen or 0) + 1
    Farm.DoorNextAt = 0
    Farm.DoorCursor = 1
    FarmReportFor("door", "door farm running")
    local gen = Farm.DoorGen
    task.spawn(function()
        DoorLoop(gen)
    end)
end

function Farm.StopDoor()
    Farm.DoorRunning = false
    -- Bumping the generation kills every loop that is still inside a task.wait,
    -- including duplicates left behind by an earlier injection.
    Farm.DoorGen = (Farm.DoorGen or 0) + 1
    FarmReportFor("door", "door farm stopped")
end

function Farm.StartCrystal()
    if Farm.CrystalRunning then
        return
    end
    Farm.CrystalRunning = true
    Farm.CrystalGen = (Farm.CrystalGen or 0) + 1
    Farm.CrystalNextAt = 0
    Farm.CrystalCursor = 1
    FarmReportFor("crystal", "crystal farm running")
    local gen = Farm.CrystalGen
    task.spawn(function()
        CrystalLoop(gen)
    end)
end

function Farm.StopCrystal()
    Farm.CrystalRunning = false
    Farm.CrystalGen = (Farm.CrystalGen or 0) + 1
    FarmReportFor("crystal", "crystal farm stopped")
end

function Farm.SetAntiAfk(enabled)
    if enabled then
        if Farm.AntiAfkConnection then
            return
        end
        Farm.AntiAfkConnection = LocalPlayer.Idled:Connect(function()
            pcall(function()
                local virtualUser = game:GetService("VirtualUser")
                virtualUser:ClickButton2(Vector2.new(0, 0))
                virtualUser:CaptureController()
                virtualUser:Button2Down(Vector2.new(0, 0))
                task.wait(0.1)
                virtualUser:Button2Up(Vector2.new(0, 0))
            end)
        end)
    else
        if Farm.AntiAfkConnection then
            Farm.AntiAfkConnection:Disconnect()
            Farm.AntiAfkConnection = nil
        end
    end
end

Hub.Farm = Farm

-- Auto items: Pumpkinspice on all-door cooldown + UpgradedBasket (2x drop) --------
-- Pumpkinspice is fired only when the door farm has walked the whole list, every
-- door answered with the "Trick OR Treat Cooldown" toast, and that toast was really
-- received from the server. UpgradedBasket is fired on a timer while it is enabled.
do
    local Items = {
        Remote = nil,
        Toast = nil,
        NextPumpkinAt = 0,
        NextBasketAt = 0,
        PumpkinUses = 0,
        BasketUses = 0,
        ToastCount = 0,
        ToastSeen = false,
        ToastAttached = false,
        LastToastText = "",
        LastToastAt = 0,
        PumpkinStatus = "idle",
        BasketStatus = "idle",
        Listener = nil,
        Running = true,
        ReportToken = 0,
        Rewards = {
            Doors = 0,
            Shards = 0,
            Coupons = 0,
            VipCoupons = 0,
            CursedKeys = 0,
            Pumpkins = 0,
        },
    }

    Items.PumpkinItem = "Pumpkinspice"
    Items.BasketItem = "UpgradedBasket"

    -- Fixed internal cadence. No user setting: the coffee only fires on an
    -- all-door cooldown wave, the pumpkin fires whenever it is available.
    local PumpkinRetry = 2
    local BasketRetry = 2

    local function FindDeep(root, ...)
        local node = root
        for _, name in ipairs({ ... }) do
            if not node then
                return nil
            end
            node = node:FindFirstChild(name)
        end
        return node
    end

    -- RemoteEvent and UnreliableRemoteEvent both expose FireServer/OnClientEvent,
    -- so probe for the members instead of matching a class name.
    local function HasFireServer(obj)
        if not obj then
            return false
        end
        local ok, value = pcall(function()
            return obj.FireServer
        end)
        return ok and value ~= nil
    end

    local function HasOnClientEvent(obj)
        if not obj then
            return false
        end
        local ok, value = pcall(function()
            return obj.OnClientEvent
        end)
        return ok and value ~= nil
    end

    function Items.RefreshRemotes()
        local useItem = FindDeep(ReplicatedStorage, "UseItem")
        if HasFireServer(useItem) then
            Items.Remote = useItem
        else
            Items.Remote = nil
        end

        local toast = FindDeep(ReplicatedStorage, "Toasts", "Assets", "Remotes", "Display")
        if HasOnClientEvent(toast) then
            Items.Toast = toast
        else
            Items.Toast = nil
        end
        return Items.Remote, Items.Toast
    end

    local function Fire(itemName)
        if not HasFireServer(Items.Remote) then
            Items.RefreshRemotes()
        end
        if not HasFireServer(Items.Remote) then
            return false, "UseItem remote not found"
        end
        local ok, err = pcall(function()
            Items.Remote:FireServer(itemName)
        end)
        if not ok then
            return false, tostring(err)
        end
        return true, nil
    end

    function Items.UsePumpkinspice()
        local ok, err = Fire(Items.PumpkinItem)
        if ok then
            Items.PumpkinUses = Items.PumpkinUses + 1
            Items.PumpkinStatus = "used x" .. tostring(Items.PumpkinUses)
        else
            Items.PumpkinStatus = tostring(err)
        end
        return ok, err
    end

    function Items.UseBasket()
        local ok, err = Fire(Items.BasketItem)
        if ok then
            Items.BasketUses = Items.BasketUses + 1
            Items.BasketStatus = "used x" .. tostring(Items.BasketUses)
        else
            Items.BasketStatus = tostring(err)
        end
        return ok, err
    end

    -- The cooldown toast carries no door name, so it only proves the server rejected
    -- a door. "Every door" comes from the farm: it walked the full list and each
    -- entry was still cooling down.
    local function IsCooldownToast(data)
        if type(data) ~= "table" then
            return false
        end
        local title = string.lower(tostring(data.Title or ""))
        local content = string.lower(tostring(data.ContentText or data.Content or ""))
        if title:find("cooldown", 1, true) then
            return true
        end
        if content:find("on cooldown", 1, true) then
            return true
        end
        if content:find("try again later", 1, true) then
            return true
        end
        return false
    end

    -- A door that actually opened means the cooldown wave is over.
    function Items.NoteDoorOpened()
        Items.ToastSeen = false
    end

    function Items.AllDoorsCooling()
        if (Farm.DoorCount or 0) <= 0 then
            return false
        end
        if not Farm.AllDoorsCooling then
            return false
        end
        if tick() - (Farm.AllDoorsCoolingAt or 0) > 120 then
            return false
        end
        return Items.ToastSeen == true
    end

    function Items.Stop()
        Items.Running = false
    end

    -- Door reward toasts have no fixed wording, so the category comes from a
    -- keyword and the amount from the first number in the text.
    function Items.ParseReward(text)
        local lower = string.lower(tostring(text or ""))
        if lower == "" then
            return nil
        end
        local kind = nil
        -- "Premium Upgrade Coupon" is the in-game name for the premium coupon.
        if lower:find("coupon", 1, true) and (lower:find("premium", 1, true) or lower:find("vip", 1, true)) then
            kind = "VipCoupons"
        elseif lower:find("coupon", 1, true) then
            kind = "Coupons"
        elseif lower:find("cursed", 1, true) or lower:find("%f[%a]keys?%f[%A]") then
            kind = "CursedKeys"
        -- The game calls the shards "Crystals".
        elseif lower:find("crystal", 1, true) or lower:find("shard", 1, true) then
            kind = "Shards"
        -- The game calls the pumpkins "Jacks".
        elseif lower:find("%f[%a]jacks?%f[%A]") or lower:find("pumpkin", 1, true) then
            kind = "Pumpkins"
        end
        if not kind then
            return nil
        end
        local digits = lower:match("(%d[%d,]*)") or ""
        local cleaned = digits:gsub(",", "")
        local amount = tonumber(cleaned) or 1
        if amount <= 0 then
            amount = 1
        end
        Items.Rewards[kind] = (Items.Rewards[kind] or 0) + amount
        return kind, amount
    end

    function Items.SendRewardReport()
        if not State.DoorRewards then
            return false
        end
        local r = Items.Rewards
        local lines = {
            "**Doors opened:** " .. tostring(r.Doors or 0),
            "**Crystals:** " .. tostring(r.Shards or 0),
            "**Coupons:** " .. tostring(r.Coupons or 0),
            "**Premium Coupons:** " .. tostring(r.VipCoupons or 0),
            "**Cursed Keys:** " .. tostring(r.CursedKeys or 0),
            "**Jacks:** " .. tostring(r.Pumpkins or 0),
        }
        return SendDiscordWebhook("Door Opened - Farm Totals", table.concat(lines, "\n"), 16753920)
    end

    function Items.NoteDoorOpenedReward()
        Items.Rewards.Doors = (Items.Rewards.Doors or 0) + 1
        local token = (Items.ReportToken or 0) + 1
        Items.ReportToken = token
        task.delay(1.5, function()
            if Items.ReportToken ~= token then
                return
            end
            pcall(Items.SendRewardReport)
        end)
    end

    local function OnToast(data)
        if type(data) ~= "table" then
            return
        end
        local content = tostring(data.ContentText or data.Content or "")
        if IsCooldownToast(data) then
            Items.LastToastText = content
            -- Only react while the door farm is actually running.
            if not Farm.DoorRunning then
                return
            end
            Items.ToastSeen = true
            Items.ToastCount = Items.ToastCount + 1
            Items.LastToastAt = tick()
            Farm.DoorCooldownHit = true
            Farm.DoorCooldownHitAt = tick()
            return
        end
        if not State.DoorRewards then
            return
        end
        Items.ParseReward(tostring(data.Title or "") .. " " .. content)
    end

    local function AttachToast()
        if Items.ToastAttached and HasOnClientEvent(Items.Toast) then
            return true
        end
        Items.RefreshRemotes()
        if not HasOnClientEvent(Items.Toast) then
            Items.ToastAttached = false
            return false
        end
        local connected = pcall(function()
            Items.Toast.OnClientEvent:Connect(function(data)
                pcall(OnToast, data)
            end)
        end)
        Items.ToastAttached = connected == true
        return Items.ToastAttached
    end

    local function ResetDoorCycle()
        for name in pairs(Farm.DoorVisited) do
            Farm.DoorVisited[name] = nil
        end
        Farm.AllDoorsCooling = false
        Farm.AllDoorsCoolingAt = 0
        Farm.DoorNextAt = 0
        Items.ToastSeen = false
    end

    local function Loop()
        local nextAttach = 0
        local nextPaint = 0
        while Items.Running do
            task.wait(0.5)
            local now = tick()

            if not Items.ToastAttached and now >= nextAttach then
                nextAttach = now + 2
                AttachToast()
            end

            if State.Pumpkinspice then
                if now >= Items.NextPumpkinAt and Items.AllDoorsCooling() then
                    Items.NextPumpkinAt = now + PumpkinRetry
                    Items.UsePumpkinspice()
                    if State.PumpkinspiceReset then
                        ResetDoorCycle()
                    end
                end
            end

            if State.Basket and now >= Items.NextBasketAt then
                Items.NextBasketAt = now + BasketRetry
                Items.UseBasket()
            end

            if now >= nextPaint then
                nextPaint = now + 1
                if type(Items.Listener) == "function" then
                    pcall(Items.Listener)
                end
            end
        end
    end

    task.defer(function()
        pcall(Items.RefreshRemotes)
        pcall(AttachToast)
        task.spawn(Loop)
    end)

    Hub.Items = Items
end


-- Fast Flags engine (ported from Cokeboys) + Fullbright ------------------------
-- Wrapped in do/end so the new locals never raise the chunk's local count.
do
    local LightingService = game:GetService("Lighting")

    local FFlagSnapshotFile = "SkibidiDefense_FFlagAutoApply.json"
    local FFlagPresetFile = "SkibidiDefense_FFlagPresets.json"

    local FFlags = {
        busy = false,
        generation = 0,
        autoAttempted = false,
        lastResult = nil,
        message = "Idle",
        listener = nil,
        startupPendingToken = nil,
        startupPendingPayload = nil,
    }

    local function FFlagReport(text)
        FFlags.message = tostring(text)
        if type(FFlags.listener) == "function" then
            pcall(FFlags.listener, FFlags.message)
        end
    end

    -- Accepts one JSON object of flag names to values.
    function FFlags.parsePayload(payload)
        if type(payload) ~= "string" or payload:gsub("%s", "") == "" then
            return nil, "Paste an FFlag JSON object first."
        end
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(payload)
        end)
        if not ok or type(decoded) ~= "table" then
            return nil, "Paste a valid JSON object of flag names and values."
        end
        local list = {}
        for name, value in pairs(decoded) do
            list[#list + 1] = { name = name, value = value }
        end
        table.sort(list, function(a, b)
            return tostring(a.name) < tostring(b.name)
        end)
        if #list == 0 then
            return nil, "The JSON object did not contain any flags."
        end
        return list, nil
    end

    local function FFlagReadSnapshot()
        if type(readfile) ~= "function" then
            return nil, "Local file access is unavailable."
        end
        if type(isfile) == "function" then
            local checked, exists = pcall(isfile, FFlagSnapshotFile)
            if checked and not exists then
                return nil, nil
            end
        end
        local ok, content = pcall(readfile, FFlagSnapshotFile)
        if not ok or type(content) ~= "string" or content == "" then
            return nil, nil
        end
        local decoded, data = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if not decoded or type(data) ~= "table" then
            return nil, "The saved auto-apply snapshot is invalid."
        end
        return data, nil
    end

    local function FFlagWriteSnapshot(data)
        if type(writefile) ~= "function" then
            return false, "Local file access is unavailable."
        end
        local encoded, body = pcall(function()
            return HttpService:JSONEncode(data)
        end)
        if not encoded then
            return false, "The auto-apply snapshot could not be encoded."
        end
        local wrote, result = pcall(writefile, FFlagSnapshotFile, body)
        if wrote and result ~= false then
            return true, nil
        end
        return false, "The auto-apply snapshot could not be saved."
    end

    function FFlags.getSnapshot()
        local data, err = FFlagReadSnapshot()
        if not data then
            return nil, err
        end
        if type(data.Payload) ~= "string" then
            return nil, nil
        end
        local parsed, parseErr = FFlags.parsePayload(data.Payload)
        return {
            enabled = data.Enabled == true,
            payload = data.Payload,
            updatedAt = tonumber(data.UpdatedAt),
            count = parsed and #parsed or 0,
            valid = parsed ~= nil,
            pending = data.Pending == true,
            pendingAt = tonumber(data.PendingAt),
            quarantined = data.Quarantined == true,
        }, parseErr
    end

    function FFlags.saveSnapshot(payload)
        local parsed, err = FFlags.parsePayload(payload)
        if not parsed then
            return false, err
        end
        local current = FFlagReadSnapshot()
        local ok, writeErr = FFlagWriteSnapshot({
            Version = 1,
            Enabled = type(current) == "table" and current.Enabled == true or false,
            Payload = payload,
            UpdatedAt = os.time(),
            Pending = false,
            Quarantined = false,
        })
        return ok, writeErr, ok and #parsed or nil
    end

    function FFlags.setEnabled(enabled)
        local data, err = FFlagReadSnapshot()
        if not data then
            if enabled then
                return false, err or "Save the current JSON as an auto-apply snapshot first."
            end
            return true, nil
        end
        if enabled then
            local parsed, parseErr = FFlags.parsePayload(data.Payload)
            if not parsed then
                return false, parseErr
            end
        end
        data.Version = 1
        data.Enabled = enabled == true
        data.Pending = false
        data.PendingAt = nil
        if enabled then
            data.Quarantined = false
        end
        return FFlagWriteSnapshot(data)
    end

    function FFlags.beginStartupAttempt(payload)
        local data, err = FFlagReadSnapshot()
        if not data then
            return nil, err or "The saved auto-apply snapshot disappeared."
        end
        if data.Enabled ~= true or data.Payload ~= payload then
            return nil, "The saved auto-apply snapshot changed before startup application."
        end
        local token = os.time()
        data.Pending = true
        data.PendingAt = token
        data.Quarantined = false
        local ok, writeErr = FFlagWriteSnapshot(data)
        if not ok then
            return nil, writeErr
        end
        FFlags.startupPendingToken = token
        FFlags.startupPendingPayload = payload
        return token, nil
    end

    function FFlags.completeStartupAttempt(token)
        local data, err = FFlagReadSnapshot()
        if not data then
            return false, err
        end
        if data.Pending ~= true
            or tonumber(data.PendingAt) ~= tonumber(token)
            or data.Payload ~= FFlags.startupPendingPayload then
            return true, nil
        end
        data.Pending = false
        data.PendingAt = nil
        local ok, writeErr = FFlagWriteSnapshot(data)
        if ok then
            FFlags.startupPendingToken = nil
            FFlags.startupPendingPayload = nil
        end
        return ok, writeErr
    end

    function FFlags.quarantineInterruptedStartup()
        local data, err = FFlagReadSnapshot()
        if not data then
            return false, err
        end
        data.Enabled = false
        data.Pending = false
        data.PendingAt = nil
        data.Quarantined = true
        data.QuarantinedAt = os.time()
        return FFlagWriteSnapshot(data)
    end

    function FFlags.deleteSnapshot()
        FFlags.generation = FFlags.generation + 1
        if type(delfile) == "function" then
            if type(isfile) == "function" then
                local checked, exists = pcall(isfile, FFlagSnapshotFile)
                if checked and not exists then
                    return true, nil
                end
            end
            local ok, result = pcall(delfile, FFlagSnapshotFile)
            if ok and result ~= false then
                return true, nil
            end
        end
        return FFlagWriteSnapshot({
            Version = 1,
            Enabled = false,
            Pending = false,
            Quarantined = false,
            UpdatedAt = os.time(),
        })
    end

    function FFlags.cancel()
        FFlags.generation = FFlags.generation + 1
        if FFlags.startupPendingToken then
            FFlags.completeStartupAttempt(FFlags.startupPendingToken)
        end
    end

    function FFlags.applyPayload(payload, options)
        options = type(options) == "table" and options or {}
        if FFlags.busy then
            return nil, "A preset is already being applied."
        end
        if type(setfflag) ~= "function" then
            return nil, "Your executor does not provide setfflag."
        end
        local list, err = FFlags.parsePayload(payload)
        if not list then
            return nil, err
        end
        FFlags.busy = true
        FFlags.generation = FFlags.generation + 1
        local generation = FFlags.generation
        local applied, failed, processed, cancelled = 0, 0, 0, false
        for index, entry in ipairs(list) do
            if generation ~= FFlags.generation
                or not State.Running
                or (type(options.shouldCancel) == "function" and options.shouldCancel()) then
                cancelled = true
                break
            end
            local name, value = entry.name, entry.value
            if type(name) == "string"
                and (type(value) == "string" or type(value) == "number" or type(value) == "boolean") then
                local text = type(value) == "boolean" and (value and "true" or "false") or tostring(value)
                local lowered = string.lower(text)
                text = (lowered == "true" or lowered == "false") and lowered or text
                local callOk, callResult = pcall(setfflag, name, text)
                local ok = callOk and callResult ~= false
                local verified = false
                if type(getfflag) == "function" then
                    local readOk, readValue = pcall(getfflag, name)
                    verified = readOk and readValue ~= nil
                        and string.lower(tostring(readValue)) == string.lower(text)
                end
                if ok or verified then
                    applied = applied + 1
                else
                    failed = failed + 1
                end
            else
                failed = failed + 1
            end
            if type(options.onProgress) == "function" then
                pcall(options.onProgress, index, #list)
            end
            if index % 4 == 0 and index < #list then
                task.wait(0.1)
            end
            processed = index
        end
        FFlags.busy = false
        local result = {
            applied = applied,
            failed = failed,
            processed = processed,
            total = #list,
            cancelled = cancelled or generation ~= FFlags.generation,
            automatic = options.automatic == true,
        }
        FFlags.lastResult = result
        return result, nil
    end

    -- Built-in presets shipped with Cokeboys.
    local FFlagPresetDesktop = {
        HandleAltEnterFullscreenManually = "False",
        TextureQualityOverrideEnabled = "True",
        DisableDPIScale = "True",
        CSGLevelOfDetailSwitchingDistanceL34 = "0",
        CSGLevelOfDetailSwitchingDistanceL23 = "0",
