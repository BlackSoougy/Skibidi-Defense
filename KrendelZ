    -- Field of view ------------------------------------------------------------
    -- Движок режет Camera.FieldOfView до 120 - это его внутренний лимит.
    -- Ползунок идёт до 200, и всё что выше 120 добирается расширителем:
    -- камера отъезжает назад по своему взгляду ровно настолько, чтобы видимый
    -- угол совпал с запрошенным. До 120 всё выставляется честно, через камеру.
    -- Геометрия перспективы физически не даёт угла больше ~176°, поэтому
    -- отъезд ограничен - дальше просто упираемся в потолок, а не улетаем
    -- камерой за карту.
    local Fov = {
        value = 70,
        applied = 70,
        capped = false,
        on = false,
        conn = nil,
        original = nil,
        message = "FOV not applied",
        dolly = 0,
        baseCFrame = nil,
        lastPosition = nil,
        bound = false,
    }

    local FovRun = game:GetService("RunService")

    local FOV_CAP = 120          -- предел самого движка
    local FOV_MAX = 200          -- предел ползунка
    local FOV_REF_DISTANCE = 26  -- дистанция, на которой считаем «ширину» кадра
    local FOV_DOLLY_MAX = 120    -- максимум отъезда камеры, студов
    local FOV_BIND_NAME = "StarHubFovExtension"

    function Fov.camera()
        local ok, cam = pcall(function()
            return Workspace.CurrentCamera
        end)
        if ok then
            return cam
        end
        return nil
    end

    function Fov.read(cam)
        local ok, value = pcall(function()
            return cam.FieldOfView
        end)
        if ok then
            return tonumber(value) or 0
        end
        return 0
    end

    -- Пробуем всё, что может дать значение выше 120, и возвращаем то, что
    -- действительно оказалось в камере.
    function Fov.push(cam, target)
        local goal = math.clamp(tonumber(target) or 70, 1, FOV_CAP)
        pcall(function()
            cam.FieldOfView = goal
        end)
        local actual = Fov.read(cam)
        if actual >= goal - 0.5 then
            return actual
        end
        if type(sethiddenproperty) == "function" then
            pcall(sethiddenproperty, cam, "FieldOfView", goal)
            actual = Fov.read(cam)
            if actual >= goal - 0.5 then
                return actual
            end
        end
        return actual
    end

    -- Тангенс половины угла. Выше 88° перспектива вырождается, поэтому
    -- подрезаем: иначе счёт уходит в бесконечность.
    local function halfTan(deg)
        return math.tan(math.rad(math.min(deg * 0.5, 88)))
    end

    -- Сколько студов отъехать назад, чтобы видимый угол совпал с target.
    function Fov.dollyFor(target)
        local wanted = math.clamp(tonumber(target) or 70, 1, FOV_MAX)
        if wanted <= FOV_CAP then
            return 0
        end
        local ratio = halfTan(wanted) / halfTan(FOV_CAP)
        local dolly = FOV_REF_DISTANCE * math.max(0, ratio - 1)
        return math.min(dolly, FOV_DOLLY_MAX)
    end

    function Fov.apply(value)
        local target = math.clamp(tonumber(value) or 70, 1, FOV_MAX)
        Fov.value = target
        local cam = Fov.camera()
        if not cam then
            Fov.message = "no camera yet"
            return false
        end
        if not Fov.original then
            local current = Fov.read(cam)
            if current > 0 then
                Fov.original = current
            end
        end
        local native = math.min(target, FOV_CAP)
        local actual = Fov.push(cam, native)
        Fov.applied = actual
        Fov.capped = target > actual + 0.5
        Fov.dolly = (target > FOV_CAP) and Fov.dollyFor(target) or 0
        Fov.lastPosition = nil
        if Fov.dolly > 0.05 then
            Fov.message = string.format(
                "%d° (engine %d° + extender %d studs)",
                target,
                actual,
                math.floor(Fov.dolly + 0.5)
            )
        elseif Fov.capped then
            Fov.message = string.format("asked %d, engine gave %d - hard cap is 120", target, actual)
        else
            Fov.message = string.format("%d degrees", actual)
        end
        return true
    end

    -- Каждый кадр после камеры игры: держим нативное значение и отъезд.
    function Fov.step()
        if not Fov.on then
            return
        end
        local cam = Fov.camera()
        if not cam then
            return
        end
        local native = math.min(Fov.value, FOV_CAP)
        if math.abs(Fov.read(cam) - native) > 0.1 then
            Fov.push(cam, native)
        end
        local dolly = Fov.dolly
        if dolly <= 0.05 then
            return
        end
        local cf = cam.CFrame
        local base = cf
        -- Если камера с прошлого кадра не двигалась, значит в ней всё ещё наш
        -- собственный сдвиг - считаем от исходной точки, иначе отъезд накопим.
        if Fov.lastPosition and (cf.Position - Fov.lastPosition).Magnitude < 0.01 then
            base = Fov.baseCFrame or cf
        end
        Fov.baseCFrame = base
        local shifted = base * CFrame.new(0, 0, dolly)
        Fov.lastPosition = shifted.Position
        pcall(function()
            cam.CFrame = shifted
        end)
    end

    function Fov.bind()
        if Fov.bound then
            return
        end
        Fov.bound = true
        pcall(function()
            FovRun:BindToRenderStep(FOV_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, Fov.step)
        end)
    end

    function Fov.unbind()
        if not Fov.bound then
            return
        end
        Fov.bound = false
        pcall(function()
            FovRun:UnbindFromRenderStep(FOV_BIND_NAME)
        end)
    end

    function Fov.setEnabled(enabled)
        Fov.on = enabled == true
        if Fov.on then
            Fov.apply(Fov.value)
            Fov.bind()
        else
            Fov.unbind()
            Fov.dolly = 0
            Fov.lastPosition = nil
            Fov.baseCFrame = nil
            local cam = Fov.camera()
            if cam and Fov.original then
                pcall(function()
                    cam.FieldOfView = Fov.original
                end)
            end
        end
    end

    function Fov.refresh()
        if Fov.on then
            Fov.apply(Fov.value)
        end
    end

    function Fov.reset()
        Fov.unbind()
        Fov.on = false
        Fov.dolly = 0
        Fov.lastPosition = nil
        Fov.baseCFrame = nil
        local cam = Fov.camera()
        if cam and Fov.original then
            pcall(function()
                cam.FieldOfView = Fov.original
            end)
        end
        Fov.applied = Fov.original or 70
        Fov.capped = false
        Fov.message = "FOV restored"
    end

    Hub.Fov = Fov

    -- Applies a saved snapshot once the hub is up (crash-loop protected).
    task.delay(2, function()
        if State.Running then
            pcall(FFlags.runStartupAutoApply)
        end
    end)
end

