-- Auto Load (re-execute on teleport) -------------------------------------------
-- Взято из QuantumOnyx (OnAutoLoadScript / AutoLoadScriptonLoad) и усилено
-- защитой от двойного запуска и цепочкой по JobId, как в Mammoth.
do
    local AutoLoad = {}
    Hub.AutoLoad = AutoLoad

    AutoLoad.Status = "idle"
    AutoLoad.CacheFile = MacroFolder .. "/AutoLoadSource.lua"
    AutoLoad.GuardKey = "StarHubAutoLoadJob"

    function AutoLoad.GetQueue()
        local env = getgenv and getgenv() or _G
        local fn = env and rawget(env, "queue_on_teleport")
        if type(fn) ~= "function" then
            fn = rawget(_G, "queue_on_teleport")
        end
        if type(fn) ~= "function" then
            fn = (env and rawget(env, "queueonteleport")) or rawget(_G, "queueonteleport")
        end
        if type(fn) ~= "function" then
            local syn = rawget(_G, "syn")
            if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
                fn = syn.queue_on_teleport
            end
        end
        if type(fn) ~= "function" then
            local fluxus = rawget(_G, "fluxus")
            if type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" then
                fn = fluxus.queue_on_teleport
            end
        end
        return type(fn) == "function" and fn or nil
    end

    function AutoLoad.IsUrl(text)
        return type(text) == "string" and text:match("^%s*https?://%S+") ~= nil
    end

    function AutoLoad.Normalize(text)
        if type(text) ~= "string" then return "" end
        text = text:gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then return "" end
        if AutoLoad.IsUrl(text) then
            return string.format('loadstring(game:HttpGet("%s"))()', text)
        end
        return text
    end

    function AutoLoad.BuildPayload(code, delay)
        local guard = AutoLoad.GuardKey
        return table.concat({
            "-- StarHub auto load payload",
            "task.spawn(function()",
            "    repeat task.wait(1) until game:IsLoaded()",
            string.format("    task.wait(%.2f)", delay),
            string.format("    local g = getgenv and getgenv() or _G"),
            string.format('    if g.%s == game.JobId then return end', guard),
            string.format('    g.%s = game.JobId', guard),
            "    local ok, err = pcall(function()",
            "        local src = [=====[",
            code,
            "]=====]",
            "        local chunk, loadErr = loadstring(src)",
            "        if type(chunk) ~= 'function' then",
            "            error(loadErr or 'loadstring failed', 0)",
            "        end",
            "        chunk()",
            "    end)",
            '    if not ok then warn("[StarHub auto load] " .. tostring(err)) end',
            "end)",
        }, "\n")
    end

    function AutoLoad.GetSource()
        local saved = State.AutoLoadSource
        if type(saved) == "string" and saved:find("%S") then
            return AutoLoad.Normalize(saved)
        end
        local env = getgenv and getgenv() or _G
        local alt = env and rawget(env, "StarHubAutoLoadSource")
        if type(alt) == "string" and alt:find("%S") then
            return AutoLoad.Normalize(alt)
        end
        -- Файл читается один раз: статус-строка дёргает GetSource постоянно.
        if AutoLoad.FileSource == nil then
            AutoLoad.FileSource = false
            if HasFilesystem and isfile and readfile then
                local ok, data = pcall(function()
                    if isfile(AutoLoad.CacheFile) then
                        return readfile(AutoLoad.CacheFile)
                    end
                end)
                if ok and type(data) == "string" and data:find("%S") then
                    AutoLoad.FileSource = data
                end
            end
        end
        if type(AutoLoad.FileSource) == "string" and AutoLoad.FileSource ~= "" then
            return AutoLoad.Normalize(AutoLoad.FileSource)
        end
        return ""
    end

    function AutoLoad.SetSource(text)
        State.AutoLoadSource = type(text) == "string" and text or ""
        local normalized = AutoLoad.Normalize(State.AutoLoadSource)
        AutoLoad.FileSource = normalized ~= "" and normalized or false
        if HasFilesystem and writefile and normalized ~= "" then
            pcall(function()
                if makefolder and isfolder and not isfolder(MacroFolder) then
                    makefolder(MacroFolder)
                end
                writefile(AutoLoad.CacheFile, normalized)
            end)
        end
        QueueSave()
    end

    function AutoLoad.Arm(silent)
        local code = AutoLoad.GetSource()
        if code == "" then
            AutoLoad.Status = "no source saved"
            if not silent then Notify("Auto Load", AutoLoad.Status) end
            return false
        end
        local queueFn = AutoLoad.GetQueue()
        if not queueFn then
            AutoLoad.Status = "executor has no queue_on_teleport"
            if not silent then Notify("Auto Load", AutoLoad.Status) end
            return false
        end
        local delay = math.clamp(tonumber(State.AutoLoadDelay) or 2, 0, 60)
        local ok = pcall(queueFn, AutoLoad.BuildPayload(code, delay))
        if ok then
            AutoLoad.Status = string.format("armed | %.0fs | %d bytes", delay, #code)
            AutoLoad.ArmedAt = os.clock()
        else
            AutoLoad.Status = "queue_on_teleport failed"
        end
        if not silent then Notify("Auto Load", AutoLoad.Status) end
        return ok
    end

    function AutoLoad.Clear()
        State.AutoLoadSource = ""
        AutoLoad.FileSource = false
        if HasFilesystem and delfile and isfile then
            pcall(function()
                if isfile(AutoLoad.CacheFile) then delfile(AutoLoad.CacheFile) end
            end)
        end
        AutoLoad.Status = "source cleared"
        QueueSave()
    end
end

