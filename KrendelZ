Farm.ClearRunning = false
Farm.ClearRemoved = 0
Farm.ClearResolved = 0
Farm.ClearTotal = 0
Farm.ClearReport = nil
Farm.ClearAuto = true
Farm.ClearTolerance = 8
Farm.ClearSizeUsed = false

-- Закреплённые пары «имя|класс». Таких объектов в карте слишком много, чтобы
-- верить одному имени: под «Part» попадёт вообще всё. Для закреплённых цели
-- требуется ещё и точная позиция (±4 студа) вместе с размером (±1 студа).
-- Длинный проход по размеру для них включается только в том случае, если по
-- позиции не нашлось ни одной — то есть когда карта стоит совсем не там.
Farm.ClearPinned = {
    ["Part|Part"] = true,
}
Farm.ClearStrictTolerance = 4
Farm.ClearSizeTolerance = 1
Farm.ClearPinnedSizeUsed = false
Farm.ClearPinnedResolved = 0

function Farm.ClearParse()
    local list = {}
    for line in string.gmatch(Farm.ClearData or "", "[^\r\n]+") do
        local name, class, px, py, pz, sx, sy, sz =
            string.match(line, "^([^|]+)|([^|]+)|(%-?%d+),(%-?%d+),(%-?%d+)|(%-?%d+),(%-?%d+),(%-?%d+)|")
        if name then
            list[#list + 1] = {
                name = name,
                class = class,
                x = tonumber(px),
                y = tonumber(py),
                z = tonumber(pz),
                sizeX = tonumber(sx),
                sizeY = tonumber(sy),
                sizeZ = tonumber(sz),
                pinned = Farm.ClearPinned[name .. "|" .. class] == true,
                done = false,
            }
        end
    end
    return list
end

-- Подпись цели: имя + класс + размер. По ней ищем объекты, которые уехали на
-- другое место.
function Farm.ClearSigOf(target)
    return string.format("%s|%s|%d|%d|%d", target.name, target.class,
        math.floor((target.sizeX or 0) + 0.5),
        math.floor((target.sizeY or 0) + 0.5),
        math.floor((target.sizeZ or 0) + 0.5))
end

-- Индексы: сетка по 8 студов для поиска по позиции, набор имён для быстрого
-- отсева, набор классов и количество целей на каждую подпись.
function Farm.ClearIndex(list)
    local cells, names, classes, sizes = {}, {}, {}, {}
    for _, target in ipairs(list) do
        local cellKey = string.format("%d|%d|%d",
            math.floor(target.x / 8), math.floor(target.y / 8), math.floor(target.z / 8))
        local bucket = cells[cellKey]
        if not bucket then
            bucket = {}
            cells[cellKey] = bucket
        end
        bucket[#bucket + 1] = target

        names[target.name .. "|" .. target.class] = true
        classes[target.class] = true
        local sig = Farm.ClearSigOf(target)
        sizes[sig] = (sizes[sig] or 0) + 1
    end
    return cells, names, classes, sizes
end

-- Список «неприкасаемых» корней: персонажи всех игроков и модели с Humanoid.
function Farm.ClearBlocked()
    local set = {}
    local players = game:GetService("Players")
    local okPlayers, list = pcall(function()
        return players:GetPlayers()
    end)
    if okPlayers and list then
        for _, player in ipairs(list) do
            local character = player.Character
            if character then
                set[character] = true
            end
        end
    end
    local me = players.LocalPlayer
    if me and me.Character then
        set[me.Character] = true
    end
    local ok, children = pcall(function()
        return Workspace:GetChildren()
    end)
    if ok and children then
        for _, item in ipairs(children) do
            if item:IsA("Model") then
                local okHumanoid, humanoid = pcall(function()
                    return item:FindFirstChildOfClass("Humanoid")
                end)
                if okHumanoid and humanoid then
                    set[item] = true
                end
            end
        end
    end
    return set
end

-- Персонажей, NPC, аксессуары и террейн не трогаем никогда.
function Farm.ClearForbidden(object, blocked)
    if object:IsA("Terrain") or object:IsA("Player") then
        return true
    end
    local players = game:GetService("Players")
    if object:IsDescendantOf(players) then
        return true
    end
    if blocked and blocked[object] then
        return true
    end
    local node = object
    local guard = 0
    while node and guard < 64 do
        if blocked and blocked[node] then
            return true
        end
        local parent = node.Parent
        if parent == nil then
            break
        end
        if parent == Workspace then
            if node:IsA("Model") then
                local okHumanoid, humanoid = pcall(function()
                    return node:FindFirstChildOfClass("Humanoid")
                end)
                if okHumanoid and humanoid then
                    return true
                end
            end
            break
        end
        node = parent
        guard = guard + 1
    end
    return false
end

function Farm.ClearPosition(object)
    local ok, value = pcall(function()
        if object:IsA("BasePart") then
            return object.Position
        end
        return object:GetPivot().Position
    end)
    if ok then
        return value
    end
    return nil
end

function Farm.ClearSizeOf(object)
    local ok, value = pcall(function()
        if object:IsA("BasePart") then
            return object.Size
        end
        return object:GetExtentsSize()
    end)
    if ok and value and (value.X > 0 or value.Y > 0 or value.Z > 0) then
        return value
    end
    if object:IsA("Model") then
        local low, high = nil, nil
        local okDesc, list = pcall(function()
            return object:GetDescendants()
        end)
        if okDesc and list then
            for _, item in ipairs(list) do
                if item:IsA("BasePart") then
                    local okPos, position = pcall(function()
                        return item.Position
                    end)
                    if okPos and position then
                        local half = item.Size * 0.5
                        local lo = position - half
                        local hi = position + half
                        if low then
                            low = Vector3.new(math.min(low.X, lo.X), math.min(low.Y, lo.Y), math.min(low.Z, lo.Z))
                            high = Vector3.new(math.max(high.X, hi.X), math.max(high.Y, hi.Y), math.max(high.Z, hi.Z))
                        else
                            low, high = lo, hi
                        end
                    end
                end
            end
        end
        if low and high then
            return high - low
        end
    end
    return Vector3.new(0, 0, 0)
end

-- Отвязываем объект. Через pcall: одна залоченная часть не должна ронять
-- весь проход.
function Farm.ClearDetach(object, blocked)
    if Farm.ClearForbidden(object, blocked) then
        return false
    end
    local ok = pcall(function()
        object.Parent = nil
    end)
    return ok and object.Parent == nil
end

-- Размер совпал с точностью до студа. Нужен только закреплённым целям:
-- в журнале размер округлён, поэтому допускаем ±1.
function Farm.ClearSizeClose(target, size)
    if not size then
        return false
    end
    local tol = Farm.ClearSizeTolerance
    if math.abs((target.sizeX or 0) - size.X) > tol then
        return false
    end
    if math.abs((target.sizeY or 0) - size.Y) > tol then
        return false
    end
    if math.abs((target.sizeZ or 0) - size.Z) > tol then
        return false
    end
    return true
end

-- Ближайшая цель с ТЕМ ЖЕ именем и классом в радиусе допуска.
-- Для обычных целей радиус 8, для закреплённых — 4 плюс обязательное
-- совпадение размера, иначе под «Part» уедет соседний парт.
function Farm.ClearMatch(cells, object, position, size)
    local radius = Farm.ClearTolerance
    local span = math.max(1, math.ceil(radius / 8))
    local cx = math.floor(position.X / 8)
    local cy = math.floor(position.Y / 8)
    local cz = math.floor(position.Z / 8)
    local best, bestDist = nil, math.huge
    for dx = -span, span do
        for dy = -span, span do
            for dz = -span, span do
                local bucket = cells[string.format("%d|%d|%d", cx + dx, cy + dy, cz + dz)]
                if bucket then
                    for _, target in ipairs(bucket) do
                        if not target.done
                            and target.class == object.ClassName
                            and target.name == object.Name then
                            local limit = radius
                            if target.pinned then
                                limit = Farm.ClearStrictTolerance
                            end
                            local ddx = target.x - position.X
                            local ddy = target.y - position.Y
                            local ddz = target.z - position.Z
                            local d = ddx * ddx + ddy * ddy + ddz * ddz
                            if d <= limit * limit and d < bestDist then
                                local fits = true
                                if target.pinned then
                                    if not size then
                                        size = Farm.ClearSizeOf(object)
                                    end
                                    fits = Farm.ClearSizeClose(target, size)
                                end
                                if fits then
                                    best, bestDist = target, d
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Один проход по Workspace.
-- Удаляется только объект, у которого совпали ИМЯ и КЛАСС из списка, плюс
-- либо позиция, либо (если позиции не совпали) размер. Ничего чужого.
function Farm.ClearPass()
    local list = Farm.ClearParse()
    local cells, names, classes, sizes = Farm.ClearIndex(list)
    Farm.ClearTotal = #list
    local blocked = Farm.ClearBlocked()

    local ok, items = pcall(function()
        return Workspace:GetDescendants()
    end)
    if not ok or not items then
        Farm.ClearReport = "Workspace:GetDescendants() не сработал"
        return 0
    end

    -- Части, на которых висит интерфейс или кнопка, не трогаем никогда.
    for _, item in ipairs(items) do
        if item:IsA("SurfaceGui") or item:IsA("BillboardGui") or item:IsA("ClickDetector") then
            local host = item.Parent
            if host then
                blocked[host] = true
            end
        end
    end

    local removed, seen, byPos, bySize, byPin = 0, 0, 0, 0, 0
    local resolved = 0

    -- Проход 1: имя + класс + позиция (для закреплённых — ещё и размер).
    for _, item in ipairs(items) do
        if resolved >= #list then
            break
        end
        if item.Parent and item:IsDescendantOf(Workspace) and not Farm.ClearForbidden(item, blocked) then
            local isPart = item:IsA("BasePart")
            local isModel = item:IsA("Model")
            if (isPart or isModel) and classes[item.ClassName] then
                seen = seen + 1
                if seen % 3000 == 0 then
                    task.wait()
                end
                if names[item.Name .. "|" .. item.ClassName] then
                    local position = Farm.ClearPosition(item)
                    if position then
                        local target = Farm.ClearMatch(cells, item, position, nil)
                        if target and Farm.ClearDetach(item, blocked) then
                            target.done = true
                            removed = removed + 1
                            resolved = resolved + 1
                            if target.pinned then
                                byPin = byPin + 1
                            else
                                byPos = byPos + 1
                            end
                        end
                    end
                end
            end
        end
    end

    -- Проход 2: по подписи «имя + класс + размер». Нужен, когда карта стоит
    -- не там, где записана. На повторных проходах по уже чистой карте не
    -- включается, иначе начнёт добивать похожие объекты.
    -- Закреплённые цели попадают сюда только если по позиции не нашлось ни
    -- одной: значит карта действительно уехала, и иначе они просто не удалятся.
    if byPos > 0 then
        Farm.ClearSizeUsed = true
    end
    if byPin > 0 then
        Farm.ClearPinnedSizeUsed = true
    end
    local allowSize = byPos > 0 or not Farm.ClearSizeUsed
    local allowPinned = byPin == 0 and not Farm.ClearPinnedSizeUsed
    if resolved < #list and allowSize then
        local world, need = {}, {}
        for _, item in ipairs(items) do
            if item.Parent and item:IsDescendantOf(Workspace)
                and (item:IsA("BasePart") or item:IsA("Model"))
                and classes[item.ClassName]
                and not Farm.ClearForbidden(item, blocked) then
                local key = item.Name .. "|" .. item.ClassName
                if names[key] then
                    local size = Farm.ClearSizeOf(item)
                    if size then
                        local sig = string.format("%s|%d|%d|%d", key,
                            math.floor(size.X + 0.5), math.floor(size.Y + 0.5), math.floor(size.Z + 0.5))
                        local bucket = world[sig]
                        if not bucket then
                            bucket = {}
                            world[sig] = bucket
                        end
                        bucket[#bucket + 1] = item
                    end
                end
            end
        end
        for _, target in ipairs(list) do
            if not target.done and (allowPinned or not target.pinned) then
                local sig = Farm.ClearSigOf(target)
                need[sig] = (need[sig] or 0) + 1
            end
        end
        for sig, count in pairs(need) do
            local bucket = world[sig]
            -- Удаляем, только если объектов с такой подписью не больше, чем
            -- целей: лишние объекты этого имени и размера не трогаем.
            if bucket and count > 0 and #bucket > 0 and #bucket <= count then
                local deleted = 0
                for _, item in ipairs(bucket) do
                    if item.Parent and Farm.ClearDetach(item, blocked) then
                        removed = removed + 1
                        deleted = deleted + 1
                        bySize = bySize + 1
                    end
                end
                local marked = 0
                for _, target in ipairs(list) do
                    if marked >= deleted then
                        break
                    end
                    if not target.done and Farm.ClearSigOf(target) == sig then
                        target.done = true
                        resolved = resolved + 1
                        marked = marked + 1
                    end
                end
            end
        end
    end

    -- Отчёт: что нашли, а каких имён в мире нет.
    local keyTotal, keyDone = {}, {}
    for _, target in ipairs(list) do
        local key = target.name .. "|" .. target.class
        keyTotal[key] = true
        if target.done then
            keyDone[key] = (keyDone[key] or 0) + 1
        end
    end
    local missing = {}
    for key in pairs(keyTotal) do
        if not keyDone[key] then
            local name, class = string.match(key, "^([^|]+)|(.+)$")
            missing[#missing + 1] = tostring(name) .. " (" .. tostring(class) .. ")"
        end
    end

    Farm.ClearRemoved = removed
    Farm.ClearResolved = resolved
    Farm.ClearPinnedResolved = byPin
    Farm.ClearReport = string.format(
        "объектов %d | целей %d из %d | позиция %d, закреп %d, размер %d | просмотрено %d",
        removed, resolved, #list, byPos, byPin, bySize, seen)
    print("[Clear] " .. Farm.ClearReport)
    if #missing > 0 then
        table.sort(missing)
        print("[Clear] не найдено (" .. tostring(#missing) .. "): " .. table.concat(missing, ", "))
    end
    FarmReportFor("door", "чистка карты: " .. Farm.ClearReport)
    return removed
end

-- Обёртка: что бы ни сломалось внутри, флаг прохода сбрасывается.
function Farm.ClearOnce()
    if Farm.ClearRunning then
        return Farm.ClearRemoved
    end
    Farm.ClearRunning = true
    local ok, result = pcall(Farm.ClearPass)
    Farm.ClearRunning = false
    if not ok then
        Farm.ClearReport = "ошибка прохода: " .. tostring(result)
        print("[Clear] " .. Farm.ClearReport)
        FarmReportFor("door", "чистка карты: " .. Farm.ClearReport)
        return 0
    end
    return result or 0
end

-- Автозапуск: несколько проходов подряд, потому что части догружаются
-- стримингом уже после инжекта.
function Farm.ClearAutoRun()
    if not Farm.ClearAuto then
        return
    end
    task.spawn(function()
        local idle = 0
        for attempt = 1, 8 do
            task.wait(attempt == 1 and 2 or 5)
            if not Farm.ClearAuto then
                return
            end
            local added = Farm.ClearOnce() or 0
            if added == 0 then
                idle = idle + 1
                if idle >= 2 then
                    return
                end
            else
                idle = 0
            end
        end
    end)
end

-- Промпты (игровые кнопки, двери) срабатывают сквозь стены и игроков.
-- Дистанцию не трогаем: MaxActivationDistance остаётся обычным.
Farm.PromptPatchCount = 0
Farm.PromptPatchOn = false

function Farm.PatchPrompts()
    local ok, items = pcall(function()
        return Workspace:GetDescendants()
    end)
    if not ok or not items then
        return 0
    end
    local patched = 0
    for _, item in ipairs(items) do
        if item:IsA("ProximityPrompt") then
            local okSet = pcall(function()
                item.RequiresLineOfSight = false
            end)
            if okSet then
                patched = patched + 1
            end
        end
    end
    Farm.PromptPatchCount = patched
    return patched
end

function Farm.StartPromptPatch()
    if Farm.PromptPatchOn then
        return
    end
    Farm.PromptPatchOn = true
    Farm.PatchPrompts()
    -- Новые промпты (двери, кнопки) патчим сразу, как только они появились.
    if not Farm.PromptConn then
        local ok, conn = pcall(function()
            return Workspace.DescendantAdded:Connect(function(item)
                if not Farm.PromptPatchOn then
                    return
                end
                if item:IsA("ProximityPrompt") then
                    pcall(function()
                        item.RequiresLineOfSight = false
                    end)
                end
            end)
        end)
        if ok then
            Farm.PromptConn = conn
        end
    end
    -- И редкая страховка на случай, если соединение не сработало.
    task.spawn(function()
        while Farm.PromptPatchOn do
            task.wait(10)
            if Farm.PromptPatchOn then
                Farm.PatchPrompts()
            end
        end
    end)
end

function Farm.StopPromptPatch()
    Farm.PromptPatchOn = false
end

--==========================================================================
-- Промпты вне экрана
-- Движок фокусирует только тот промпт, который попал в кадр. Кнопка за
-- спиной или за краем экрана не фокусируется, и нажатие уходит в пустоту.
-- Поэтому клавишу слушаем сами: если движок её не обработал, ищем ближайший
-- промпт с той же клавишей в пределах ЕГО ЖЕ MaxActivationDistance и дёргаем
-- напрямую. Дистанцию по-прежнему не расширяем.
--==========================================================================

Farm.PromptAnywhereOn = false
Farm.PromptFocus = nil
Farm.PromptFocusSeen = false
Farm.PromptFocusBound = false
Farm.PromptLastFire = 0
Farm.PromptFireCount = 0
Farm.PromptCache = {}
Farm.PromptCacheAt = 0

-- Кэш промптов: полный обход Workspace на каждое нажатие клавиши слишком
-- дорогой, поэтому список обновляется не чаще раза в 3 секунды.
function Farm.RefreshPromptCache()
    local list = {}
    local ok, items = pcall(function()
        return Workspace:GetDescendants()
    end)
    if ok and items then
        for _, item in ipairs(items) do
            if item:IsA("ProximityPrompt") then
                list[#list + 1] = item
            end
        end
    end
    Farm.PromptCache = list
    Farm.PromptCacheAt = os.clock()
    return list
end

function Farm.PromptCached()
    if os.clock() - Farm.PromptCacheAt > 3 then
        return Farm.RefreshPromptCache()
    end
    return Farm.PromptCache
end

-- Промпт сам не BasePart, поэтому поднимаемся до ближайшей части-хозяина:
-- именно по ней считается дистанция.
function Farm.PromptAnchor(prompt)
    local node = prompt.Parent
    local guard = 0
    while node and not node:IsA("BasePart") and guard < 8 do
        guard = guard + 1
        node = node.Parent
    end
    if node and node:IsA("BasePart") then
        return node
    end
    return nil
end

-- Ближайший промпт с нужной клавишей, до которого реально можно дотянуться.
-- Камера здесь не участвует вообще.
function Farm.FirePromptKey(key)
    if os.clock() - Farm.PromptLastFire < 0.25 then
        return false
    end
    local root = FarmRoot()
    local origin = root and root.Position or nil
    local best, bestDist = nil, math.huge
    for _, prompt in ipairs(Farm.PromptCached()) do
        if prompt.Parent and prompt.Enabled and prompt.KeyboardKeyCode == key then
            local part = Farm.PromptAnchor(prompt)
            if part then
                local dist = 0
                if origin then
                    dist = (part.Position - origin).Magnitude
                end
                if dist <= Farm.PromptReach(prompt) and dist < bestDist then
                    best, bestDist = prompt, dist
                end
            end
        end
    end
    if not best then
        return false
    end
    Farm.PromptLastFire = os.clock()
    local fired = Farm.TriggerPrompt(best)
    if fired then
        Farm.PromptFireCount = Farm.PromptFireCount + 1
    end
    return fired
end

-- Кнопка «дёрнуть ближайший промпт»: ищет по клавише ближайшего из списка.
function Farm.FireNearestPrompt()
    local root = FarmRoot()
    local origin = root and root.Position or nil
    local best, bestDist = nil, math.huge
    for _, prompt in ipairs(Farm.PromptCached()) do
        if prompt.Parent and prompt.Enabled then
            local part = Farm.PromptAnchor(prompt)
            if part then
                local dist = 0
                if origin then
                    dist = (part.Position - origin).Magnitude
                end
                if dist <= Farm.PromptReach(prompt) and dist < bestDist then
                    best, bestDist = prompt, dist
                end
            end
        end
    end
    if not best then
        return false
    end
    return Farm.FirePromptKey(best.KeyboardKeyCode)
end

function Farm.PromptBindFocus()
    if Farm.PromptFocusBound then
        return
    end
    Farm.PromptFocusBound = true
    local service = game:GetService("ProximityPromptService")
    pcall(function()
        service.PromptShown:Connect(function(prompt)
            Farm.PromptFocusSeen = true
            Farm.PromptFocus = prompt
        end)
        service.PromptHidden:Connect(function(prompt)
            Farm.PromptFocusSeen = true
            if Farm.PromptFocus == prompt then
                Farm.PromptFocus = nil
            end
        end)
        -- Движок уже сработал - ставим метку, чтобы не выстрелить второй раз
        -- и не переключить тумблер обратно.
        service.PromptTriggered:Connect(function()
            Farm.PromptLastFire = os.clock()
        end)
    end)
end

function Farm.StartPromptAnywhere()
    if Farm.PromptAnywhereOn then
        return
    end
    Farm.PromptAnywhereOn = true
    Farm.PromptBindFocus()
    Farm.RefreshPromptCache()
    local ok, conn = pcall(function()
        return game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
            if not Farm.PromptAnywhereOn then
                return
            end
            -- Движок нажатие уже обработал (промпт был в фокусе) - не дублируем.
            if processed then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end
            -- Если сервис отдаёт фокус, доверяем ему полностью.
            if Farm.PromptFocusSeen and Farm.PromptFocus and Farm.PromptFocus.Parent then
                return
            end
            Farm.FirePromptKey(input.KeyCode)
        end)
    end)
    if ok then
        Farm.PromptAnywhereConn = conn
    end
    -- Двери и кнопки появляются по ходу игры, поэтому список обновляем по кругу.
    task.spawn(function()
        while Farm.PromptAnywhereOn do
            task.wait(3)
            if Farm.PromptAnywhereOn then
                Farm.RefreshPromptCache()
            end
        end
    end)
end

function Farm.StopPromptAnywhere()
    Farm.PromptAnywhereOn = false
    if Farm.PromptAnywhereConn then
        pcall(function()
            Farm.PromptAnywhereConn:Disconnect()
        end)
        Farm.PromptAnywhereConn = nil
    end
end

function Farm.StartDoor()
    if Farm.DoorRunning then
        return
    end
    Farm.DoorRunning = true
    Farm.DoorGen = (Farm.DoorGen or 0) + 1
    Farm.DoorNextAt = 0
    Farm.DoorCursor = 1
    -- Ноклип нужен на весь фарм: под картой иначе не пролететь, а наверху
    -- рут закреплён, чтобы персонаж не падал сквозь пол.
    pcall(function()
        Farm.SetNoclip(true)
    end)
    pcall(function()
        Farm.SetInstant(State.DoorInstant ~= false)
    end)
    -- На фарме всегда широкий обзор: 200 градусов через расширитель камеры.
    pcall(function()
        if Hub.Fov then
            Hub.Fov.value = 200
            Hub.Fov.setEnabled(true)
        end
    end)
    FarmReportFor("door", "door farm running")
    local gen = Farm.DoorGen
    task.spawn(function()
        DoorLoop(gen)
    end)
end

function Farm.StopDoor()
    Farm.DoorRunning = false
    -- Bumping the generation kills every loop that is still inside a task.wait,
    -- including duplicates left behind by an earlier injection.
    Farm.DoorGen = (Farm.DoorGen or 0) + 1
    pcall(function()
        Farm.SetNoclip(false)
    end)
    pcall(function()
        Farm.SetInstant(false)
    end)
    -- Фарм выключили - возвращаем камере её обычный угол.
    pcall(function()
        if Hub.Fov then
            Hub.Fov.reset()
        end
    end)
    FarmReportFor("door", "door farm stopped")
end

function Farm.StartCrystal()
    if Farm.CrystalRunning then
        return
    end
    Farm.CrystalRunning = true
    Farm.CrystalGen = (Farm.CrystalGen or 0) + 1
    Farm.CrystalNextAt = 0
    Farm.CrystalCursor = 1
    FarmReportFor("crystal", "crystal farm running")
    local gen = Farm.CrystalGen
    task.spawn(function()
        CrystalLoop(gen)
    end)
end

function Farm.StopCrystal()
    Farm.CrystalRunning = false
    Farm.CrystalGen = (Farm.CrystalGen or 0) + 1
    FarmReportFor("crystal", "crystal farm stopped")
end

--==========================================================================
-- Slender: страницы 1..12 + скип обби, одной функцией
--
-- Всё живёт в ОДНОЙ функции Farm.SlenderRun. Порядок:
--   1. включить ноклип
--   2. обойти страницы 1..12, между ними пауза 2с (State.SlenderPageDelay)
--   3. после последней страницы ноклип выключить
--   4. тп в пещеру, 5с ожидания (State.SlenderCaveDelay)
--   5. тп к слендермену
--
-- Страницы лежат по пути game:GetService("StarterGui").slenderman.<номер>.
-- На клиенте копия StarterGui живёт в PlayerGui, поэтому путь проверяется
-- сначала в PlayerGui, потом в StarterGui, а если там пусто - в мире
-- ищутся объекты Page1..Page12 / 1..12. Так фарм не ломается от того,
-- в какой из двух контейнеров игра положила листовки.
--
-- Взаимодействие сделано под оба устройства сразу, потому что на ПК и на
-- телефоне это разные вещи:
--   ProximityPrompt -> InputHoldBegin/InputHoldEnd (ровно то же, что делает
--                      и клавиша E, и тап по кнопке промпта на экране)
--   ClickDetector   -> fireclickdetector
--   GuiButton       -> firesignal по Activated / MouseButton1Click
--   касание         -> firetouchinterest
--==========================================================================

Farm.SlenderCave = Vector3.new(791.76, 693.89, -2141.13)
Farm.SlenderBoss = Vector3.new(949.59, 574.72, -2143.36)
Farm.SlenderRunning = false
Farm.SlenderGen = 0
Farm.SlenderFound = 0
Farm.SlenderDone = 0
Farm.SlenderMessage = "Idle"

Farm.SlenderStop = function()
    Farm.SlenderRunning = false
    Farm.SlenderGen = (Farm.SlenderGen or 0) + 1
    Farm.SlenderMessage = "stopped"
    FarmReport("slender stopped")
end

Farm.SlenderRun = function()
    if Farm.SlenderRunning then
        return
    end
    Farm.SlenderRunning = true
    Farm.SlenderGen = (Farm.SlenderGen or 0) + 1
    Farm.SlenderDone = 0
    local gen = Farm.SlenderGen
    local pageDelay = math.clamp(tonumber(State.SlenderPageDelay) or 2, 0.2, 30)
    local caveDelay = math.clamp(tonumber(State.SlenderCaveDelay) or 5, 0.2, 60)

    local function alive()
        return Farm.SlenderRunning and Farm.SlenderGen == gen
    end

    local function say(text)
        Farm.SlenderMessage = tostring(text)
        FarmReport(tostring(text))
    end

    -- Пауза, которую можно прервать: спим шагами по 0.1с и проверяем флаг.
    local function hold(seconds)
        local left = tonumber(seconds) or 0
        while left > 0 and alive() do
            local step = math.min(0.1, left)
            task.wait(step)
            left = left - step
        end
    end

    local function goTo(position)
        local root = FarmRoot()
        if not root or not position then
            return false
        end
        root.CFrame = CFrame.new(position)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    local function goToPart(part)
        local root = FarmRoot()
        if not root or not part then
            return false
        end
        root.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    local function partOf(object)
        if not object then
            return nil
        end
        if object:IsA("BasePart") then
            return object
        end
        local primary = nil
        pcall(function()
            primary = object.PrimaryPart
        end)
        if primary then
            return primary
        end
        for _, item in ipairs(object:GetDescendants()) do
            if item:IsA("BasePart") then
                return item
            end
        end
        return nil
    end

    -- Контейнер с листовками: PlayerGui -> StarterGui.
    local function pageContainer()
        local roots = {}
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            roots[#roots + 1] = playerGui
        end
        local starterGui = game:GetService("StarterGui")
        if starterGui then
            roots[#roots + 1] = starterGui
        end
        for _, root in ipairs(roots) do
            local direct = root:FindFirstChild("slenderman")
            if direct then
                return direct
            end
            for _, child in ipairs(root:GetChildren()) do
                if string.lower(tostring(child.Name)) == "slenderman" then
                    return child
                end
            end
        end
        return nil
    end

    local function pageByNumber(container, number)
        local wanted = tostring(number)
        for _, child in ipairs(container:GetChildren()) do
            local name = tostring(child.Name)
            if name == wanted then
                return child
            end
            local digits = string.match(name, "(%d+)")
            if digits and tonumber(digits) == number then
                return child
            end
        end
        return nil
    end

    local function collectPages()
        local list = {}
        local container = pageContainer()
        if container then
            for index = 1, 12 do
                local object = pageByNumber(container, index)
                if object then
                    list[index] = object
                end
            end
        end
        local missing = false
        for index = 1, 12 do
            if not list[index] then
                missing = true
                break
            end
        end
        if missing then
            -- Запасной проход по миру: Page1..Page12 или просто 1..12.
            local found = {}
            pcall(function()
                for _, object in ipairs(Workspace:GetDescendants()) do
                    local name = string.lower(tostring(object.Name))
                    local digits = string.match(name, "^pages?%s*(%d+)$")
                    if not digits then
                        digits = string.match(name, "^(%d+)$")
                    end
                    if digits then
                        local number = tonumber(digits)
                        if number and number >= 1 and number <= 12 and not found[number] then
                            found[number] = object
                        end
                    end
                end
            end)
            for index = 1, 12 do
                if not list[index] and found[index] then
                    list[index] = found[index]
                end
            end
        end
        return list
    end

    local function firePrompt(prompt)
        local previous = prompt.RequiresLineOfSight
        pcall(function()
            prompt.RequiresLineOfSight = false
        end)
        local started = pcall(function()
            prompt:InputHoldBegin()
        end)
        if started then
            local waitFor = tonumber(prompt.HoldDuration) or 0
            if waitFor > 0.4 then
                waitFor = 0.4
            end
            if waitFor > 0 then
                task.wait(waitFor)
            end
            pcall(function()
                prompt:InputHoldEnd()
            end)
        elseif type(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, prompt)
        end
        pcall(function()
            prompt.RequiresLineOfSight = previous
        end)
        return true
    end

    local function interact(object)
        if not object then
            return false
        end
        local prompts, detectors, buttons = {}, {}, {}
        local function consider(item)
            if item:IsA("ProximityPrompt") then
                prompts[#prompts + 1] = item
            elseif item:IsA("ClickDetector") then
                detectors[#detectors + 1] = item
            elseif item:IsA("GuiButton") then
                buttons[#buttons + 1] = item
            end
        end
        consider(object)
        for _, item in ipairs(object:GetDescendants()) do
            consider(item)
        end

        local fired = false
        for _, prompt in ipairs(prompts) do
            fired = firePrompt(prompt) or fired
        end
        for _, detector in ipairs(detectors) do
            if type(fireclickdetector) == "function" and pcall(fireclickdetector, detector) then
                fired = true
            end
        end
        for _, button in ipairs(buttons) do
            if type(firesignal) == "function" then
                pcall(firesignal, button.Activated)
                pcall(firesignal, button.MouseButton1Click)
                fired = true
            end
        end
        local root = FarmRoot()
        local part = partOf(object)
        if root and part and type(firetouchinterest) == "function" then
            pcall(firetouchinterest, root, part, 0)
            task.wait(0.05)
            pcall(firetouchinterest, root, part, 1)
            fired = true
        end
        return fired
    end

    task.spawn(function()
        local ok, err = pcall(function()
            local pages = collectPages()
            local total = 0
            for index = 1, 12 do
                if pages[index] then
                    total = total + 1
                end
            end
            Farm.SlenderFound = total
            say("pages found: " .. tostring(total) .. "/12")

            if total > 0 then
                Farm.SetNoclip(true)
                say("noclip on | walking pages")
                for index = 1, 12 do
                    if not alive() then
                        break
                    end
                    local page = pages[index]
                    if page and page.Parent then
                        local part = partOf(page)
                        if part then
                            goToPart(part)
                            task.wait(0.35)
                        end
                        interact(page)
                        Farm.SlenderDone = Farm.SlenderDone + 1
                        say("page " .. tostring(index) .. "/12 | taken " .. tostring(Farm.SlenderDone) .. "/" .. tostring(total))
                    else
                        say("page " .. tostring(index) .. " missing")
                    end
                    hold(pageDelay)
                end
                Farm.SetNoclip(false)
                say("pages done | noclip off")
            else
                say("no pages found | going to the obby")
            end

            if not alive() then
                return
            end

            goTo(Farm.SlenderCave)
            say("cave | waiting " .. tostring(caveDelay) .. "s")
            hold(caveDelay)
            if not alive() then
                return
            end

            goTo(Farm.SlenderBoss)
            say("slenderman | done " .. tostring(Farm.SlenderDone) .. "/12")
        end)

        Farm.SetNoclip(false)
        Farm.SlenderRunning = false
        if not ok then
            Farm.SlenderMessage = "error: " .. tostring(err)
            FarmReport(Farm.SlenderMessage)
        end
        State.SlenderRun = false
        if Gui and Gui.SlenderToggle then
            pcall(function()
                Gui.SlenderToggle:Set(false)
            end)
        end
    end)
end

-- Anti-AFK --------------------------------------------------------------------
-- Взято из QuantumOnyx: на каждый Idled сначала CaptureController, и только
-- потом клик. Если кликнуть до захвата контроллера, Roblox его не засчитывает
-- и всё равно выкидывает за неактивность.
function Farm.AntiAfkPoke()
    local ok = pcall(function()
        local virtualUser = game:GetService("VirtualUser")
        virtualUser:CaptureController()
        virtualUser:ClickButton2(Vector2.new(0, 0))
    end)
    if not ok then
        pcall(function()
            local virtualUser = game:GetService("VirtualUser")
            virtualUser:CaptureController()
            virtualUser:Button2Down(Vector2.new(0, 0))
            task.wait(0.1)
            virtualUser:Button2Up(Vector2.new(0, 0))
        end)
    end
    Farm.AntiAfkPokes = (Farm.AntiAfkPokes or 0) + 1
    Farm.AntiAfkLastAt = os.time()
end

function Farm.SetAntiAfk(enabled)
    if enabled then
        if Farm.AntiAfkConnection then
            return
        end
        Farm.AntiAfkConnection = LocalPlayer.Idled:Connect(function()
            Farm.AntiAfkPoke()
        end)
    else
        if Farm.AntiAfkConnection then
            Farm.AntiAfkConnection:Disconnect()
            Farm.AntiAfkConnection = nil
        end
    end
end

Hub.Farm = Farm

-- Auto items: Pumpkinspice on all-door cooldown + UpgradedBasket (2x drop) --------
-- Pumpkinspice is fired only when the door farm has walked the whole list, every
-- door answered with the "Trick OR Treat Cooldown" toast, and that toast was really
-- received from the server. UpgradedBasket is fired on a timer while it is enabled.
do
    local Items = {
        Remote = nil,
        Toast = nil,
        NextPumpkinAt = 0,
        NextBasketAt = 0,
        PumpkinUses = 0,
        BasketUses = 0,
        ToastCount = 0,
        ToastSeen = false,
        ToastAttached = false,
        LastToastText = "",
        LastToastAt = 0,
        PumpkinStatus = "idle",
        BasketStatus = "idle",
        NextPumpkinTimerAt = 0,
        PumpkinPasses = 0,
        PumpkinLastBy = "none",
        Listener = nil,
        Running = true,
        ReportToken = 0,
        Rewards = {
            Doors = 0,
            Shards = 0,
            Coupons = 0,
            VipCoupons = 0,
            CursedKeys = 0,
            Pumpkins = 0,
        },
    }

    Items.PumpkinItem = "Pumpkinspice"
    Items.BasketItem = "UpgradedBasket"

    -- Fixed internal cadence. No user setting: the coffee only fires on an
    -- all-door cooldown wave, the pumpkin fires whenever it is available.
    local PumpkinRetry = 2
    local BasketRetry = 2

    local function FindDeep(root, ...)
        local node = root
        for _, name in ipairs({ ... }) do
            if not node then
                return nil
            end
            node = node:FindFirstChild(name)
        end
        return node
    end

    -- RemoteEvent and UnreliableRemoteEvent both expose FireServer/OnClientEvent,
    -- so probe for the members instead of matching a class name.
    local function HasFireServer(obj)
        if not obj then
            return false
        end
        local ok, value = pcall(function()
            return obj.FireServer
        end)
        return ok and value ~= nil
    end

    local function HasOnClientEvent(obj)
        if not obj then
            return false
        end
        local ok, value = pcall(function()
            return obj.OnClientEvent
        end)
        return ok and value ~= nil
    end

    function Items.RefreshRemotes()
        local useItem = FindDeep(ReplicatedStorage, "UseItem")
        if HasFireServer(useItem) then
            Items.Remote = useItem
        else
            Items.Remote = nil
        end

        local toast = FindDeep(ReplicatedStorage, "Toasts", "Assets", "Remotes", "Display")
        if HasOnClientEvent(toast) then
            Items.Toast = toast
        else
            Items.Toast = nil
        end
        return Items.Remote, Items.Toast
    end

    local function Fire(itemName)
        if not HasFireServer(Items.Remote) then
            Items.RefreshRemotes()
        end
        if not HasFireServer(Items.Remote) then
            return false, "UseItem remote not found"
        end
        local ok, err = pcall(function()
            Items.Remote:FireServer(itemName)
        end)
        if not ok then
            return false, tostring(err)
        end
        return true, nil
    end

    --==========================================================================
    -- Pumpkinspice (он же «кофе»)
    -- Три независимых условия, каждое включается отдельно:
    --   1) все точки на кулдауне  - старое поведение;
    --   2) таймер от 1 до 30 минут;
    --   3) маршрут по точкам пройден N раз (по умолчанию 2).
    -- Кто сработал первым, тот и использует; после использования таймер и
    -- счётчик проходов начинаются заново, иначе условия били бы подряд.
    --==========================================================================

    function Items.PumpkinInterval()
        local minutes = tonumber(State.PumpkinMinutes) or 10
        return math.clamp(math.floor(minutes), 1, 30) * 60
    end

    function Items.ArmPumpkinTimer()
        Items.NextPumpkinTimerAt = tick() + Items.PumpkinInterval()
    end

    function Items.UsePumpkinspice(reason)
        local ok, err = Fire(Items.PumpkinItem)
        local now = tick()
        if ok then
            Items.PumpkinUses = Items.PumpkinUses + 1
            Items.PumpkinLastBy = tostring(reason or "manual")
            Items.NextPumpkinTimerAt = now + Items.PumpkinInterval()
            Items.PumpkinPasses = 0
            Items.PumpkinStatus = string.format("used x%d via %s", Items.PumpkinUses, Items.PumpkinLastBy)
        else
            Items.PumpkinStatus = tostring(err)
        end
        return ok, err
    end

    -- Зовётся из дверного цикла, когда курсор обернулся через весь список.
    function Items.NoteDoorPass()
        if not State.Pumpkinspice or not State.PumpkinByRoute then
            Items.PumpkinPasses = 0
            return
        end
        Items.PumpkinPasses = Items.PumpkinPasses + 1
        local need = math.clamp(math.floor(tonumber(State.PumpkinRoutePasses) or 2), 1, 10)
        if Items.PumpkinPasses >= need then
            Items.UsePumpkinspice("route")
        end
    end

    function Items.UseBasket()
        local ok, err = Fire(Items.BasketItem)
        if ok then
            Items.BasketUses = Items.BasketUses + 1
            Items.BasketStatus = "used x" .. tostring(Items.BasketUses)
        else
            Items.BasketStatus = tostring(err)
        end
        return ok, err
    end

    -- The cooldown toast carries no door name, so it only proves the server rejected
    -- a door. "Every door" comes from the farm: it walked the full list and each
    -- entry was still cooling down.
    local function IsCooldownToast(data)
        if type(data) ~= "table" then
            return false
        end
        local title = string.lower(tostring(data.Title or ""))
        local content = string.lower(tostring(data.ContentText or data.Content or ""))
        if title:find("cooldown", 1, true) then
            return true
        end
        if content:find("on cooldown", 1, true) then
            return true
        end
        if content:find("try again later", 1, true) then
            return true
        end
        return false
    end

    -- A door that actually opened means the cooldown wave is over.
    function Items.NoteDoorOpened()
        Items.ToastSeen = false
    end

    function Items.AllDoorsCooling()
        if (Farm.DoorCount or 0) <= 0 then
            return false
        end
        if not Farm.AllDoorsCooling then
            return false
        end
        if tick() - (Farm.AllDoorsCoolingAt or 0) > 120 then
            return false
        end
        return Items.ToastSeen == true
    end

    function Items.Stop()
        Items.Running = false
    end

    -- The number that belongs to a keyword is the closest one before it, so
    -- "Wave 3! +50 Crystals" yields 50 and not 3.
    local function NumberNear(text, keyword)
        local start = text:find(keyword, 1, true)
        if not start then
            return nil
        end
        local before = text:sub(1, start - 1)
        local last = nil
        for digits in before:gmatch("(%d[%d,]*)") do
            last = digits
        end
        if last then
            local cleaned = last:gsub(",", "")
            local value = tonumber(cleaned)
            if value then
                return value
            end
        end
        local digits = text:sub(start):match("(%d[%d,]*)")
        if digits then
            local cleaned = digits:gsub(",", "")
            return tonumber(cleaned)
        end
        return nil
    end

    -- Door reward toasts have no fixed wording: any message that mentions the
    -- keyword counts, and every reward named in it is added.
    function Items.ParseReward(text)
        local lower = string.lower(tostring(text or ""))
        if lower == "" then
            return nil
        end

        local hits = {}
        if lower:find("coupon", 1, true) then
            -- "Premium Upgrade Coupon" is the in-game premium coupon.
            if lower:find("premium", 1, true) or lower:find("vip", 1, true) then
                hits[#hits + 1] = { "VipCoupons", "coupon" }
            else
                hits[#hits + 1] = { "Coupons", "coupon" }
            end
        end
        if lower:find("cursed", 1, true) then
            hits[#hits + 1] = { "CursedKeys", "cursed" }
        elseif lower:find("%f[%a]keys?%f[%A]") then
            hits[#hits + 1] = { "CursedKeys", "key" }
        end
        -- The game calls the shards "Crystals".
        if lower:find("crystal", 1, true) then
            hits[#hits + 1] = { "Shards", "crystal" }
        elseif lower:find("shard", 1, true) then
            hits[#hits + 1] = { "Shards", "shard" }
        end
        -- The game calls the pumpkins "Jacks".
        if lower:find("%f[%a]jacks?%f[%A]") then
            hits[#hits + 1] = { "Pumpkins", "jack" }
        elseif lower:find("pumpkin", 1, true) then
            hits[#hits + 1] = { "Pumpkins", "pumpkin" }
        end

        if #hits == 0 then
            return nil
        end

        local firstKind, firstAmount = nil, nil
        for _, hit in ipairs(hits) do
            local amount = NumberNear(lower, hit[2]) or 1
            if amount <= 0 then
                amount = 1
            end
            Items.Rewards[hit[1]] = (Items.Rewards[hit[1]] or 0) + amount
            if not firstKind then
                firstKind, firstAmount = hit[1], amount
            end
        end
        return firstKind, firstAmount
    end

    function Items.SendRewardReport()
        if not State.DoorRewards then
            return false
        end
        local r = Items.Rewards
        local lines = {
            "**Doors opened:** " .. tostring(r.Doors or 0),
            "**Crystals:** " .. tostring(r.Shards or 0),
            "**Coupons:** " .. tostring(r.Coupons or 0),
            "**Premium Coupons:** " .. tostring(r.VipCoupons or 0),
            "**Cursed Keys:** " .. tostring(r.CursedKeys or 0),
            "**Jacks:** " .. tostring(r.Pumpkins or 0),
        }
        return SendDiscordWebhook("Door Opened - Farm Totals", table.concat(lines, "\n"), 16753920)
    end

    function Items.NoteDoorOpenedReward()
        Items.Rewards.Doors = (Items.Rewards.Doors or 0) + 1
        local token = (Items.ReportToken or 0) + 1
        Items.ReportToken = token
        task.delay(1.5, function()
            if Items.ReportToken ~= token then
                return
            end
            pcall(Items.SendRewardReport)
        end)
    end

    local function OnToast(data)
        if type(data) ~= "table" then
            return
        end
        local content = tostring(data.ContentText or data.Content or "")
        if IsCooldownToast(data) then
            Items.LastToastText = content
            Farm.LastToastAt = tick()
            -- Only react while the door farm is actually running.
            if not Farm.DoorRunning then
                return
            end
            Items.ToastSeen = true
            Items.ToastCount = Items.ToastCount + 1
            Items.LastToastAt = tick()
            Farm.DoorCooldownHit = true
            Farm.DoorCooldownHitAt = tick()
            return
        end
        -- Any other toast is a reaction from the door: it proves the prompt fired.
        Farm.LastToastAt = tick()
        if not State.DoorRewards then
            return
        end
        Items.ParseReward(tostring(data.Title or "") .. " " .. content)
    end

    local function AttachToast()
        if Items.ToastAttached and HasOnClientEvent(Items.Toast) then
            return true
        end
        Items.RefreshRemotes()
        if not HasOnClientEvent(Items.Toast) then
            Items.ToastAttached = false
            return false
        end
        local connected = pcall(function()
            Items.Toast.OnClientEvent:Connect(function(data)
                pcall(OnToast, data)
            end)
        end)
        Items.ToastAttached = connected == true
        return Items.ToastAttached
    end

    local function ResetDoorCycle()
        for name in pairs(Farm.DoorVisited) do
            Farm.DoorVisited[name] = nil
        end
        Farm.AllDoorsCooling = false
        Farm.AllDoorsCoolingAt = 0
        Farm.DoorNextAt = 0
        Items.ToastSeen = false
    end

    local function Loop()
        local nextAttach = 0
        local nextPaint = 0
        while Items.Running do
            task.wait(0.5)
            local now = tick()

            if not Items.ToastAttached and now >= nextAttach then
                nextAttach = now + 2
                AttachToast()
            end

            if State.Pumpkinspice then
                local reason = nil

                -- 1) Таймер: от 1 до 30 минут, отсчёт от последнего использования.
                if State.PumpkinTimer then
                    if Items.NextPumpkinTimerAt == 0 then
                        Items.ArmPumpkinTimer()
                    elseif now >= Items.NextPumpkinTimerAt then
                        reason = "timer"
                    end
                end

                -- 2) Старое условие: все точки на кулдауне.
                if not reason
                    and State.PumpkinOnCooldown
                    and now >= Items.NextPumpkinAt
                    and Items.AllDoorsCooling()
                then
                    reason = "cooldown"
                end

                if reason then
                    Items.NextPumpkinAt = now + PumpkinRetry
                    Items.UsePumpkinspice(reason)
                    if State.PumpkinspiceReset then
                        ResetDoorCycle()
                    end
                end
            end

            if State.Basket and now >= Items.NextBasketAt then
                Items.NextBasketAt = now + BasketRetry
                Items.UseBasket()
            end

            if now >= nextPaint then
                nextPaint = now + 1
                if type(Items.Listener) == "function" then
                    pcall(Items.Listener)
                end
            end
        end
    end

    task.defer(function()
        pcall(Items.RefreshRemotes)
        pcall(AttachToast)
        task.spawn(Loop)
    end)

    Hub.Items = Items
end


-- Crates + stock reader --------------------------------------------------------
-- The crate buttons and the stock cards are discovered at runtime instead of
-- being hardcoded: the shop rebuilds its frames on every open and the hierarchy
-- names shift between game updates. Everything here is pcall-guarded because the
-- shop is rebuilt while we are walking it.
do
    local Crates = {
        Status = "idle",
        StockStatus = "idle",
        Stock = {},
        StockUpdatedAt = 0,
        Opens = 0,
        AutoRunning = false,
        AutoToken = 0,
        AutoRefresh = false,
        AutoRefreshToken = 0,
        NextAutoAt = 0,
        LastKind = "cursed",
        LastClickMethod = "none",
        Confirm = { "open", "unlock", "открыть" },
        RarityOrder = {
            "secret", "extraordinary", "celestial", "divine", "godly", "mythic",
            "legendary", "exclusive", "ancient", "epic", "rare", "uncommon", "common",
        },
        Listener = nil,
    }

    local VimService = nil

    local function Report(text)
        Crates.Status = tostring(text)
        if type(Crates.Listener) == "function" then
            pcall(Crates.Listener, Crates.Status)
        end
    end

    local function PlayerGuiOf()
        local player = Players.LocalPlayer
        if not player then
            return nil
        end
        return player:FindFirstChild("PlayerGui")
    end

    local function ReadText(obj)
        if not obj then
            return nil
        end
        local ok, value = pcall(function()
            return obj.Text
        end)
        if ok and type(value) == "string" and value ~= "" then
            return value
        end
        return nil
    end

    -- Name + first few label texts, lowercased, used for keyword matching.
    local function Blob(obj, limit)
        local parts = { string.lower(tostring(obj.Name)) }
        local count = 0
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                local text = ReadText(child)
                if text then
                    table.insert(parts, string.lower(text))
                    count = count + 1
                    if count >= (limit or 6) then
                        break
                    end
                end
            end
        end
        return table.concat(parts, " ")
    end

    local function Clickable(obj)
        if not obj then
            return false
        end
        local ok, isButton = pcall(function()
            return obj:IsA("GuiButton")
        end)
        if not ok or not isButton then
            return false
        end
        local okSize, usable = pcall(function()
            return obj.Visible and obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0
        end)
        return okSize and usable
    end

    -- Existing connections first (they prove the handler exists), then
    -- firesignal, then a synthetic mouse click at the button centre.
    function Crates.Click(button)
        if not button then
            return false, "no button"
        end
        if type(getconnections) == "function" then
            local ok, connections = pcall(getconnections, button.MouseButton1Click)
            if ok and type(connections) == "table" and #connections > 0 then
                local fired = 0
                for _, connection in ipairs(connections) do
                    local done = pcall(function()
                        connection:Fire()
                    end)
                    if done then
                        fired = fired + 1
                    end
                end
                if fired > 0 then
                    Crates.LastClickMethod = "connection"
                    return true, Crates.LastClickMethod
                end
            end
        end
        if type(firesignal) == "function" then
            local ok = pcall(firesignal, button.MouseButton1Click)
            if ok then
                Crates.LastClickMethod = "firesignal"
                return true, Crates.LastClickMethod
            end
        end
        if not VimService then
            local ok, service = pcall(function()
                return game:GetService("VirtualInputManager")
            end)
            if ok then
                VimService = service
            end
        end
        if VimService then
            local ok = pcall(function()
                local position = button.AbsolutePosition
                local size = button.AbsoluteSize
                local x = position.X + size.X / 2
                local y = position.Y + size.Y / 2
                pcall(function()
                    VimService:SendMouseMoveEvent(x, y, game)
                end)
                VimService:SendMouseButtonEvent(x, y, 0, true, game, 1)
                task.wait(0.02)
                VimService:SendMouseButtonEvent(x, y, 0, false, game, 1)
            end)
            if ok then
                Crates.LastClickMethod = "virtual"
                return true, Crates.LastClickMethod
            end
        end
        return false, "no click method"
    end

    function Crates.FindButton(kind)
        local root = PlayerGuiOf()
        if not root then
            return nil, 0
        end
        local needle = string.lower(tostring(kind))
        local best, bestScore = nil, 0
        for _, obj in ipairs(root:GetDescendants()) do
            if Clickable(obj) then
                local blob = Blob(obj)
                if string.find(blob, needle, 1, true) then
                    local score = 1
                    if string.find(string.lower(tostring(obj.Name)), needle, 1, true) then
                        score = score + 4
                    end
                    if string.find(blob, "crate", 1, true) then
                        score = score + 3
                    end
                    if string.find(blob, "open", 1, true) or string.find(blob, "unlock", 1, true) then
                        score = score + 2
                    end
                    if score > bestScore then
                        best, bestScore = obj, score
                    end
                end
            end
        end
        return best, bestScore
    end

    -- The panel that pops up after the crate is picked usually carries its own
    -- Open / Unlock button; skip the crate button we just pressed. A button that
    -- names the other crate, or that lives outside a panel mentioning this one,
    -- is never clicked - a wrong "Open" is worse than no confirm at all.
    function Crates.FindConfirm(kind, exclude)
        local root = PlayerGuiOf()
        if not root then
            return nil
        end
        local needle = string.lower(tostring(kind))
        local other = (needle == "cursed") and "diamond" or "cursed"
        local best, bestScore = nil, 0
        local generic, genericCount = nil, 0
        for _, obj in ipairs(root:GetDescendants()) do
            if obj ~= exclude and Clickable(obj) then
                local blob = Blob(obj)
                local wanted = false
                for _, word in ipairs(Crates.Confirm) do
                    if string.find(blob, word, 1, true) then
                        wanted = true
                        break
                    end
                end
                if wanted and not string.find(blob, other, 1, true) then
                    local score = 0
                    if string.find(blob, needle, 1, true) then
                        score = 6
                    end
                    local node = obj.Parent
                    local depth = 0
                    while node and node ~= root and depth < 5 do
                        if string.find(string.lower(tostring(node.Name)), needle, 1, true) then
                            score = score + 4
                            break
                        end
                        depth = depth + 1
                        node = node.Parent
                    end
                    if score > bestScore then
                        best, bestScore = obj, score
                    end
                    if score == 0 then
                        genericCount = genericCount + 1
                        generic = obj
                    end
                end
            end
        end
        if best then
            return best
        end
        -- No crate-specific panel: accept a single unambiguous Open button.
        if genericCount == 1 then
            return generic
        end
        return nil
    end

    -- Real crate names as the server expects them. The captured call was
    -- ReplicatedStorage.NotGambling:FireServer(3, "Golden") - only the second
    -- argument changes between crates, the first one is the amount.
    -- The side buttons are named Cursed / MegaDiamond, so the ids follow them.
    Crates.Names = {
        cursed = "Cursed",
        diamond = "MegaDiamond",
        megadiamond = "MegaDiamond",
        mega = "MegaDiamond",
        golden = "Golden",
    }

    -- Side buttons that switch which crate the shared stock panel shows.
    Crates.ButtonPath = {
        cursed = "PlayerGui.Main.Frame.Layout.ShardGamba.Frame.Side.Boxes.Cursed",
        diamond = "PlayerGui.Main.Frame.Layout.ShardGamba.Frame.Side.Boxes.MegaDiamond",
        golden = "PlayerGui.Main.Frame.Layout.ShardGamba.Frame.Side.Boxes.Golden",
    }

    -- Dotted path from the Explorer, with or without PlayerGui in front.
    function Crates.Resolve(path)
        local gui = PlayerGuiOf()
        if not gui then
            return nil
        end
        local node = gui
        local ok = pcall(function()
            for part in string.gmatch(tostring(path), "[^%.]+") do
                if node and string.lower(part) ~= "playergui" then
                    node = node:FindFirstChild(part)
                end
            end
        end)
        if ok and node then
            return node
        end
        return nil
    end

    -- Switches the shared panel to that crate. Needed because the stock panel
    -- keeps showing the previous crate until its side button is pressed.
    function Crates.Select(kind)
        kind = string.lower(tostring(kind or ""))
        local path = Crates.ButtonPath[kind]
        if not path then
            return false, "unknown crate: " .. kind
        end
        local button = Crates.Resolve(path)
        if not button then
            return false, "crate button not found - open the crate shop"
        end
        local ok, how = Crates.Click(button)
        if not ok then
            return false, "click failed: " .. tostring(how)
        end
        return true, kind
    end

    function Crates.SelectAndScan(kind)
        local ok, message = Crates.Select(kind)
        if not ok then
            Report(tostring(message))
            return false, tostring(message)
        end
        task.wait(0.45)
        pcall(Crates.ScanStock)
        Report(string.format("showing %s | %d cards", tostring(kind), #(Crates.Stock or {})))
        return true, Crates.Status
    end

    function Crates.Remote()
        local ok, remote = pcall(function()
            return ReplicatedStorage:FindFirstChild("NotGambling", true)
        end)
        if ok and remote then
            local okFire, hasFire = pcall(function()
                return remote.FireServer
            end)
            if okFire and hasFire then
                return remote
            end
        end
        return nil
    end

    function Crates.Fire(kind, count)
        local remote = Crates.Remote()
        if not remote then
            return false, "NotGambling remote not found"
        end
        local name = Crates.Names[string.lower(tostring(kind))] or tostring(kind)
        local amount = math.clamp(math.floor(tonumber(count) or 3), 1, 100)
        local ok, err = pcall(function()
            remote:FireServer(amount, name)
        end)
        if not ok then
            return false, tostring(err)
        end
        return true, name, amount
    end

    function Crates.Open(kind)
        kind = string.lower(tostring(kind or "cursed"))
        Crates.LastKind = kind

        local fired, name, amount = Crates.Fire(kind, State.CrateAmount)
        if fired then
            Crates.Opens = Crates.Opens + 1
            Crates.LastClickMethod = "remote"
            Report(string.format("NotGambling(%d, %q) #%d", amount, name, Crates.Opens))
            return true, Crates.Status
        end

        -- Fallback only: if the remote ever gets renamed, click the GUI instead.
        local button = Crates.Resolve(Crates.ButtonPath[kind] or "") or Crates.FindButton(kind)
        if not button then
            Report(tostring(name) .. " | no remote, no crate button on screen")
            return false, Crates.Status
        end
        local clicked, how = Crates.Click(button)
        if not clicked then
            Report("click failed: " .. tostring(how))
            return false, Crates.Status
        end
        task.wait(0.35)
        local confirm = Crates.FindConfirm(kind, button)
        if confirm then
            Crates.Click(confirm)
            task.wait(0.15)
        end
        Crates.Opens = Crates.Opens + 1
        Report(string.format("clicked %s #%d (remote missing)", kind, Crates.Opens))
        return true, Crates.Status
    end

    function Crates.Kinds()
        local kinds = {}
        if State.CrateCursed then
            table.insert(kinds, "cursed")
        end
        if State.CrateDiamond then
            table.insert(kinds, "diamond")
        end
        return kinds
    end

    function Crates.SetAuto(enabled)
        Crates.AutoRunning = enabled == true
        Crates.AutoToken = Crates.AutoToken + 1
        if not Crates.AutoRunning then
            Crates.NextAutoAt = 0
            Report("auto off")
            return
        end
        local token = Crates.AutoToken
        Report("auto on")
        task.spawn(function()
            while Crates.AutoRunning and Crates.AutoToken == token do
                local kinds = Crates.Kinds()
                if #kinds == 0 then
                    Report("auto on - no crate ticked")
                    task.wait(1)
                else
                    for _, kind in ipairs(kinds) do
                        if not Crates.AutoRunning or Crates.AutoToken ~= token then
                            break
                        end
                        pcall(Crates.Open, kind)
                        task.wait(0.5)
                    end
                    local delay = math.clamp(tonumber(State.CrateInterval) or 5, 1, 120)
                    Crates.NextAutoAt = tick() + delay
                    local spent = 0
                    while Crates.AutoRunning and Crates.AutoToken == token and spent < delay do
                        task.wait(0.2)
                        spent = spent + 0.2
                    end
                    Crates.NextAutoAt = 0
                end
            end
        end)
    end

    local function RarityOf(text)
        if type(text) ~= "string" or text == "" then
            return nil
        end
        local lower = string.lower(text)
        for _, word in ipairs(Crates.RarityOrder) do
            if string.find(lower, word, 1, true) then
                return word
            end
        end
        return nil
    end

    local function RarityRank(word)
        for index, value in ipairs(Crates.RarityOrder) do
            if value == word then
                return index
            end
        end
        return #Crates.RarityOrder + 1
    end

    -- Item is a TextLabel in the current build, but it was a Frame with a Text
    -- child before - read the label directly, then fall back to its descendants.
    local function DeepText(obj)
        if not obj then
            return nil
        end
        local direct = ReadText(obj)
        if direct then
            return direct
        end
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("TextLabel") then
                local text = ReadText(child)
                if text then
                    return text
                end
            end
        end
        return nil
    end

    local CrateWords = { "diamond", "cursed", "golden" }

    -- The stock panel is a single shared frame whose contents are swapped when a
    -- different crate is picked, so there is no per-crate tree to walk. Real path
    -- from the Explorer:
    --   Main.Frame.Layout.ShardGamba.Frame.Grid.Roll.<Rarity>.Item
    --   Main.Frame.Layout.ShardGamba.Frame.Grid.Roll.Best.<Rarity>.Item
    Crates.DefaultPath = "PlayerGui.Main.Frame.Layout.ShardGamba.Frame.Grid.Roll"

    -- Which crate a card belongs to: the nearest ancestor whose name mentions it.
    -- The scan root itself counts, so a path ending in "...DiamondStock" tags
    -- everything below it as diamond.
    local function CrateOf(obj, root)
        local node = obj
        local depth = 0
        while node and depth < 12 do
            local lower = string.lower(tostring(node.Name))
            for _, word in ipairs(CrateWords) do
                if string.find(lower, word, 1, true) then
                    return word
                end
            end
            if node == root then
                break
            end
            depth = depth + 1
            node = node.Parent
        end
        return "unknown"
    end

    -- Two passes: first "Golden Crate" / "Crate: Diamond" / a bare "Golden", then
    -- any mention at all. The strict pass exists because unit names can contain a
    -- crate word ("Golden Speaker") and must not decide the label.
    local function ScanForCrateWord(node, budget)
        local texts = {}
        local seen = 0
        pcall(function()
            for _, obj in ipairs(node:GetDescendants()) do
                seen = seen + 1
                if seen > budget then
                    break
                end
                if obj:IsA("TextLabel") then
                    local text = ReadText(obj)
                    if text then
                        table.insert(texts, text)
                    end
                end
            end
        end)
        for _, text in ipairs(texts) do
            local lower = string.lower(text)
            for _, word in ipairs(CrateWords) do
                if lower == word
                    or string.find(lower, word .. " crate", 1, true)
                    or string.find(lower, "crate " .. word, 1, true)
                    or string.find(lower, "crate: " .. word, 1, true) then
                    return word
                end
            end
        end
        for _, text in ipairs(texts) do
            local lower = string.lower(text)
            for _, word in ipairs(CrateWords) do
                if string.find(lower, word, 1, true) then
                    return word
                end
            end
        end
        return nil
    end

    -- The panel itself usually says which crate is selected. Look inside the roll
    -- list first, then in its grandparent (ShardGamba.Frame).
    function Crates.DetectCrate(root)
        local found = ScanForCrateWord(root, 400)
        if found then
            return found
        end
        local scope = root.Parent and root.Parent.Parent
        if scope then
            found = ScanForCrateWord(scope, 4000)
        end
        return found or "unknown"
    end

    -- Fixed path, no UI knob: Main.Frame.Layout.ShardGamba.Frame.Grid.Roll.
    -- Falls back to the whole PlayerGui if the game ever renames the frame.
    function Crates.ScanRoot()
        local gui = PlayerGuiOf()
        if not gui then
            return nil, "PlayerGui not found"
        end
        local node = Crates.Resolve(Crates.DefaultPath)
        if node then
            return node, Crates.DefaultPath
        end
        return gui, "whole PlayerGui"
    end

    -- Stock layout, straight from the Explorer:
    --   Secret            <- GuiObject, the rarity is in its NAME
    --     UICorner / UIGradient / UIStroke / Morestroke
    --     Icon
    --     Chance          <- TextLabel, drop chance
    --     Item            <- TextLabel, the unit name
    --     Pity            <- TextLabel
    -- Older layouts put the name one level deeper (Item -> Text), so both read.
    function Crates.ScanStock()
        local list, seen = {}, {}
        local root, rootLabel = Crates.ScanRoot()
        if not root then
            Crates.Stock = {}
            Crates.StockStatus = tostring(rootLabel)
            Crates.StockUpdatedAt = tick()
            return list
        end

        -- One label for the whole scan: the panel is shared, so every card on
        -- screen belongs to whichever crate is selected right now.
        local crateLabel = Crates.DetectCrate(root)
        Crates.DetectedCrate = crateLabel

        local function push(unitName, rarity, crate, chance, pity)
            if type(unitName) ~= "string" or unitName == "" then
                return
            end
            local key = string.lower(unitName) .. "|" .. tostring(rarity) .. "|" .. tostring(crate)
            if seen[key] then
                return
            end
            seen[key] = true
            table.insert(list, {
                Name = unitName,
                Rarity = rarity or "unknown",
                Rank = RarityRank(rarity),
                Crate = crate or "unknown",
                Chance = chance,
                Pity = pity,
            })
        end

        for _, obj in ipairs(root:GetDescendants()) do
            local okGui, isGui = pcall(function()
                return obj:IsA("GuiObject")
            end)
            if okGui and isGui then
                -- Layout A: the card is named after the rarity and holds Item/Chance/Pity.
                -- The name does not have to be in RarityOrder: a frame with an Item
                -- label plus Chance/Pity is a stock card no matter what tier it is,
                -- so a rarity added by a future update still gets listed.
                local itemLabel = obj:FindFirstChild("Item")
                local chanceLabel = obj:FindFirstChild("Chance")
                local pityLabel = obj:FindFirstChild("Pity")
                if itemLabel and (RarityOf(obj.Name) or chanceLabel or pityLabel) then
                    local unitName = DeepText(itemLabel)
                    if unitName then
                        local cardRarity = RarityOf(obj.Name) or string.lower(tostring(obj.Name))
                        local crate = crateLabel
                        if crate == "unknown" then
                            crate = CrateOf(obj, root)
                        end
                        push(unitName, cardRarity, crate,
                            ReadText(chanceLabel),
                            ReadText(pityLabel))
                    end
                end

                -- Layout B: the card itself is named Item; the rarity sits around it.
                if string.lower(tostring(obj.Name)) == "item" then
                    local unitName = DeepText(obj)
                    if unitName then
                        local rarity = nil
                        local node = obj.Parent
                        local depth = 0
                        while node and node ~= root and depth < 3 and not rarity do
                            rarity = RarityOf(node.Name)
                            if not rarity then
                                for _, sibling in ipairs(node:GetChildren()) do
                                    if sibling:IsA("TextLabel") then
                                        rarity = RarityOf(ReadText(sibling))
                                        if rarity then
                                            break
                                        end
                                    end
                                end
                            end
                            depth = depth + 1
                            node = node.Parent
                        end
                        local holder = obj.Parent
                        -- Only when a known rarity was found: otherwise layout A has
                        -- already listed this card and a second "unknown" copy would
                        -- just show up as a duplicate line.
                        if rarity then
                            local crate = crateLabel
                            if crate == "unknown" then
                                crate = CrateOf(obj, root)
                            end
                            push(unitName, rarity, crate,
                                holder and ReadText(holder:FindFirstChild("Chance")) or nil,
                                holder and ReadText(holder:FindFirstChild("Pity")) or nil)
                        end
                    end
                end
            end
        end

        table.sort(list, function(a, b)
            if a.Rank ~= b.Rank then
                return a.Rank < b.Rank
            end
            return string.lower(a.Name) < string.lower(b.Name)
        end)

        Crates.Stock = list
        Crates.StockUpdatedAt = tick()
        Crates.StockSource = tostring(rootLabel)
        if #list == 0 then
            Crates.StockStatus = "0 cards - open the crate shop first"
        else
            local hidden = 0
            local floor = RarityRank("legendary")
            local topOnly = State.CrateTopOnly ~= false
            for _, entry in ipairs(list) do
                if topOnly and entry.Rank > floor then
                    hidden = hidden + 1
                end
            end
            Crates.StockStatus = string.format("%d cards%s", #list,
                hidden > 0 and string.format(" | %d hidden", hidden) or "")
        end
        if type(Crates.Listener) == "function" then
            pcall(Crates.Listener, Crates.Status)
        end
        return list
    end

    -- Legendary..Secret view. The panel is shared between crates, so the list is
    -- always "whatever the selected crate shows right now".
    function Crates.StockLines(limit)
        local lines = {}
        local topOnly = State.CrateTopOnly ~= false
        local floor = RarityRank("legendary")
        for _, entry in ipairs(Crates.Stock) do
            local show = true
            if topOnly then
                show = entry.Rank <= floor
            end
            if show then
                local label = string.upper(string.sub(entry.Rarity, 1, 1)) .. string.sub(entry.Rarity, 2)
                local extra = ""
                if entry.Chance and entry.Chance ~= "" then
                    extra = "  (" .. entry.Chance .. ")"
                end
                table.insert(lines, label .. " - " .. entry.Name .. extra)
                if limit and #lines >= limit then
                    break
                end
            end
        end
        if #lines == 0 then
            if #Crates.Stock == 0 then
                return "nothing found - open the crate shop, then press Scan Stock"
            end
            return "nothing in stock"
        end
        return table.concat(lines, "\n")
    end

    function Crates.SetAutoRefresh(enabled)
        Crates.AutoRefresh = enabled == true
        Crates.AutoRefreshToken = Crates.AutoRefreshToken + 1
        if not Crates.AutoRefresh then
            return
        end
        local token = Crates.AutoRefreshToken
        task.spawn(function()
            while Crates.AutoRefresh and Crates.AutoRefreshToken == token do
                pcall(Crates.ScanStock)
                task.wait(math.clamp(tonumber(State.CrateRefreshSeconds) or 10, 3, 120))
            end
        end)
    end

    -- Writes every text node of PlayerGui to a file and the clipboard. Used to
    -- map the real shop hierarchy when the generic scan misses something.
    function Crates.DumpStock()
        local root = PlayerGuiOf()
        if not root then
            return "PlayerGui not found"
        end
        local lines = { "# PlayerGui text dump " .. os.date("%Y-%m-%d %H:%M:%S") }
        for _, obj in ipairs(root:GetDescendants()) do
            local text = ReadText(obj)
            if text then
                local parts = {}
                local node = obj.Parent
                while node and node ~= root and #parts < 4 do
                    table.insert(parts, 1, node.Name)
                    node = node.Parent
                end
                table.insert(lines, string.format("%s.%s = %q",
                    table.concat(parts, "."), obj.Name, text))
            end
        end
        local body = table.concat(lines, "\n")
        if type(writefile) == "function" then
            pcall(writefile, "SkibidiDefense_GuiDump.txt", body)
        end
        if type(setclipboard) == "function" then
            pcall(setclipboard, body)
        end
        return string.format("%d text nodes saved + copied", #lines - 1)
    end

    Hub.Crates = Crates
end


-- Auto skip --------------------------------------------------------------------
-- The reward / battle pass / quest screens all expose a button whose name starts
-- with "Skip". Paths from the Explorer:
--   BattlePass.Skip1 / Skip5 / Skip10
--   LootboxReward.Skip, ShardReward.Skip
--   Main.Frame.Layout.Daily.Skip
--   Main.Frame.Layout.QuestsRevamp.Alpha.Quests.Quests.<n>.Skip
--   Quests.Frame.Quest.QuestBG.SkipQuest
-- They are found by name every tick, so a rebuilt screen is picked up again.
do
    local Skip = {
        Enabled = false,
        IncludeBattlePass = false,
        Status = "off",
        Clicks = 0,
        LastPath = "",
        LastAt = 0,
        Token = 0,
        Listener = nil,
        Seen = setmetatable({}, { __mode = "k" }),
        Cadence = 0.05,
        Cooldown = 0.2,
    }

    local function Report(text)
        Skip.Status = tostring(text)
        if type(Skip.Listener) == "function" then
            pcall(Skip.Listener, Skip.Status)
        end
    end

    -- Skip1 / Skip5 / Skip10 live in the battle pass and may spend currency, so
    -- they stay opt-in. Everything else starting with "skip" is fair game.
    function Skip.Matches(name)
        if type(name) ~= "string" or name == "" then
            return false
        end
        local lower = string.lower(name)
        if string.find(lower, "skip", 1, true) ~= 1 then
            return false
        end
        if string.match(lower, "^skip%d+$") then
            return Skip.IncludeBattlePass
        end
        return true
    end

    -- Only visible branches are walked: most of PlayerGui is hidden panels, and
    -- pruning them is what keeps a 20x/second scan cheap.
    local function Collect(node, found, depth)
        if depth > 14 then
            return
        end
        for _, child in ipairs(node:GetChildren()) do
            if child:IsA("GuiObject") then
                if child.Visible then
                    if child:IsA("GuiButton") and Skip.Matches(child.Name) then
                        table.insert(found, child)
                    end
                    Collect(child, found, depth + 1)
                end
            else
                Collect(child, found, depth + 1)
            end
        end
    end

    function Skip.Find()
        local root = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
        local found = {}
        if root then
            pcall(Collect, root, found, 0)
        end
        return found
    end

    function Skip.Tick()
        if not Hub.Crates then
            return 0
        end
        local now = tick()
        local clicked = 0
        for _, button in ipairs(Skip.Find()) do
            local last = Skip.Seen[button]
            if not last or now - last >= Skip.Cooldown then
                Skip.Seen[button] = now
                local ok = Hub.Crates.Click(button)
                if ok then
                    clicked = clicked + 1
                    Skip.Clicks = Skip.Clicks + 1
                    Skip.LastAt = now
                    pcall(function()
                        Skip.LastPath = button:GetFullName()
                    end)
                end
            end
        end
        return clicked
    end

    function Skip.Describe()
        local found = Skip.Find()
        if #found == 0 then
            return "no skip buttons on screen"
        end
        local names = {}
        for index, button in ipairs(found) do
            if index > 5 then
                table.insert(names, "+" .. tostring(#found - 5) .. " more")
                break
            end
            table.insert(names, button:GetFullName())
        end
        return table.concat(names, "\n")
    end

    function Skip.SetEnabled(enabled)
        Skip.Enabled = enabled == true
        Skip.Token = Skip.Token + 1
        if not Skip.Enabled then
            Report("off")
            return
        end
        local token = Skip.Token
        Report("on")
        task.spawn(function()
            while Skip.Enabled and Skip.Token == token do
                local ok, clicked = pcall(Skip.Tick)
                if ok and clicked and clicked > 0 then
                    Report(string.format("skipped %d | total %d", clicked, Skip.Clicks))
                end
                task.wait(Skip.Cadence)
            end
        end)
    end

    Hub.Skip = Skip
end


-- Fast Flags engine (ported from Cokeboys) + Fullbright ------------------------
-- Wrapped in do/end so the new locals never raise the chunk's local count.
do
    local LightingService = game:GetService("Lighting")

    local FFlagSnapshotFile = "SkibidiDefense_FFlagAutoApply.json"
    local FFlagPresetFile = "SkibidiDefense_FFlagPresets.json"

    local FFlags = {
        busy = false,
        generation = 0,
        autoAttempted = false,
        lastResult = nil,
        message = "Idle",
        listener = nil,
        startupPendingToken = nil,
        startupPendingPayload = nil,
    }

    local function FFlagReport(text)
        FFlags.message = tostring(text)
        if type(FFlags.listener) == "function" then
            pcall(FFlags.listener, FFlags.message)
        end
    end

    -- Accepts one JSON object of flag names to values.
    function FFlags.parsePayload(payload)
        if type(payload) ~= "string" or payload:gsub("%s", "") == "" then
            return nil, "Paste an FFlag JSON object first."
        end
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(payload)
        end)
        if not ok or type(decoded) ~= "table" then
            return nil, "Paste a valid JSON object of flag names and values."
        end
        local list = {}
        for name, value in pairs(decoded) do
            list[#list + 1] = { name = name, value = value }
        end
        table.sort(list, function(a, b)
            return tostring(a.name) < tostring(b.name)
        end)
        if #list == 0 then
            return nil, "The JSON object did not contain any flags."
        end
        return list, nil
    end

    local function FFlagReadSnapshot()
        if type(readfile) ~= "function" then
            return nil, "Local file access is unavailable."
        end
        if type(isfile) == "function" then
            local checked, exists = pcall(isfile, FFlagSnapshotFile)
            if checked and not exists then
                return nil, nil
            end
        end
        local ok, content = pcall(readfile, FFlagSnapshotFile)
        if not ok or type(content) ~= "string" or content == "" then
            return nil, nil
        end
        local decoded, data = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if not decoded or type(data) ~= "table" then
            return nil, "The saved auto-apply snapshot is invalid."
        end
        return data, nil
    end

    local function FFlagWriteSnapshot(data)
        if type(writefile) ~= "function" then
            return false, "Local file access is unavailable."
        end
        local encoded, body = pcall(function()
            return HttpService:JSONEncode(data)
        end)
        if not encoded then
            return false, "The auto-apply snapshot could not be encoded."
        end
        local wrote, result = pcall(writefile, FFlagSnapshotFile, body)
        if wrote and result ~= false then
            return true, nil
        end
        return false, "The auto-apply snapshot could not be saved."
    end

    function FFlags.getSnapshot()
        local data, err = FFlagReadSnapshot()
        if not data then
            return nil, err
        end
        if type(data.Payload) ~= "string" then
            return nil, nil
        end
        local parsed, parseErr = FFlags.parsePayload(data.Payload)
        return {
            enabled = data.Enabled == true,
            payload = data.Payload,
            updatedAt = tonumber(data.UpdatedAt),
            count = parsed and #parsed or 0,
            valid = parsed ~= nil,
            pending = data.Pending == true,
            pendingAt = tonumber(data.PendingAt),
            quarantined = data.Quarantined == true,
        }, parseErr
    end

    function FFlags.saveSnapshot(payload)
        local parsed, err = FFlags.parsePayload(payload)
        if not parsed then
            return false, err
        end
        local current = FFlagReadSnapshot()
        local ok, writeErr = FFlagWriteSnapshot({
            Version = 1,
            Enabled = type(current) == "table" and current.Enabled == true or false,
            Payload = payload,
            UpdatedAt = os.time(),
            Pending = false,
            Quarantined = false,
        })
        return ok, writeErr, ok and #parsed or nil
    end

    function FFlags.setEnabled(enabled)
        local data, err = FFlagReadSnapshot()
        if not data then
            if enabled then
                return false, err or "Save the current JSON as an auto-apply snapshot first."
            end
            return true, nil
        end
        if enabled then
            local parsed, parseErr = FFlags.parsePayload(data.Payload)
            if not parsed then
                return false, parseErr
            end
        end
        data.Version = 1
        data.Enabled = enabled == true
        data.Pending = false
        data.PendingAt = nil
        if enabled then
            data.Quarantined = false
        end
        return FFlagWriteSnapshot(data)
    end

    function FFlags.beginStartupAttempt(payload)
        local data, err = FFlagReadSnapshot()
        if not data then
            return nil, err or "The saved auto-apply snapshot disappeared."
        end
        if data.Enabled ~= true or data.Payload ~= payload then
            return nil, "The saved auto-apply snapshot changed before startup application."
        end
        local token = os.time()
        data.Pending = true
        data.PendingAt = token
        data.Quarantined = false
        local ok, writeErr = FFlagWriteSnapshot(data)
        if not ok then
            return nil, writeErr
        end
        FFlags.startupPendingToken = token
        FFlags.startupPendingPayload = payload
        return token, nil
    end

    function FFlags.completeStartupAttempt(token)
        local data, err = FFlagReadSnapshot()
        if not data then
            return false, err
        end
        if data.Pending ~= true
            or tonumber(data.PendingAt) ~= tonumber(token)
            or data.Payload ~= FFlags.startupPendingPayload then
            return true, nil
        end
        data.Pending = false
        data.PendingAt = nil
        local ok, writeErr = FFlagWriteSnapshot(data)
        if ok then
            FFlags.startupPendingToken = nil
            FFlags.startupPendingPayload = nil
        end
        return ok, writeErr
    end

    function FFlags.quarantineInterruptedStartup()
        local data, err = FFlagReadSnapshot()
        if not data then
            return false, err
        end
        data.Enabled = false
        data.Pending = false
        data.PendingAt = nil
        data.Quarantined = true
        data.QuarantinedAt = os.time()
        return FFlagWriteSnapshot(data)
    end

    function FFlags.deleteSnapshot()
        FFlags.generation = FFlags.generation + 1
        if type(delfile) == "function" then
            if type(isfile) == "function" then
                local checked, exists = pcall(isfile, FFlagSnapshotFile)
                if checked and not exists then
                    return true, nil
                end
            end
            local ok, result = pcall(delfile, FFlagSnapshotFile)
            if ok and result ~= false then
                return true, nil
            end
        end
        return FFlagWriteSnapshot({
            Version = 1,
            Enabled = false,
            Pending = false,
            Quarantined = false,
            UpdatedAt = os.time(),
        })
    end

    function FFlags.cancel()
        FFlags.generation = FFlags.generation + 1
        if FFlags.startupPendingToken then
            FFlags.completeStartupAttempt(FFlags.startupPendingToken)
        end
    end

    function FFlags.applyPayload(payload, options)
        options = type(options) == "table" and options or {}
        if FFlags.busy then
            return nil, "A preset is already being applied."
        end
        if type(setfflag) ~= "function" then
            return nil, "Your executor does not provide setfflag."
        end
        local list, err = FFlags.parsePayload(payload)
        if not list then
            return nil, err
        end
        FFlags.busy = true
        FFlags.generation = FFlags.generation + 1
        local generation = FFlags.generation
        local applied, failed, processed, cancelled = 0, 0, 0, false
        for index, entry in ipairs(list) do
            if generation ~= FFlags.generation
                or not State.Running
                or (type(options.shouldCancel) == "function" and options.shouldCancel()) then
                cancelled = true
                break
            end
            local name, value = entry.name, entry.value
            if type(name) == "string"
                and (type(value) == "string" or type(value) == "number" or type(value) == "boolean") then
                local text = type(value) == "boolean" and (value and "true" or "false") or tostring(value)
                local lowered = string.lower(text)
                text = (lowered == "true" or lowered == "false") and lowered or text
                local callOk, callResult = pcall(setfflag, name, text)
                local ok = callOk and callResult ~= false
                local verified = false
                if type(getfflag) == "function" then
                    local readOk, readValue = pcall(getfflag, name)
                    verified = readOk and readValue ~= nil
                        and string.lower(tostring(readValue)) == string.lower(text)
                end
                if ok or verified then
                    applied = applied + 1
                else
                    failed = failed + 1
                end
            else
                failed = failed + 1
            end
            if type(options.onProgress) == "function" then
                pcall(options.onProgress, index, #list)
            end
            if index % 4 == 0 and index < #list then
                task.wait(0.1)
            end
            processed = index
        end
        FFlags.busy = false
        local result = {
            applied = applied,
            failed = failed,
            processed = processed,
            total = #list,
            cancelled = cancelled or generation ~= FFlags.generation,
            automatic = options.automatic == true,
        }
        FFlags.lastResult = result
        return result, nil
    end

