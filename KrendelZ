            local r2, g2, b2 = v:match("^rgb%((%d+)%s*,%s*(%d+)%s*,%s*(%d+)%)$")
            if r2 then return Color3.fromRGB(tonumber(r2), tonumber(g2), tonumber(b2)) end
            local h2, s2, vv = v:match("^hsv%(([%d%.]+)%s*,%s*([%d%.]+)%s*,%s*([%d%.]+)%)$")
