-- Configs tab: create, save, load, delete and auto-load named settings snapshots.
do
    local NamedConfigFile = "SkibidiDefense_Configs.json"
    local AutoKey = "__autoLoad"

    Hub.Config = {
        File = NamedConfigFile,
        active = "",
        selected = "",
    }

    function Hub.Config.Collect()
        local values = {}
        for _, key in ipairs(Gui.WidgetOrder) do
            local handle = Gui.Widgets[key]
            if handle and type(handle.Get) == "function" then
                local ok, value = pcall(handle.Get)
                if ok and value ~= nil then
                    values[key] = value
                end
            end
        end
        return values
    end

    function Hub.Config.Apply(values)
        if type(values) ~= "table" then
            return 0
        end
        local applied = 0
        for key, value in pairs(values) do
            local handle = Gui.Widgets[key]
            if handle and type(handle.Set) == "function" then
                if pcall(handle.Set, value) then
                    applied = applied + 1
                end
            end
        end
        return applied
    end

    function Hub.Config.Count()
        return #Gui.WidgetOrder
    end

    local function ReadNamed()
        if type(readfile) ~= "function" then
            return {}
        end
        if type(isfile) == "function" and not isfile(NamedConfigFile) then
            return {}
        end
        local ok, content = pcall(readfile, NamedConfigFile)
        if not ok or type(content) ~= "string" or content == "" then
            return {}
        end
        local decoded, data = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if decoded and type(data) == "table" then
            return data
        end
        return {}
    end

    local function WriteNamed(map)
        if type(writefile) ~= "function" then
            return false
        end
        local encoded, body = pcall(function()
            return HttpService:JSONEncode(map)
        end)
        if not encoded then
            return false
        end
        local ok, result = pcall(writefile, NamedConfigFile, body)
        return ok and result ~= false
    end

    function Hub.Config.Names()
        local names = {}
        for name, entry in pairs(ReadNamed()) do
            if type(entry) == "table" and type(entry.Values) == "table" then
                names[#names + 1] = tostring(name)
            end
        end
        table.sort(names)
        return names
    end

    function Hub.Config.GetAutoLoad()
        local value = ReadNamed()[AutoKey]
        if type(value) == "string" then
            return value
        end
        return ""
    end

    function Hub.Config.SetAutoLoad(name)
        local map = ReadNamed()
        if name == nil or name == "" or type(map[name]) ~= "table" then
            map[AutoKey] = nil
        else
            map[AutoKey] = name
        end
        return WriteNamed(map)
    end

    function Hub.Config.Save(name)
        local map = ReadNamed()
        map[name] = {
            Version = 1,
            SavedAt = os.time(),
            Values = Hub.Config.Collect(),
        }
        if WriteNamed(map) then
            Hub.Config.active = name
            return true, nil
        end
        return false, "The config file could not be written."
    end

    function Hub.Config.Load(name)
        local entry = ReadNamed()[name]
        if type(entry) ~= "table" or type(entry.Values) ~= "table" then
            return false, "No saved config with that name."
        end
        local applied = Hub.Config.Apply(entry.Values)
        Hub.Config.active = name
        return true, applied
    end

    function Hub.Config.Delete(name)
        local map = ReadNamed()
        if type(map[name]) ~= "table" then
            return false, "No saved config with that name."
        end
        map[name] = nil
        if map[AutoKey] == name then
            map[AutoKey] = nil
        end
        if WriteNamed(map) then
            if Hub.Config.active == name then
                Hub.Config.active = ""
            end
            if Hub.Config.selected == name then
                Hub.Config.selected = ""
            end
            return true, nil
        end
        return false, "The config file could not be updated."
    end

    -- Applies the auto-load config, otherwise the last saved settings.
    function Hub.Config.Boot(config)
        local auto = Hub.Config.GetAutoLoad()
        if auto ~= "" then
            local ok, applied = Hub.Config.Load(auto)
            if ok then
                Hub.Config.selected = auto
                return applied
            end
        end
        if type(config) == "table" and type(config.Values) == "table" then
            return Hub.Config.Apply(config.Values)
        end
        return 0
    end

    -- Selectable list (StarHubUI has no list widget).
    local function MakeConfigList(box, height, onSelect)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, height)
