    local function Remember(kind, title, handle)
        if type(handle) ~= "table" then
            return handle
        end
        local key = kind .. "|" .. tostring(title)
        if Gui.Widgets[key] then
            local index = 2
            while Gui.Widgets[key .. "#" .. index] do
                index = index + 1
            end
            key = key .. "#" .. index
        end
        Gui.Widgets[key] = handle
        Gui.WidgetOrder[#Gui.WidgetOrder + 1] = key
        return handle
    end

    local function WrapBox(box)
        if type(box) ~= "table" or box.__configWrapped then
            return box
        end
        box.__configWrapped = true

        local addToggle = box.AddToggle
        local addSlider = box.AddSlider
        local addDropdown = box.AddDropdown
        local addInput = box.AddInput
        local addColor = box.AddColorPickerRow
        local addMode = box.AddModeSelector

        if type(addToggle) == "function" then
            box.AddToggle = function(self, title, desc, default, callback)
                return Remember("Toggle", title, addToggle(self, title, desc, default, callback))
            end
        end
        if type(addSlider) == "function" then
            box.AddSlider = function(self, title, minVal, maxVal, default, suffix, callback)
                return Remember("Slider", title, addSlider(self, title, minVal, maxVal, default, suffix, callback))
            end
        end
        if type(addDropdown) == "function" then
            box.AddDropdown = function(self, title, options, default, callback)
                return Remember("Dropdown", title, addDropdown(self, title, options, default, callback))
            end
        end
        if type(addInput) == "function" then
            box.AddInput = function(self, name, placeholder, default, callback)
                local handle = addInput(self, name, placeholder, default, callback)
                Remember("Input", name, {
                    Set = function(value)
                        handle.Text = tostring(value)
                        if type(callback) == "function" then
                            pcall(callback, tostring(value))
                        end
                    end,
                    Get = function()
                        return handle.Text
                    end,
                })
                return handle
            end
        end
        if type(addColor) == "function" then
            box.AddColorPickerRow = function(self, name, default, callback)
                local handle = addColor(self, name, default, callback)
                Remember("Color", name, {
                    Set = function(value)
                        local color = value
                        if type(value) == "table" then
                            color = Color3.fromRGB(
                                math.clamp(tonumber(value[1]) or 255, 0, 255),
                                math.clamp(tonumber(value[2]) or 255, 0, 255),
                                math.clamp(tonumber(value[3]) or 255, 0, 255)
                            )
                        end
                        pcall(handle.Set, color)
                        if type(callback) == "function" then
                            pcall(callback, color)
                        end
                    end,
                    Get = function()
                        local color = handle.Get()
                        return {
                            math.floor(color.R * 255),
                            math.floor(color.G * 255),
                            math.floor(color.B * 255),
                        }
                    end,
                })
                return handle
            end
        end
        if type(addMode) == "function" then
            box.AddModeSelector = function(self, name, modes, default, callback)
                local handle = addMode(self, name, modes, default, callback)
                Remember("Mode", name, handle)
                return handle
            end
        end
        return box
    end

    local createTab = Window.CreateTab
    Window.CreateTab = function(self, ...)
        local tab = createTab(self, ...)
        if type(tab) == "table" and not tab.__configWrapped then
            tab.__configWrapped = true
            local createBox = tab.CreateGroupBox
            if type(createBox) == "function" then
                tab.CreateGroupBox = function(tabSelf, ...)
                    return WrapBox(createBox(tabSelf, ...))
                end
            end
        end
        return tab
    end
end

