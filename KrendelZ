local function ApplyMenuFont(styleName, scalePercent, bold)
    local screenGui = Window and Window.ScreenGui
    if not screenGui then
        return
    end
    local font = Enum.Font[styleName] or Enum.Font.Gotham
    if bold then
        local boldFont = Enum.Font[styleName .. "Bold"]
        if boldFont then
            font = boldFont
        end
    end
    local scale = math.clamp((tonumber(scalePercent) or 100) / 100, 0.5, 2)
    for _, obj in ipairs(screenGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            if not obj.TextScaled then
                local base = obj:GetAttribute("MenuBaseTextSize")
                if not base then
                    base = obj.TextSize
                    obj:SetAttribute("MenuBaseTextSize", base)
                end
                obj.Font = font
                obj.TextSize = math.clamp(math.floor(base * scale + 0.5), 6, 60)
            end
        end
    end
end

